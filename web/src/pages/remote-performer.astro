<!doctype html><html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>ELISA / REMOTE CAM</title><style>
*{box-sizing:border-box}
:root{color-scheme:dark}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#080908;color:#39ff14;font:14px Helvetica,Arial,sans-serif}
body{height:100dvh;display:flex;flex-direction:column;padding:clamp(10px,2vh,20px);padding-top:max(10px,env(safe-area-inset-top));padding-bottom:max(10px,env(safe-area-inset-bottom));gap:clamp(7px,1.1vh,12px)}
h1{font-size:clamp(20px,3vw,30px);letter-spacing:-1px;margin:0;line-height:1.05}
h2{font-size:clamp(13px,1.8vw,18px);margin:3px 0 0;letter-spacing:.04em}
p{color:#aaa;font-size:11px;margin:0;line-height:1.3}
button,input{font:inherit;min-width:0}
button{background:#101710;color:#39ff14;border:1px solid #39ff14;border-radius:7px;padding:10px;min-height:44px;cursor:pointer}
button:disabled{opacity:.35}
.buttons{display:grid;grid-template-columns:1fr 1fr;gap:9px}
video{display:block;width:100%;height:100%;object-fit:contain;background:#171717;transform:scaleX(-1);border:1px solid #35502f;border-radius:10px}
.camera-wrap{flex:1 1 auto;min-height:75px;max-height:44dvh;display:flex;align-items:stretch;justify-content:center}
input{width:100%;background:#111;color:#fff;border:1px solid #35502f;padding:12px;border-radius:7px}
.row{display:flex;gap:8px}.row input{flex:1}.row button{flex:0 0 86px}
#status{padding:9px 11px;border:1px solid #35502f;margin:0;font-size:12px;min-height:34px}
details{border-top:1px solid #35502f;padding-top:7px;font-size:11px;color:#aaa}
summary{cursor:pointer;user-select:none}
details label{display:block;margin-top:8px}
details input{margin-top:5px;padding:8px;font-size:12px}
@media(min-width:700px){body{max-width:740px;margin:auto}.camera-wrap{max-height:42dvh}}
@media(max-height:640px){body{gap:5px;padding-top:6px;padding-bottom:6px}.camera-wrap{max-height:33dvh;min-height:50px}button{min-height:36px;padding:6px}#status{min-height:28px;padding:5px 8px}h1{font-size:19px}p{font-size:10px}}
</style></head><body>
<h1>ELISA / CAM 02</h1>
<p>HYPNOSIS — REMOTE PERFORMER</p>
<div id="status">DISCONNECTED</div>
<div class="camera-wrap"><video id="preview" autoplay muted playsinline></video></div>
<div class="buttons"><button id="enter">● ENTER CAM</button><button id="leave">○ EXIT CAM</button></div>
<h2>LIVE TEXT</h2>
<div class="row"><input id="word" maxlength="18" placeholder="TYPE YOUR MASK…" aria-label="Live text"><button id="send">SEND</button></div>
<details><summary>SETTINGS · BRIDGE URL</summary><label>BRIDGE URL <input id="bridge" value="" spellcheck="false"></label><p>La webcam richiede HTTPS su iPhone.</p></details>
<script>
const $=id=>document.getElementById(id),bridge=$('bridge'),status=$('status');bridge.value=localStorage.getItem('elisa-remote-bridge')||location.protocol+'//'+location.hostname+':8765';
let stream=null,pc=null,last=0,session=0;
const endpoint=()=>bridge.value.replace(/\/$/,'');
bridge.addEventListener('change',()=>localStorage.setItem('elisa-remote-bridge',bridge.value));
async function send(kind,data){const r=await fetch(endpoint()+'/remote/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({kind,data})});if(!r.ok)throw Error('BRIDGE OFFLINE')}
async function completeIce(peer){if(peer.iceGatheringState==='complete')return;await new Promise((resolve,reject)=>{let timeout=setTimeout(()=>{peer.removeEventListener('icegatheringstatechange',check);reject(Error('ICE TIMEOUT'))},9000);function check(){if(peer.iceGatheringState==='complete'){clearTimeout(timeout);peer.removeEventListener('icegatheringstatechange',check);resolve()}}peer.addEventListener('icegatheringstatechange',check)})}
async function leave(){session++;if(pc){pc.close();pc=null}if(stream){stream.getTracks().forEach(t=>t.stop());stream=null}$('preview').srcObject=null;status.textContent='CAM 02 OFF';await send('hangup',null).catch(()=>{})}
$('enter').onclick=async()=>{try{await leave();const id=++session;stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user',width:{ideal:640},height:{ideal:480}},audio:false});$('preview').srcObject=stream;pc=new RTCPeerConnection({iceServers:[]});stream.getTracks().forEach(t=>pc.addTrack(t,stream));pc.onconnectionstatechange=()=>{if(id===session)status.textContent='CAM 02 · '+pc.connectionState.toUpperCase()};const offer=await pc.createOffer();await pc.setLocalDescription(offer);status.textContent='CONNECTING…';await completeIce(pc);if(id===session)await send('offer',pc.localDescription); }catch(e){status.textContent='CAM ERROR · '+e.message}};
$('leave').onclick=leave;
$('send').onclick=async()=>{try{await send('word',$('word').value);status.textContent='TEXT SENT'}catch(e){status.textContent=e.message}};
$('word').addEventListener('keydown',e=>{if(e.key==='Enter')$('send').click()});
async function poll(){try{const r=await fetch(endpoint()+'/remote/events?since='+last,{cache:'no-store'});if(r.ok){const data=await r.json();for(const e of data.events){last=Math.max(last,e.id);if(e.kind==='answer'&&pc&&pc.signalingState==='have-local-offer')await pc.setRemoteDescription(e.data)}}}catch{}setTimeout(poll,550)}poll();
</script></body></html>