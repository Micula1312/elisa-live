<!doctype html><html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>ELISA / REMOTE CAM</title><style>
*{box-sizing:border-box}body{margin:0;background:#080908;color:#39ff14;font:15px Helvetica,Arial,sans-serif;padding:24px;min-height:100dvh}h1{font-size:30px;letter-spacing:-1px}button,input{font:inherit}button{background:#101710;color:#39ff14;border:1px solid #39ff14;border-radius:8px;padding:16px;min-height:55px}button:disabled{opacity:.35}.buttons{display:grid;grid-template-columns:1fr 1fr;gap:9px}video{width:100%;aspect-ratio:4/3;object-fit:cover;background:#171717;transform:scaleX(-1);border:1px solid #35502f;border-radius:10px}input{width:100%;background:#111;color:#fff;border:1px solid #35502f;padding:15px;border-radius:8px}.row{display:flex;gap:8px}.row button{flex:1}p{color:#aaa;font-size:12px}#status{padding:10px;border:1px solid #35502f;margin:15px 0}
</style></head><body><h1>ELISA / CAM 02</h1><p>HYPNOSIS — REMOTE PERFORMER</p><div id="status">DISCONNECTED</div><video id="preview" autoplay muted playsinline></video><div class="buttons"><button id="enter">● ENTER CAM</button><button id="leave">○ EXIT CAM</button></div><h2>LIVE TEXT</h2><div class="row"><input id="word" maxlength="18" placeholder="TYPE YOUR MASK…"><button id="send">SEND</button></div><p>La fotocamera si accende soltanto premendo ENTER. EXIT interrompe la trasmissione. Richiede HTTPS su iPhone.</p><label>BRIDGE URL <input id="bridge" value="" spellcheck="false"></label>
<script>
const $=id=>document.getElementById(id),bridge=$('bridge'),status=$('status');bridge.value=localStorage.getItem('elisa-remote-bridge')||location.protocol+'//'+location.hostname+':8765';
let stream=null,pc=null,last=0,session=0;
const endpoint=()=>bridge.value.replace(/\/$/,'');
bridge.addEventListener('change',()=>localStorage.setItem('elisa-remote-bridge',bridge.value));
async function send(kind,data){const r=await fetch(endpoint()+'/remote/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({kind,data})});if(!r.ok)throw Error('BRIDGE OFFLINE')}
async function completeIce(peer){if(peer.iceGatheringState==='complete')return;await new Promise((resolve,reject)=>{let timeout=setTimeout(()=>{peer.removeEventListener('icegatheringstatechange',check);reject(Error('ICE TIMEOUT'))},9000);function check(){if(peer.iceGatheringState==='complete'){clearTimeout(timeout);peer.removeEventListener('icegatheringstatechange',check);resolve()}}peer.addEventListener('icegatheringstatechange',check)})}
async function leave(){session++;if(pc){pc.close();pc=null}if(stream){stream.getTracks().forEach(t=>t.stop());stream=null}$('preview').srcObject=null;status.textContent='CAM 02 OFF';await send('hangup',null).catch(()=>{})}
$('enter').onclick=async()=>{try{await leave();const id=++session;stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user',width:{ideal:640},height:{ideal:480}},audio:false});$('preview').srcObject=stream;pc=new RTCPeerConnection({iceServers:[]});stream.getTracks().forEach(t=>pc.addTrack(t,stream));pc.onconnectionstatechange=()=>{if(id===session)status.textContent='CAM 02 · '+pc.connectionState.toUpperCase()};const offer=await pc.createOffer();await pc.setLocalDescription(offer);status.textContent='CONNECTING…';await completeIce(pc);if(id===session)await send('offer',pc.localDescription); }catch(e){status.textContent='CAM ERROR · '+e.message}};
$('leave').onclick=leave;
$('send').onclick=async()=>{try{await send('word',$('word').value);status.textContent='TEXT SENT'}catch(e){status.textContent=e.message}};
$('word').addEventListener('keydown',e=>{if(e.key==='Enter')$('send').click()});
async function poll(){try{const r=await fetch(endpoint()+'/remote/events?since='+last,{cache:'no-store'});if(r.ok){const data=await r.json();for(const e of data.events){last=Math.max(last,e.id);if(e.kind==='answer'&&pc&&pc.signalingState==='have-local-offer')await pc.setRemoteDescription(e.data)}}}catch{}setTimeout(poll,550)}poll();
</script></body></html>