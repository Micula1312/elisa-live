      if(videoFx.pixel)filters.push("contrast("+(1+fxAmount*(.32+pixelBase*.75)).toFixed(2)+")","saturate("+(Math.max(.18,1-fxAmount*.72)).toFixed(2)+")","brightness("+(1-fxAmount*.08).toFixed(2)+")");
      renderer.domElement.style.filter=filters.join(" ")||"none";
      renderer.domElement.style.transform=videoFx.glitch&&hit>.08?"translate("+((high-.5)*fxAmount*7).toFixed(1)+"px,"+((mid-.5)*fxAmount*5).toFixed(1)+"px)":"none";
      renderer.render(scene,camera);cycloneRaf=requestAnimationFrame(loop);
    };loop();
  };
  const setCyclone=(on)=>{on?enter3D():leave3D()};
  addEventListener("wheel",e=>{
    if(!orbitEnabled)return;
    e.preventDefault();
    const d=Math.max(-140,Math.min(140,e.deltaY));
    morphWheel+=d*.0016;
    // Down-scroll progressively converts page travel into depth and finally the first vortex turn.
    morphTarget=Math.max(0,Math.min(1,morphTarget+d*cycloneCfg.sensitivity));
  },{passive:false});

  const captureHandoff=()=>{
    // Snapshot the exact visible 2D cells so the first 3D frame inherits their media/order.
    const visible=[...grid.querySelectorAll(".post")].filter(post=>{
      const r=post.getBoundingClientRect();return r.bottom>70&&r.top<innerHeight;
    }).slice(0,18);
    if(!cyclone||!visible.length)return;
    visible.forEach((post,i)=>{
      const plane=cyclone.planes[i];if(!plane)return;
      const ph=post.querySelector(".placeholder.has-media");
      const raw=ph?.style.backgroundImage.match(/url\\(["']?(.*?)["']?\\)/)?.[1];
      if(raw&&plane.userData.url!==raw){
        cycloneTexture(raw,tex=>{plane.material.map=tex;plane.material.opacity=1;plane.material.needsUpdate=true;plane.userData.url=raw});
      }
      const r=post.getBoundingClientRect();
      // Convert DOM pixels to the exact Three.js world size at z=0.
      // This makes H/G at morph=0 inherit the real 3-column feed width instead of a compressed approximation.
      const cam=cyclone.camera;
      const visibleWorldH=2*Math.tan(THREE.MathUtils.degToRad(cam.fov)*.5)*cam.position.z;
      const worldPerPx=visibleWorldH/innerHeight;
      plane.userData.handoff={
        x:(r.left+r.width/2-innerWidth/2)*worldPerPx,
        y:-(r.top+r.height/2-innerHeight/2)*worldPerPx,
        scale:(r.width*worldPerPx)/1.72
      };
    });
  };
  const enter3D=()=>{
    if(spatialEnabled)return;
    buildCyclone();captureHandoff();spatialEnabled=true;orbitEnabled=false;
    clearTimeout(handoffTimer);
    // Threshold: F first recedes as a whole; Three.js appears only when sizes nearly match.
    feed.style.transition="opacity .9s ease";
    feed.style.transformOrigin="50% 45%";feed.style.transform="";
    morphProgress=0;morphTarget=.30;sceneDark=0;
    cycloneScene.classList.add("on");cycloneScene.style.opacity="0";
    // Overlay the matching 3D planes on top of F first; only then dissolve the DOM away.
    requestAnimationFrame(()=>{cycloneScene.style.opacity="1"});
    handoffTimer=setTimeout(()=>{feed.style.opacity="0"},680);
    syncCueMonitor();
  };
  const leave3D=()=>{
    if(!spatialEnabled)return;
    clearTimeout(handoffTimer);orbitEnabled=false;pixelEnabled=false;vortexEnabled=false;holeEnabled=false;particleMix=0;holeMix=0;slashLight?.classList.remove("on");morphTarget=0;
    // Restore the live DOM feed BEFORE removing the 3D canvas: never expose the white scene underneath.
    feed.style.display="block";feed.style.visibility="visible";feed.style.pointerEvents="auto";feed.style.transition="none";feed.style.opacity="1";feed.style.transform="";
    breathEnabled=true;slipEnabled=true;floatEnabled=true;
    [...grid.querySelectorAll(".post")].forEach((post,i)=>{post.classList.toggle("detached",(i%3===0)||(i%7===2));post.classList.add("floating")});
    requestAnimationFrame(()=>requestAnimationFrame(()=>{
      cycloneScene.style.opacity="0";
      handoffTimer=setTimeout(()=>{spatialEnabled=false;cycloneScene.classList.remove("on");cycloneScene.style.opacity="";feed.style.opacity="1";feed.style.transition="";syncCueMonitor()},500);
    }));
  };
  const setFeedCue=(key)=>{
    if(["b","d","f"].includes(key)&&spatialEnabled)leave3D();
    if(key==="b"){breathEnabled=true;slipEnabled=false;floatEnabled=false}
    if(key==="d"){breathEnabled=true;slipEnabled=true;floatEnabled=false}
    if(key==="f"){breathEnabled=true;slipEnabled=true;floatEnabled=true}
    if(key==="g"){if(!spatialEnabled)enter3D();return}
    if(key==="h"){if(!spatialEnabled)enter3D();orbitEnabled=true;morphTarget=1;syncCueMonitor();return}
    if(key==="j"){if(!spatialEnabled)enter3D();pixelEnabled=true;syncCueMonitor();return}
    if(key==="k"){if(!spatialEnabled)enter3D();pixelEnabled=true;vortexEnabled=true;syncCueMonitor();return}
    if(key==="l"){if(!spatialEnabled)enter3D();pixelEnabled=true;vortexEnabled=true;holeEnabled=true;syncCueMonitor();return}
    [...grid.querySelectorAll(".post")].forEach((post,i)=>{post.classList.toggle("detached",slipEnabled&&((i%3===0)||(i%7===2)));post.classList.toggle("floating",floatEnabled)});
    syncCueMonitor();
  };
  const toggleCue=(key)=>{
    if(["b","d","f"].includes(key)){setFeedCue(key);return}
    if(key==="g"){spatialEnabled?leave3D():enter3D();return}
    if(key==="h"){if(!spatialEnabled)enter3D();orbitEnabled=!orbitEnabled;morphTarget=orbitEnabled?1:.52;syncCueMonitor();return}
    if(key==="j"){if(!spatialEnabled)enter3D();pixelEnabled=!pixelEnabled}
    if(key==="k"){if(!spatialEnabled)enter3D();pixelEnabled=true;vortexEnabled=!vortexEnabled}
    if(key==="l"){if(!spatialEnabled)enter3D();pixelEnabled=true;vortexEnabled=true;holeEnabled=!holeEnabled}
    syncCueMonitor();
  };
  const handleRegiaMessage=m=>{
    m=m||{};
    if(m.type==="cue"){
      if(m.key==="s"){setAutoScroll(true);return}
      if(["b","d","f","g","h","j","k","l"].includes(m.key))setFeedCue(m.key);
    }
    if(m.type==="fx"&&m.fx in videoFx){videoFx[m.fx]=!!m.on;syncVideoFx()}
    if(m.type==="fx-clean"){Object.keys(videoFx).forEach(k=>videoFx[k]=false);syncVideoFx()}
    if(m.type==="fx-amount"){videoAmount.value=String(m.value);vAmount.textContent=Number(m.value).toFixed(2);applyVideoFx()}
    if(m.type==="fx-react"){videoReact.value=String(m.value);vReact.textContent=Number(m.value).toFixed(1);applyVideoFx()}
    if(m.type==="subtitles"){subtitlesEnabled=!!m.on;subtitleToggle.textContent="SUBTITLES "+(subtitlesEnabled?"ON":"OFF");subtitleToggle.classList.toggle("on",subtitlesEnabled);if(subtitlesEnabled){subtitlePreviewUntil=0;renderSubtitle();if(!master.currentTime)previewSubtitle()}else setSubtitle(null,"")}
  };
  const regiaChannel=new BroadcastChannel("elisa-regia");
  regiaChannel.onmessage=e=>handleRegiaMessage(e.data);
  addEventListener("storage",e=>{if(e.key==="elisa-regia-command"&&e.newValue){try{handleRegiaMessage(JSON.parse(e.newValue).message)}catch{}}});
  const moveSpace=(dx,dy,dz=0)=>{spaceX+=dx;spaceY+=dy;spaceZ+=dz;syncCueMonitor()};
  const zoomSpace=(delta)=>{spaceZoom=Math.max(.35,Math.min(3,spaceZoom+delta));syncCueMonitor()};
  videoPanel.querySelectorAll(".cue-led").forEach(btn=>btn.addEventListener("click",()=>toggleCue(btn.dataset.cue)));
  document.querySelector("#spaceZoomIn").addEventListener("click",()=>zoomSpace(.12));
  document.querySelector("#spaceZoomOut").addEventListener("click",()=>zoomSpace(-.12));
  document.addEventListener("keydown",e=>{
    if(["INPUT","TEXTAREA","SELECT"].includes(document.activeElement?.tagName))return;
    const key=e.key.toLowerCase();
    if(key==="s"){setAutoScroll(true);return}
    if(["b","d","f","g","h","j","k","l"].includes(key)){toggleCue(key);return}
    if(e.key==="ArrowLeft"){e.preventDefault();moveSpace(-55,0);return}
    if(e.key==="ArrowRight"){e.preventDefault();moveSpace(55,0);return}
    if(e.key==="ArrowUp"){e.preventDefault();moveSpace(0,-55);return}
    if(e.key==="ArrowDown"){e.preventDefault();moveSpace(0,55);return}
    if(key==="+"||key==="="){zoomSpace(.12);return}
    if(key==="-"||key==="_"){zoomSpace(-.12);return}
    if(key==="pageup"){moveSpace(0,0,90);return}
    if(key==="pagedown"){moveSpace(0,0,-90);return}
  });

  window.addEventListener("elisa-audio",e=>{
    const low=e.detail.low||0,mid=e.detail.mid||0,high=e.detail.high||0,hit=e.detail.transient||0;
    const fxAmount=Number(videoAmount.value),fxReact=Number(videoReact.value);
    const fxEnergy=Math.min(1,(low*.35+mid*.45+high*.2+hit*.35)*fxReact);
    feed.style.setProperty("--fx-acid",(fxAmount*fxEnergy).toFixed(3));
    feed.style.setProperty("--fx-glitch",(fxAmount*(high*.65+hit*.8)*fxReact).toFixed(3));
    feed.style.setProperty("--fx-pixel",(fxAmount*(mid*.35+high*.65)*fxReact).toFixed(3));
    feed.style.setProperty("--fx-contrast",(1+(videoFx.glitch?fxAmount*fxEnergy*.8:0)).toFixed(3));
    feed.style.setProperty("--fx-hue",(videoFx.acid?(fxAmount*(20+mid*170+high*90)*fxReact).toFixed(1):0)+"deg");
    lastLow+=(low-lastLow)*.16; lastMid+=(mid-lastMid)*.12; lastHigh+=(high-lastHigh)*.10;
    const now=performance.now(),dt=Math.min(.05,(now-lastAudioFrame)/1000);lastAudioFrame=now;
    motionClock+=dt*(.75+lastLow*.8+lastMid*.35);
    const elapsed=feedStartedAt?(now-feedStartedAt)/1000:0;
    const amount=breathEnabled?(slipEnabled?.026:.012):0;
    grid.style.setProperty("--breath",(1+lastLow*amount).toFixed(4));
    if(floatEnabled&&!spatialEnabled){
      const drift=.82+((Math.sin(motionClock*.38)+1)*.5)*.18+lastLow*.035;
      grid.style.transform=`scale(${drift.toFixed(4)})`;
      grid.style.transformOrigin="50% 45%";
    }else if(!spatialEnabled){grid.style.transform="";}
    if(cyclone&&spatialEnabled){
      cyclone.planes.forEach((m,i)=>{
        if(!m.material.map)return;
        const seed=.55+((i*47)%41)/100;
        const wave=Math.max(0,Math.sin(motionClock*(.62+(i%5)*.09)+i*1.37));
        const band=i%3===0?lastLow:i%3===1?lastMid:lastHigh;
        const strength=slipEnabled?.24:breathEnabled?.10:.055;
        m.userData.audioBreath=1+wave*band*strength*seed+hit*((i%11===0)?strength*.7:0);
      });
    }
    if(!breathEnabled)return;
    const posts=[...grid.querySelectorAll(".post")];
    posts.forEach((post,i)=>{
      const ph=post.querySelector(".placeholder"); if(!ph)return;
      const lane=i%3,phase=i*1.618;
      const energy=lane===0?lastLow:lane===1?lastMid:lastHigh;
      // Each tile gets its own musical body: bass = weight/scale, mids = sway, highs = nervous edge.
      // Before detachment the whole archive already punches in/out on MID.
      // Different phase/weight per tile prevents a synchronized "equalizer" look.
      const midBoom=Math.max(0,lastMid-(.10+(i%4)*.018));
      const midPulse=midBoom*(.22+((i*29)%17)/100);
      const randomWave=Math.max(0,Math.sin(motionClock*(.58+(i%6)*.11)+i*2.17));
      const bBand=i%3===0?lastLow:i%3===1?lastMid:lastHigh;
      const bStrength=slipEnabled?.24:.115;
      const pulse=1+randomWave*bBand*bStrength*(.55+((i*31)%37)/100)+hit*((slipEnabled&&i%5===0)?.10:.018);
      const sway=Math.sin(motionClock*(lane===1?1.25:.82)+phase);
      const float=Math.cos(motionClock*(lane===2?1.65:.68)+phase*.73);
      const isSlip=slipEnabled&&post.classList.contains("detached");
      const isFloat=floatEnabled&&post.classList.contains("floating");
      // D cue: selected tiles "breathe out" of the grid. Each tile is assigned a different
      // frequency body so bass/mids/highs create asynchronous zoom-outs instead of one global move.
      const band=i%3===0?lastLow:i%3===1?lastMid:lastHigh;
      const gate=Math.max(0,(band-(.08+(i%5)*.018))*2.8);
      const randomBody=.78+((i*37)%31)/100;
      // D = elastic extraction, not wandering. The tile stays centred on its own cell and
      // pushes toward the viewer with scale. Different frequency bodies make the grid breathe
      // asynchronously; pressing D again releases every tile exactly back into the grid.
      const detachWave=isSlip?Math.max(0,Math.sin(motionClock*(1.05+(i%4)*.13)+phase)):0;
      const dEnergy=isSlip?Math.min(1,lastMid*1.55+band*.55+hit*.28):0;
      const zoomOut=isSlip?1+detachWave*(.16+dEnergy*.48)*randomBody:1;
      let slipX=0;
      let slipY=0;
      // F is where translation finally begins: it explodes the already-scaled bodies outward.
      if(floatEnabled){
        const bodyGain=isFloat?1:.42;
        const orbit=motionClock*(.34+(i%5)*.055)+phase;
        const radiusX=105+lastMid*390+lastHigh*120+((i*41)%105);
        const radiusY=75+lastLow*300+lastMid*120+((i*23)%75);
        const hitKick=hit*(45+((i*17)%85));
        slipX=(Math.cos(orbit)*radiusX + Math.sign(Math.cos(phase))*lastHigh*95 + Math.cos(phase)*hitKick)*bodyGain;
        slipY=(Math.sin(orbit*.83)*radiusY + Math.sign(Math.sin(phase))*lastLow*70 + Math.sin(phase)*hitKick)*bodyGain;
      }
      const driftX=sway*(3+lastMid*13)+(lane===2?float*lastHigh*8:0)+slipX;
      const driftY=float*(2+lastLow*9)+(lane===0?sway*lastLow*5:0)+slipY;
      // No planar rotation: scale/pulse/translation are the visual vocabulary.
      const spatialBody=spatialEnabled||orbitEnabled||pixelEnabled||vortexEnabled||holeEnabled;
      let z=spatialBody?(-340+((i*97)%760)+lastLow*260+lastMid*90):0;
      let stageX=driftX+(spatialBody?spaceX:0),stageY=driftY+(spatialBody?spaceY:0),stageScale=zoomOut*(spatialBody?spaceZoom:1);
      if(spatialBody)z+=spaceZ;
      // H: the existing G field opens into a deeper 3D volume. No XY rotation.
      if(orbitEnabled){
        const depthWave=Math.sin(motionClock*(.42+(i%5)*.04)+phase);
        z+=depthWave*(420+lastLow*760)+hit*((i%2?1:-1)*220);
        stageX+=Math.sin(motionClock*.18+phase*.31)*(55+lastMid*150);
        stageY+=Math.cos(motionClock*.14+phase*.27)*(35+lastLow*120);
        stageScale*=1+Math.max(0,depthWave)*(.08+lastMid*.22);
      }
      // J: orbit/dance through translation only — elliptical trajectories + depth, still no planar rotation.
      if(pixelEnabled){
        const a=motionClock*(.22+(i%6)*.025)+phase;
        stageX+=Math.cos(a)*(90+lastMid*420+((i*31)%150));
        stageY+=Math.sin(a*.73)*(70+lastLow*300+((i*19)%110));
        z+=Math.sin(a*.51)*(180+lastHigh*460);
      }
      // K: bodies contract into a turbulent current around the future portal.
      if(vortexEnabled){
        const a=motionClock*(.55+lastHigh*.8)+phase;
        const pull=.45+lastMid*.5;
        stageX=stageX*(1-pull*.45)+Math.cos(a)*(70+lastHigh*210);
        stageY=stageY*(1-pull*.45)+Math.sin(a)*(55+lastLow*170);
        z+=Math.sin(a*1.37)*(100+hit*360);
        stageScale*=Math.max(.18,1-(lastHigh*.42+hit*.32)*(((i%5)+1)/5));
      }
      // L: same current is attracted to the centre while the black portal grows from a point.
      if(holeEnabled){
        const attract=Math.min(.82,.24+lastLow*.32+lastMid*.28+hit*.18);
        stageX*=1-attract;stageY*=1-attract;
        stageScale*=Math.max(.08,1-attract*.7);
      }
      ph.style.setProperty("--pulse",pulse.toFixed(4));
      ph.style.setProperty("--drift-x","0px");
      ph.style.setProperty("--drift-y","0px");
      if(floatEnabled||spatialBody)post.style.transform=`translate3d(${stageX.toFixed(2)}px,${stageY.toFixed(2)}px,${z.toFixed(1)}px) scale(${stageScale.toFixed(4)})`;
      else if(isSlip)post.style.transform=`translate3d(0,0,0) scale(${zoomOut.toFixed(4)})`;
      else post.style.transform="";
      if(vortexEnabled)ph.style.opacity=String(Math.max(.28,1-high*.38-hit*.18));
      else ph.style.opacity="1";
      ph.style.filter=`brightness(${(1+hit*(i%5===0?.16:.025)).toFixed(3)})`;
    });
    if(holeEnabled){
      const hs=18+lastLow*16+lastMid*10+hit*12;
      archiveHole.style.setProperty("--hole-scale",hs.toFixed(2));
      archiveHole.style.boxShadow=`0 0 ${(35+lastMid*120).toFixed(0)}px ${(10+lastLow*55).toFixed(0)}px rgba(0,0,0,.78)`;
    }
  });
</script>
</html>
