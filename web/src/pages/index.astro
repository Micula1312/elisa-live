<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Elisa Live — Social</title>
  <style>
    *{box-sizing:border-box}
    html,body{margin:0;width:100%;height:100%;font-family:Inter,Arial,Helvetica,sans-serif}
    body{background:#000;color:#111;overflow:hidden}
    button{font:inherit}
    #faceScene{position:fixed;inset:0;background:linear-gradient(180deg,#f8f9fb,#eef1f5);display:flex;align-items:center;justify-content:center;z-index:20}
    .auth-shell{width:min(440px,calc(100vw - 40px))}
    .auth-brand{text-align:center;margin-bottom:22px;font-size:18px;font-weight:700;letter-spacing:-.03em}
    .auth-card{background:#fff;border:1px solid #e2e5ea;border-radius:22px;padding:30px;box-shadow:0 18px 60px rgba(15,23,42,.12);text-align:center}
    .auth-card h1{font-size:22px;margin:0 0 7px;letter-spacing:-.03em}
    .auth-card p{font-size:14px;line-height:1.45;color:#69707d;margin:0 0 24px}
    .face-frame{position:relative;width:210px;height:210px;margin:0 auto 22px;overflow:hidden;border-radius:50%;background:#e9edf2;border:1px solid #d9dde4;box-shadow:inset 0 0 0 7px #fff,0 0 0 1px #dfe3e8}
    #camera{width:100%;height:100%;object-fit:cover;transform:scaleX(-1);opacity:0;transition:opacity .45s ease}
    #camera.visible{opacity:1}
    .scan-ring{position:absolute;inset:10px;border:2px solid rgba(30,104,255,.0);border-radius:50%;transition:.3s}
    .scanning .scan-ring{border-color:#1e68ff;border-top-color:transparent;animation:spin 1.1s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .face-icon{position:absolute;inset:0;display:grid;place-items:center;font-size:54px;color:#9ba3af;pointer-events:none;transition:.25s}
    #camera.visible~.face-icon{opacity:0}
    #status{min-height:20px;font-size:13px;color:#6c7480;margin-bottom:18px}
    #status.success{color:#16784b;font-weight:600}
    #start{width:100%;border:0;border-radius:10px;padding:13px 18px;background:#1769e0;color:#fff;font-weight:650;cursor:pointer;box-shadow:0 1px 2px rgba(0,0,0,.08)}
    #start:hover{background:#0d5dce}
    .auth-meta{display:flex;justify-content:center;gap:8px;align-items:center;margin-top:17px;color:#9aa1ab;font-size:11px}
    .dot{width:4px;height:4px;background:#b4bac2;border-radius:50%}
    #feedScene{display:none;position:fixed;inset:0;background:#fafafa;color:#111;overflow-y:auto}
    .feed-header{position:sticky;top:0;height:70px;z-index:5;display:flex;align-items:center;justify-content:space-between;padding:0 28px;background:rgba(250,250,250,.94);backdrop-filter:blur(12px);border-bottom:1px solid #ddd}
    .brand{font-size:22px;font-weight:700;letter-spacing:-.04em}.header-icons{display:flex;gap:18px;font-size:22px}
    .profile{max-width:950px;margin:auto;padding:55px 24px 28px;display:grid;grid-template-columns:180px 1fr;gap:60px;align-items:center}
    .avatar{width:150px;height:150px;border-radius:50%;background:radial-gradient(circle at 60% 35%,#eee 0 12%,transparent 13%),linear-gradient(135deg,#222,#aaa)}
    .username{font-size:28px;margin-bottom:20px}.stats{display:flex;gap:28px;margin-bottom:20px}.bio{line-height:1.45;max-width:500px}
    .grid{width:min(950px,100%);margin:auto;padding:1px 0 80px;display:grid;grid-template-columns:repeat(3,1fr);gap:3px}
    .post{aspect-ratio:4/5;overflow:hidden;position:relative;background:#ddd}
    .post:nth-child(3n+1){background:#151515}.post:nth-child(3n+2){background:#bcbcbc}.post:nth-child(3n){background:#565656}
    .placeholder{width:100%;height:100%;display:grid;place-items:center;font-size:clamp(28px,5vw,72px);letter-spacing:-.06em;color:#fff;will-change:transform;transform:scale(var(--breath,1));transition:transform .12s linear}.post{will-change:transform}.post.repeat::after{content:"";position:absolute;inset:0;pointer-events:none;border:0 solid transparent}
  
    #audioPanel{position:fixed;right:16px;bottom:16px;width:310px;padding:14px;background:rgba(10,12,16,.94);color:#fff;border:1px solid #30343b;border-radius:12px;z-index:9999;font:12px/1.3 monospace;box-shadow:0 12px 40px rgba(0,0,0,.28);display:none}
    #audioPanel.open{display:block} .ap-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.ap-title{font-weight:700}.ap-state{opacity:.6}
    #audioDevice{width:100%;background:#181b20;color:#fff;border:1px solid #333943;border-radius:6px;padding:7px;margin-bottom:8px}
    .ap-actions{display:flex;gap:6px;margin-bottom:10px}.ap-actions button{flex:1;background:#20242b;color:#fff;border:1px solid #393f49;border-radius:6px;padding:7px;cursor:pointer}
    .meter-row{display:grid;grid-template-columns:38px 1fr 34px;gap:7px;align-items:center;margin:5px 0}.meter{height:7px;background:#222831;border-radius:20px;overflow:hidden}.meter i{display:block;width:0;height:100%;background:#f1f1f1;border-radius:inherit}
    .sens{display:grid;grid-template-columns:75px 1fr 30px;gap:7px;align-items:center;margin-top:10px}.sens input{width:100%}.ap-hint{opacity:.45;margin-top:9px;font-size:10px}
  </style>
</head>
<body>
  <section id="faceScene">
    <div class="auth-shell">
      <div class="auth-brand">archive</div>
      <div class="auth-card">
        <h1>Welcome back</h1>
        <p>Verify your identity to continue to your account.</p>
        <div class="face-frame" id="faceFrame">
          <video id="camera" autoplay playsinline muted></video>
          <div class="face-icon">◎</div>
          <div class="scan-ring"></div>
        </div>
        <div id="status">Camera verification is ready</div>
        <button id="start">Continue with Face ID</button>
        <div class="auth-meta"><span>Secure sign in</span><span class="dot"></span><span>Privacy protected</span></div>
      </div>
    </div>
  </section>
  <section id="feedScene">
    <header class="feed-header"><div class="brand">archive</div><div class="header-icons"><span>♡</span><span>⊕</span><span>☰</span></div></header>
    <section class="profile"><div class="avatar"></div><div><div class="username">elisa.archive</div><div class="stats"><span><strong>42</strong> posts</span><span><strong>∞</strong> followers</span><span><strong>1</strong> following</span></div><div class="bio">reactive archive<br/>images / bodies / traces</div></div></section>
    <main class="grid">
      <div class="post"><div class="placeholder">01</div></div>
      <div class="post"><div class="placeholder">02</div></div>
      <div class="post"><div class="placeholder">03</div></div>
      <div class="post"><div class="placeholder">04</div></div>
      <div class="post"><div class="placeholder">05</div></div>
      <div class="post"><div class="placeholder">06</div></div>
      <div class="post"><div class="placeholder">07</div></div>
      <div class="post"><div class="placeholder">08</div></div>
      <div class="post"><div class="placeholder">09</div></div>
      <div class="post"><div class="placeholder">10</div></div>
      <div class="post"><div class="placeholder">11</div></div>
      <div class="post"><div class="placeholder">12</div></div>
    </main>
  </section>
  <script>
    const start=document.querySelector('#start');
    const camera=document.querySelector('#camera');
    const status=document.querySelector('#status');
    const faceFrame=document.querySelector('#faceFrame');
    const faceScene=document.querySelector('#faceScene');
    const feedScene=document.querySelector('#feedScene');
    async function authenticate(){
      start.disabled=true; start.textContent='Starting camera…'; status.textContent='Preparing secure verification';
      try{
        const stream=await navigator.mediaDevices.getUserMedia({video:true,audio:false});
        camera.srcObject=stream;
        setTimeout(()=>{camera.classList.add('visible');faceFrame.classList.add('scanning');status.textContent='Position your face in the circle';start.textContent='Verifying…'},500);
        setTimeout(()=>{status.textContent='Verifying identity…'},2200);
        setTimeout(()=>{faceFrame.classList.remove('scanning');status.textContent='Identity verified';status.classList.add('success');start.textContent='✓ Verified'},3500);
        setTimeout(()=>{faceScene.style.display='none';feedScene.style.display='block';window.dispatchEvent(new Event('elisa-feed-start'))},4400);
      }catch(error){
        status.textContent='Camera access is required to continue';start.disabled=false;start.textContent='Try again';console.error(error);
      }
    }
    start.addEventListener('click',authenticate);
  </script>

  <aside id="audioPanel">
    <div class="ap-head"><span class="ap-title">ELISA / AUDIO IN</span><span class="ap-state" id="audioState">OFF</span></div>
    <select id="audioDevice"><option value="">Default audio input</option></select>
    <div class="ap-actions"><button id="audioRefresh">REFRESH</button><button id="audioArm">ARM AUDIO</button></div>
    <div class="meter-row"><span>LVL</span><div class="meter"><i id="mLevel"></i></div><span id="vLevel">0.00</span></div>
    <div class="meter-row"><span>LOW</span><div class="meter"><i id="mLow"></i></div><span id="vLow">0.00</span></div>
    <div class="meter-row"><span>MID</span><div class="meter"><i id="mMid"></i></div><span id="vMid">0.00</span></div>
    <div class="meter-row"><span>HIGH</span><div class="meter"><i id="mHigh"></i></div><span id="vHigh">0.00</span></div>
    <div class="meter-row"><span>HIT</span><div class="meter"><i id="mHit"></i></div><span id="vHit">0.00</span></div>
    <label class="sens"><span>SENSITIVITY</span><input id="audioSensitivity" type="range" min=".2" max="5" step=".1" value="1.6"><span id="sensValue">1.6</span></label>
    <div class="ap-hint">A = show/hide · panel is local show-control only</div>
  </aside>
</body>

<script type="module">
  import {listAudioInputs,startAudio,setSensitivity} from "../lib/audio-engine.js";
  const panel=document.querySelector("#audioPanel"), device=document.querySelector("#audioDevice"), arm=document.querySelector("#audioArm"), refresh=document.querySelector("#audioRefresh"), astate=document.querySelector("#audioState"), sensitivity=document.querySelector("#audioSensitivity"), sensValue=document.querySelector("#sensValue");
  const bars={level:["mLevel","vLevel"],low:["mLow","vLow"],mid:["mMid","vMid"],high:["mHigh","vHigh"],transient:["mHit","vHit"]};
  async function populate(){
    try{
      const inputs=await listAudioInputs(), selected=device.value;
      device.innerHTML='<option value="">Default audio input</option>';
      inputs.forEach((d,i)=>{const o=document.createElement("option");o.value=d.deviceId;o.textContent=d.label||("Audio input "+(i+1));device.appendChild(o)});
      if([...device.options].some(o=>o.value===selected))device.value=selected;
    }catch(e){astate.textContent="DEVICE ERROR"}
  }
  document.addEventListener("keydown",e=>{if(e.key.toLowerCase()==="a"&&!["INPUT","TEXTAREA","SELECT"].includes(document.activeElement?.tagName))panel.classList.toggle("open")});
  refresh.addEventListener("click",populate);
  arm.addEventListener("click",async()=>{try{astate.textContent="REQUESTING…";await startAudio(device.value);astate.textContent="LIVE";arm.textContent="RE-ARM";await populate()}catch(e){astate.textContent="DENIED";console.error(e)}});
  sensitivity.addEventListener("input",()=>{setSensitivity(sensitivity.value);sensValue.textContent=Number(sensitivity.value).toFixed(1)});
  window.addEventListener("elisa-audio",e=>{for(const [key,[bar,val]] of Object.entries(bars)){const n=e.detail[key]||0;document.getElementById(bar).style.width=(n*100)+"%";document.getElementById(val).textContent=n.toFixed(2)}});
  populate();

  // PERFORMANCE FEED ENGINE — manual scroll, endless recycled archive, slow audio "breathing".
  const feed=document.querySelector("#feedScene"), grid=document.querySelector(".grid");
  const seed=[...grid.querySelectorAll(".post")].map((el,i)=>({html:el.innerHTML,index:i}));
  let batch=1, feedStartedAt=0, breathEnabled=false, lastLow=0;

  function appendBatch(){
    // Deterministic reorder: recognisable repetitions, but never an obvious identical page loop.
    const order=batch%3===1?[4,1,8,0,10,6,3,11,2,7,5,9]:batch%3===2?[8,3,1,10,5,0,11,6,4,2,9,7]:[2,9,5,1,7,11,0,6,10,3,8,4];
    order.forEach((seedIndex,pos)=>{
      const post=document.createElement("div");
      post.className="post repeat";
      post.dataset.source=String(seedIndex+1);
      post.dataset.batch=String(batch);
      post.innerHTML=seed[seedIndex].html;
      // Keep source identity visible for now; real media will replace these placeholders.
      const ph=post.querySelector(".placeholder");
      if(ph) ph.textContent=String(seedIndex+1).padStart(2,"0");
      grid.appendChild(post);
    });
    batch++;
  }

  function ensureScrollBuffer(){
    const remaining=feed.scrollHeight-feed.scrollTop-feed.clientHeight;
    if(remaining<feed.clientHeight*2.2) appendBatch();
  }

  // Start with enough depth that scrolling never reaches an artificial bottom.
  appendBatch(); appendBatch(); appendBatch();
  feed.addEventListener("scroll",ensureScrollBuffer,{passive:true});

  window.addEventListener("elisa-feed-start",()=>{
    feedStartedAt=performance.now();
    // About one minute of apparently normal scrolling, then the first anomaly can emerge.
    setTimeout(()=>{breathEnabled=true},55000);
  });

  // B = manual breathing cue. Useful in rehearsal/live: never forces us to wait 55 seconds.
  document.addEventListener("keydown",e=>{
    if(e.key.toLowerCase()==="b"&&!["INPUT","TEXTAREA","SELECT"].includes(document.activeElement?.tagName)){
      breathEnabled=!breathEnabled;
    }
  });

  window.addEventListener("elisa-audio",e=>{
    const low=e.detail.low||0;
    lastLow+=(low-lastLow)*.16;
    const elapsed=feedStartedAt?(performance.now()-feedStartedAt)/1000:0;
    // Automatic onset is deliberately tiny. B can also arm it at any moment.
    const amount=breathEnabled?Math.min(.018,.004+Math.max(0,elapsed-55)*.00025):0;
    const scale=1+lastLow*amount;
    grid.style.setProperty("--breath",scale.toFixed(4));
  });
</script>
</html>
