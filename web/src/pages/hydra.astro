<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>ELISA — HYDRA LIVE</title>
  <style>
    html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000}
    #hydra-canvas{position:fixed;inset:0;width:100vw;height:100vh;display:block}#master-fade{position:fixed;inset:0;z-index:12;pointer-events:none;background:#000;opacity:0}
    #editor-shell{position:fixed;left:3vw;top:5vh;width:min(720px,70vw);height:82vh;z-index:20;
      background:rgba(0,0,0,.72);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.28);
      box-shadow:0 0 40px rgba(0,0,0,.45);display:none}
    #editor-shell.open{display:flex;flex-direction:column}
    #bar{font:12px/1.2 monospace;color:#fff;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.2);
      display:flex;justify-content:space-between;gap:18px;user-select:none}
    #code{flex:1;resize:none;border:0;outline:0;padding:16px;background:transparent;color:#fff;
      caret-color:#fff;font:15px/1.45 Consolas,monospace;white-space:pre;tab-size:2}
    #status{font:11px/1.2 Helvetica,Arial,sans-serif;padding:8px 12px;color:#aaa;border-top:1px solid rgba(255,255,255,.15)}#scene-tag{position:fixed;right:18px;bottom:16px;z-index:30;color:#aaa;font:11px Helvetica,Arial,sans-serif;letter-spacing:.12em;opacity:.75}#editor-toggle{position:fixed;left:16px;bottom:16px;z-index:40;border:1px solid rgba(255,255,255,.5);background:rgba(0,0,0,.75);color:#fff;padding:9px 12px;font:11px Helvetica,Arial,sans-serif;cursor:pointer}
    #status.error{color:#ff8b8b}
    #midi-monitor{position:fixed;left:16px;top:16px;z-index:45;min-width:260px;padding:10px 12px;border:1px solid rgba(57,255,20,.45);background:rgba(0,0,0,.78);color:#39ff14;font:11px/1.45 Helvetica,Arial,sans-serif;letter-spacing:.06em;pointer-events:none}
    #midi-monitor b{color:#fff;font-weight:400} #midi-monitor.off{border-color:#555;color:#777}
    #capital-counter{display:none;position:fixed;right:18px;bottom:38px;z-index:35;text-align:right;font-family:Helvetica,Arial,sans-serif;pointer-events:none;mix-blend-mode:screen}
    #capital-counter .money{color:#39ff14;font-size:clamp(20px,2.4vw,38px);font-weight:700;letter-spacing:-.05em;text-shadow:0 0 12px rgba(57,255,20,.65)}
    #capital-counter .tears{color:#ff2400;font-size:clamp(12px,1.25vw,18px);letter-spacing:.04em;text-shadow:0 0 10px rgba(255,36,0,.6)}
    #capital-counter.pop{animation:capitalPop .28s ease-out}@keyframes capitalPop{0%{transform:scale(1)}45%{transform:scale(1.22) rotate(-2deg)}100%{transform:scale(1)}}
  to{transform:translate(-50%,-34vh)}}
    #farewell-credits{position:fixed;inset:0;overflow:hidden;display:none;z-index:8;pointer-events:none;perspective:420px;background:linear-gradient(to bottom,transparent 0 54%,rgba(0,0,0,.16) 100%)}
    #farewell-credits.on{display:block}
    #farewell-credits-inner{position:absolute;left:12%;right:12%;top:100%;text-align:center;color:#39FF14;font:700 clamp(22px,3.1vw,54px)/1.55 Helvetica,Arial,sans-serif;white-space:pre-wrap;letter-spacing:.035em;transform-origin:50% 100%;transform:rotateX(22deg) translateY(0) scale(1)}
    #farewell-credits.on #farewell-credits-inner{animation:farewellCrawl 60s linear both}
    @keyframes farewellCrawl{0%{transform:translateY(0) rotateX(22deg) scale(1)}100%{transform:translateY(calc(-100vh - 100%)) rotateX(27deg) scale(.72)}}
  </style>
</head>
<body>
  <canvas id="hydra-canvas"></canvas>
  <div id="master-fade"></div>
  <div id="farewell-credits"><div id="farewell-credits-inner"></div></div>
  <canvas id="landscape-source" style="display:none"></canvas>
  <canvas id="type-source" style="display:none"></canvas>
  <canvas id="heart-source" style="display:none"></canvas>
  <canvas id="archive-source" style="display:none"></canvas>
  <video id="webcam-source" autoplay muted playsinline style="display:none"></video>
  <section id="editor-shell">
    <div id="bar"><span>ELISA / HYDRA LIVE</span><span>CTRL+ENTER RUN · CTRL+Z BACK · CTRL+E HIDE</span></div>
    <textarea id="code" spellcheck="false"></textarea>
    <div id="status">READY</div>
  </section>
  <div id="capital-counter"><div class="money" id="money-count">$000000</div><div class="tears" id="tear-count">💧 000</div></div>
  <div id="scene-tag">HYDRA · CUSTOM 01</div>
  <button id="editor-toggle" type="button">EDITOR · CTRL+E</button>
  <div id="midi-monitor" class="off">MIDI · CONNECTING…<br><b>move a knob / pad</b></div>

  <script is:inline>window.global=window;</script>
  <script>
    const canvas=document.getElementById('hydra-canvas');
    const landscapeCanvas=document.getElementById('landscape-source');
    const typeCanvas=document.getElementById('type-source'),typeCtx=typeCanvas.getContext('2d');
    const heartCanvas=document.getElementById('heart-source'),heartCtx=heartCanvas.getContext('2d');
    const archiveCanvas=document.getElementById('archive-source'),archiveCtx=archiveCanvas.getContext('2d');
    const webcamVideo=document.getElementById('webcam-source');
    const editor=document.getElementById('editor-shell');
    const code=document.getElementById('code');
    const status=document.getElementById('status');
    const sceneTag=document.getElementById('scene-tag');
    const editorToggle=document.getElementById('editor-toggle');
    const midiMonitor=document.getElementById('midi-monitor');
    const masterFade=document.getElementById('master-fade');
    const farewellCredits=document.getElementById('farewell-credits'),farewellCreditsInner=document.getElementById('farewell-credits-inner');
    let farewellTree=null,farewellSun3D=null,farewellStartedAt=0;
    const capitalCounter=document.getElementById('capital-counter'),moneyCount=document.getElementById('money-count'),tearCount=document.getElementById('tear-count');
    let capital=0,tears=0;
    function incrementCapital(id){
      const value={tree:120,swarm:260,phone:999,pistol:1800,diamond:5000,cola:450,orb:700,totem:1100}[id]||100;
      capital+=value;
      tears+=id==='tree'?1:id==='swarm'?3:Math.max(2,Math.round(value/450));
      moneyCount.textContent='$'+String(capital).padStart(6,'0');
      tearCount.textContent='💧 '+String(tears).padStart(3,'0');
      capitalCounter.classList.remove('pop');
      void capitalCounter.offsetWidth;
      capitalCounter.classList.add('pop');
    }
    const toggleEditor=()=>{editor.classList.toggle('open');editorToggle.textContent=editor.classList.contains('open')?'CLOSE EDITOR · CTRL+E':'EDITOR · CTRL+E';if(editor.classList.contains('open'))code.focus()};

    // MIDI probe: browser reads the same USB controller independently from TouchDesigner.
    window.ELISA_MIDI={device:'',type:'',channel:0,cc:null,note:null,value:0,norm:0};
    // Four global performance macros. CC 16–19 are readable directly from Hydra live code.
    window.ELISA_CTRL={param1:0,param2:0,audioReact:1,audioChaos:0,resonanceCam:0,drop:0,fadeWhite:0,fadeBlack:0};
    const MIDI_MACROS={16:'param1',17:'param2',18:'audioReact',19:'audioChaos',20:'fadeWhite',21:'fadeBlack'};
    window.param1=()=>window.ELISA_CTRL.param1;
    window.param2=()=>window.ELISA_CTRL.param2;
    window.audioReact=()=>window.ELISA_CTRL.audioReact;
    window.audioChaos=()=>window.ELISA_CTRL.audioChaos;
    // Backwards-compatible aliases so older authored patches never break.
    window.deform=()=>param1();
    window.feedback=()=>param2();
    window.melt=()=>audioReact();
    window.chaos=()=>audioChaos();
    window.drop=()=>window.ELISA_CTRL.drop;
    function applyMasterFade(){
      const w=window.ELISA_CTRL.fadeWhite||0,b=window.ELISA_CTRL.fadeBlack||0;
      if(w>=b){masterFade.style.background='#fff';masterFade.style.opacity=String(w)}
      else{masterFade.style.background='#000';masterFade.style.opacity=String(b)}
    }
    // Global pad invert and audio-reactive Resonance polarity.
    // Inversion changes capped at roughly 6 Hz.
    let padInvert=false,resonanceInvert=false,lastResonanceSwitch=0;
    function applyInvert(){canvas.style.filter=(padInvert!==resonanceInvert)?'invert(1)':'none'}
    function setInvert(on){padInvert=!!on;applyInvert()}
    function updateResonanceStrobe(now){
      if(currentScene!=='resonance'||midiTarget!=='hydra'){
        if(resonanceInvert){resonanceInvert=false;applyInvert()}
        return;
      }
      const drive=param1(),energy=Math.min(1,hit()*.8+low()*.36+high()*.22);
      const active=drive>.035&&energy>(.60-drive*.46);
      const wave=Math.sin(now*.001*(8+drive*22));
      const wanted=active&&wave>(.88-drive*.95);
      if(wanted!==resonanceInvert&&now-lastResonanceSwitch>165){
        resonanceInvert=wanted;lastResonanceSwitch=now;applyInvert();
      }
    }
    function resonanceStrobeLoop(now){updateResonanceStrobe(now);requestAnimationFrame(resonanceStrobeLoop)}
    requestAnimationFrame(resonanceStrobeLoop);
    function setDrop(on){
      window.ELISA_CTRL.drop=on?1:0;
      if(on)archiveDrop();
      if(currentScene==='hypnosis')hypnosisDrop=on?1:0;
      status.textContent=on?'DROP · MIDI 13':'DROP · RELEASE';
    }
    let midiTarget=localStorage.getItem('elisa-midi-target')==='td'?'td':'hydra';
    const midiRouteBus=new BroadcastChannel('elisa-midi-route');
    midiRouteBus.onmessage=e=>{
      if(e.data?.type!=='midi-target')return;
      midiTarget=e.data.target==='td'?'td':'hydra';
      localStorage.setItem('elisa-midi-target',midiTarget);
      if(midiTarget==='td'){setDrop(false);setInvert(false);resonanceInvert=false;applyInvert();midiMonitor.innerHTML='MIDI · TOUCHDESIGNER ACTIVE<br><b>HYDRA CONTROLS MUTED</b>'}
      else midiMonitor.innerHTML='MIDI · HYDRA ACTIVE<br><b>move a knob / pad</b>';
    };
    function showMidi(input,data){
      if(midiTarget!=='hydra')return;
      const [statusByte,d1,d2]=data,kind=statusByte&0xf0,channel=(statusByte&0x0f)+1;
      const type=kind===0xb0?'CC':kind===0x90?'NOTE ON':kind===0x80?'NOTE OFF':'MIDI';
      const isCC=kind===0xb0,value=d2??0;
      Object.assign(window.ELISA_MIDI,{device:input.name||'MIDI',type,channel,cc:isCC?d1:null,note:isCC?null:d1,value,norm:value/127});
      if(isCC&&MIDI_MACROS[d1]){window.ELISA_CTRL[MIDI_MACROS[d1]]=value/127;if(d1===20||d1===21)applyMasterFade()}
      if(isCC&&d1===19&&currentScene==='resonance')window.ELISA_CTRL.resonanceCam=value/127;
      // AKAI pad 13 on MIDI channel 10: momentary DROP gate (note-on / note-off).
      if(channel===10&&d1===13&&(kind===0x90||kind===0x80)) setDrop(kind===0x90&&value>0);
      // CH10 pad 14: global momentary video invert, all Hydra scenes.
      if(channel===10&&d1===14&&(kind===0x90||kind===0x80))setInvert(kind===0x90&&value>0);
      if(currentScene==='genesis'&&channel===10&&kind===0x90&&value>0&&d1!==13&&d1!==14){
        const explicit={1:'single',2:'burst',3:'hero',4:'rain'}[d1];
        const modes=['single','burst','hero','rain'];
        const mode=explicit||modes[((d1%4)+4)%4];
        spawnArchiveImage(mode);
      }
      midiMonitor.classList.remove('off');
      const macro=isCC&&MIDI_MACROS[d1]?' · <b>'+MIDI_MACROS[d1].toUpperCase()+'</b>':'';
      midiMonitor.innerHTML='MIDI · <b>'+window.ELISA_MIDI.device+'</b><br>'+type+' · CH '+channel+' · '+(isCC?'CC ':'NOTE ')+d1+' · VALUE <b>'+value+'</b>'+macro+'<br>P1 '+param1().toFixed(2)+' · P2 '+param2().toFixed(2)+' · AUDIO '+audioReact().toFixed(2)+' · CHAOS '+audioChaos().toFixed(2);
    }
    function bindMidi(access){
      const inputs=[...access.inputs.values()];
      if(!inputs.length){midiMonitor.classList.add('off');midiMonitor.innerHTML='MIDI · NO DEVICE<br><b>connect AKAI then reload</b>';return}
      midiMonitor.classList.remove('off');
      midiMonitor.innerHTML='MIDI · <b>'+inputs.map(i=>i.name).join(' / ')+'</b><br>READY · move a knob / pad';
      inputs.forEach(input=>input.onmidimessage=e=>showMidi(input,e.data));
      access.onstatechange=()=>bindMidi(access);
    }
    if(navigator.requestMIDIAccess){
      navigator.requestMIDIAccess().then(bindMidi).catch(err=>{midiMonitor.classList.add('off');midiMonitor.innerHTML='MIDI ERROR · '+err.message});
    }else midiMonitor.innerHTML='MIDI · WEB MIDI NOT SUPPORTED';

    canvas.width=innerWidth; canvas.height=innerHeight;

    const {default:Hydra}=await import('hydra-synth');
    const THREE=await import('three');
    const ACID=0x39ff14, FIRE_RED=0xff2400;
    let hypnosisWord='I AM',webcamReady=false,hypnosisDrop=0;
    const faceMotion={x:.5,y:.5,size:.28,v:0,px:.5,py:.5,ps:.28,last:0};
    let faceDetector=null,trackingMode='motion',handLandmarker=null,handTrackingLoading=false,lastHandTrack=0,heartGesture=false,heartHold=0;
    const hearts=[];let handDebug='HANDS · WAITING',handTrackError='';
    const motionCanvas=document.createElement('canvas'),motionCtx=motionCanvas.getContext('2d',{willReadFrequently:true});
    motionCanvas.width=160;motionCanvas.height=90;let motionPrev=null;
    const hydra=new Hydra({canvas,detectAudio:false,enableStreamCapture:false,makeGlobal:true,autoLoop:true,width:innerWidth,height:innerHeight});
    // Shared browser audio authority. /regia publishes one normalized analysis stream;
    // Hydra consumes it instead of opening a second microphone/analyser.
    window.ELISA_SHARED_AUDIO={level:0,low:0,mid:0,high:0,transient:0,bell500:0,source:"none",updatedAt:0};
    const sharedAudioBus=new BroadcastChannel("elisa-audio");
    sharedAudioBus.onmessage=e=>{if(e.data?.type==="audio-frame")Object.assign(window.ELISA_SHARED_AUDIO,e.data)};
    window.bell500=()=>window.ELISA_SHARED_AUDIO.bell500||0;
    window.rawLow=()=>window.ELISA_SHARED_AUDIO.low||0;
    window.rawMid=()=>window.ELISA_SHARED_AUDIO.mid||0;
    window.rawHigh=()=>window.ELISA_SHARED_AUDIO.high||0;
    window.rawHit=()=>window.ELISA_SHARED_AUDIO.transient||0;
    window.rawLevel=()=>window.ELISA_SHARED_AUDIO.level||0;
    const audioGain=()=>Math.max(0,audioReact())*(1+audioChaos()*1.65);
    window.low=()=>Math.min(1.5,rawLow()*audioGain());
    window.mid=()=>Math.min(1.5,rawMid()*audioGain()*(1+audioChaos()*.35));
    window.high=()=>Math.min(1.8,rawHigh()*audioGain()*(1+audioChaos()*.9));
    window.hit=()=>Math.min(2,rawHit()*audioGain()*(1+audioChaos()*1.8));
    window.level=()=>Math.min(1.5,rawLevel()*audioGain());
    // GLOBAL HYDRA MIDI GRAMMAR — identical in every scene:
    // CC16 = PARAM 1 · CC17 = PARAM 2
    // CC18 = AUDIO REACT amount · CC19 = AUDIO CHAOS / peak violence
    // PAD 1/2/3/4 CH10 = archive single / burst / hero / rain
    // PAD 13 / MIDI CH10 = DROP
    // CC20 = global WHITE fade · CC21 = global BLACK fade

    // THREE.JS landscape source -> Hydra s0. It keeps rendering in the background;
    // GENESIS decides when to expose/process it.
    const landscape={
      renderer:new THREE.WebGLRenderer({canvas:landscapeCanvas,antialias:true,alpha:false}),
      scene:new THREE.Scene(),
      camera:new THREE.PerspectiveCamera(58,innerWidth/innerHeight,.1,220),
      mesh:null,base:null,active:false,
      objects:{orb:[],totem:[],swarm:[],tree:[],phone:[],diamond:[],cola:[],pistol:[]},
      nav:{x:0,z:0,yaw:0},flash:0
    };
    landscape.renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
    landscape.renderer.setSize(innerWidth,innerHeight,false);
    landscape.renderer.setClearColor(0x000000,1);
    landscape.camera.position.set(0,4.6,10);
    landscape.camera.lookAt(0,-1,-18);
    {
      const geo=new THREE.PlaneGeometry(38,90,90,150);geo.rotateX(-Math.PI/2);
      landscape.base=Float32Array.from(geo.attributes.position.array);
      landscape.mesh=new THREE.Mesh(geo,new THREE.MeshBasicMaterial({color:ACID,wireframe:true,transparent:true,opacity:.88}));
      landscape.mesh.position.z=-28;landscape.scene.add(landscape.mesh);
    }
    function addGenesisObject(id){
      const n=landscape.objects[id].length,seed=n+1;
      let obj;
      if(id==='orb'){
        obj=new THREE.Mesh(new THREE.IcosahedronGeometry(1.55+Math.min(n,.9)*.22,2),new THREE.MeshBasicMaterial({color:ACID,wireframe:true,transparent:true,opacity:.9}));
        obj.position.set(-7+(n%5)*3.3,2.8+(n%3)*1.25,-17-(n%6)*5);
      }else if(id==='totem'){
        obj=new THREE.Mesh(new THREE.CylinderGeometry(.45,.95,6.5,5+(n%4),6,true),new THREE.MeshBasicMaterial({color:ACID,wireframe:true,transparent:true,opacity:.84}));
        obj.position.set(7-(n%5)*3.1,.5,-20-(n%6)*5.5);
      }else if(['phone','diamond','cola','pistol'].includes(id)){
        const group=new THREE.Group(),mat=new THREE.MeshBasicMaterial({color:ACID,wireframe:true,transparent:true,opacity:.92});
        if(id==='phone'){
          group.add(new THREE.Mesh(new THREE.BoxGeometry(2.2,4.2,.35),mat));
          const screen=new THREE.Mesh(new THREE.PlaneGeometry(1.75,3.35),mat);screen.position.z=.19;group.add(screen);
        }else if(id==='diamond'){
          const top=new THREE.Mesh(new THREE.CylinderGeometry(1.8,1.05,1.1,8),mat);top.position.y=.55;group.add(top);
          const tip=new THREE.Mesh(new THREE.ConeGeometry(1.05,2.2,8),mat);tip.position.y=-1.1;tip.rotation.x=Math.PI;group.add(tip);
        }else if(id==='cola'){
          const body=new THREE.Mesh(new THREE.CylinderGeometry(.72,.82,3.8,14,5),mat);group.add(body);
          const neck=new THREE.Mesh(new THREE.CylinderGeometry(.38,.62,.9,12),mat);neck.position.y=2.25;group.add(neck);
          const cap=new THREE.Mesh(new THREE.CylinderGeometry(.42,.42,.18,12),mat);cap.position.y=2.78;group.add(cap);
        }else{
          const slide=new THREE.Mesh(new THREE.BoxGeometry(3.6,.65,.75),mat);slide.position.x=.5;group.add(slide);
          const grip=new THREE.Mesh(new THREE.BoxGeometry(.8,2,.7),mat);grip.position.set(.15,-1.15,0);grip.rotation.z=-.18;group.add(grip);
        }
        obj=group;obj.position.set((Math.random()-.5)*30,1.5+Math.random()*8,-7-Math.random()*55);
      }else if(id==='tree'){
        const group=new THREE.Group(),trunkMat=new THREE.LineBasicMaterial({color:ACID,transparent:true,opacity:.88});
        const h=4.5+Math.random()*5,branches=5+Math.floor(Math.random()*5);
        const trunkGeo=new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0,0,0),new THREE.Vector3(0,h,0)]);
        group.add(new THREE.Line(trunkGeo,trunkMat));
        for(let b=0;b<branches;b++){
          const y=h*(.38+b/(branches+2)*.55),a=Math.random()*Math.PI*2,len=1.3+Math.random()*2.8;
          const tip=new THREE.Vector3(Math.cos(a)*len,y+.5+Math.random()*1.8,Math.sin(a)*len);
          group.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0,y,0),tip]),trunkMat));
          const twig=tip.clone().add(new THREE.Vector3(Math.cos(a+.8)*len*.45,.6+Math.random(),Math.sin(a+.8)*len*.45));
          group.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints([tip,twig]),trunkMat));
        }
        obj=group;obj.position.set((Math.random()-.5)*34, -1.2, -8-Math.random()*70);
      }else if(id==='swarm'){
        const count=260,geo=new THREE.BufferGeometry(),p=new Float32Array(count*3);
        for(let i=0;i<count;i++){const k=i*3;p[k]=(Math.random()-.5)*10;p[k+1]=(Math.random()-.5)*6;p[k+2]=(Math.random()-.5)*12}
        geo.setAttribute('position',new THREE.BufferAttribute(p,3));
        obj=new THREE.Points(geo,new THREE.PointsMaterial({color:ACID,size:.07,transparent:true,opacity:.78}));
        obj.position.set((n%5-2)*4,3+(n%3),-18-(n%5)*7);
      }else return;
      obj.userData={kind:id,seed,baseX:obj.position.x,baseY:obj.position.y,baseZ:obj.position.z,spawn:performance.now(),growth:id==='tree'?0:1};
      if(id==='tree')obj.scale.set(.015,.015,.015);
      if(['phone','diamond','cola','pistol'].includes(id)){
        obj.traverse(ch=>{if(ch.material?.color)ch.material.color.setHex(FIRE_RED)});
        landscape.flash=1;
      }
      landscape.objects[id].push(obj);landscape.scene.add(obj);incrementCapital(id);
      status.textContent='ADD '+id.toUpperCase()+' · '+landscape.objects[id].length;
    }
    function clearLandscapeObjects(){
      Object.values(landscape.objects).forEach(list=>{list.forEach(obj=>landscape.scene.remove(obj));list.length=0});
      farewellTree=null;
      if(farewellSun3D){landscape.scene.remove(farewellSun3D);farewellSun3D.geometry?.dispose();farewellSun3D.material?.dispose();farewellSun3D=null}
    }
    // FINAL TREE: lightweight 3D starbursts triggered by energy around 500 Hz.
    const farewellStars=[];
    let lastBell=0,bellWasHigh=false;
    const starShape=new THREE.Shape();
    for(let i=0;i<10;i++){
      const a=i*Math.PI/5-Math.PI/2,r=i%2?.27:.68;
      const x=Math.cos(a)*r,y=Math.sin(a)*r;
      if(i===0)starShape.moveTo(x,y);else starShape.lineTo(x,y);
    }
    starShape.closePath();
    const starGeometry=new THREE.ExtrudeGeometry(starShape,{depth:.16,bevelEnabled:true,bevelThickness:.07,bevelSize:.06,bevelSegments:1,steps:1});
    function spawnFarewellStars(){
      for(let i=0;i<3&&farewellStars.length<42;i++){
        const material=new THREE.MeshBasicMaterial({color:i===0?0xffffff:ACID,transparent:true,opacity:.95,side:THREE.DoubleSide,depthWrite:false});
        const star=new THREE.Mesh(starGeometry,material);
        const angle=Math.random()*Math.PI*2,dist=2+Math.random()*7;
        star.position.set(Math.cos(angle)*dist,1+Math.random()*6,-17+Math.sin(angle)*dist);
        const size=.22+Math.random()*.55;star.scale.setScalar(size);
        star.userData={birth:performance.now(),life:1900+Math.random()*2200,baseSize:size,vy:.003+Math.random()*.004,spin:.015+Math.random()*.02};
        farewellStars.push(star);landscape.scene.add(star);
      }
    }
    function clearFarewellStars(){
      farewellStars.forEach(star=>{landscape.scene.remove(star);star.material.dispose()});
      farewellStars.length=0;bellWasHigh=false;lastBell=0;
