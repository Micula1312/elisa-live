<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>ELISA — HYDRA LIVE</title>
  <style>
    html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000}
    #hydra-canvas{position:fixed;inset:0;width:100vw;height:100vh;display:block}
    #editor-shell{position:fixed;left:3vw;top:5vh;width:min(720px,70vw);height:82vh;z-index:20;
      background:rgba(0,0,0,.72);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.28);
      box-shadow:0 0 40px rgba(0,0,0,.45);display:none}
    #editor-shell.open{display:flex;flex-direction:column}
    #bar{font:12px/1.2 monospace;color:#fff;padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.2);
      display:flex;justify-content:space-between;gap:18px;user-select:none}
    #code{flex:1;resize:none;border:0;outline:0;padding:16px;background:transparent;color:#fff;
      caret-color:#fff;font:15px/1.45 Consolas,monospace;white-space:pre;tab-size:2}
    #status{font:11px/1.2 Helvetica,Arial,sans-serif;padding:8px 12px;color:#aaa;border-top:1px solid rgba(255,255,255,.15)}#scene-tag{position:fixed;right:18px;bottom:16px;z-index:30;color:#aaa;font:11px Helvetica,Arial,sans-serif;letter-spacing:.12em;opacity:.75}#editor-toggle{position:fixed;left:16px;bottom:16px;z-index:40;border:1px solid rgba(255,255,255,.5);background:rgba(0,0,0,.75);color:#fff;padding:9px 12px;font:11px Helvetica,Arial,sans-serif;cursor:pointer}
    #status.error{color:#ff8b8b}
    #capital-counter{position:fixed;right:18px;bottom:38px;z-index:35;text-align:right;font-family:Helvetica,Arial,sans-serif;pointer-events:none;mix-blend-mode:screen}
    #capital-counter .money{color:#39ff14;font-size:clamp(20px,2.4vw,38px);font-weight:700;letter-spacing:-.05em;text-shadow:0 0 12px rgba(57,255,20,.65)}
    #capital-counter .tears{color:#ff2bd6;font-size:clamp(12px,1.25vw,18px);letter-spacing:.04em;text-shadow:0 0 10px rgba(255,43,214,.6)}
    #capital-counter.pop{animation:capitalPop .28s ease-out}@keyframes capitalPop{0%{transform:scale(1)}45%{transform:scale(1.22) rotate(-2deg)}100%{transform:scale(1)}}
  </style>
</head>
<body>
  <canvas id="hydra-canvas"></canvas>
  <canvas id="landscape-source" style="display:none"></canvas>
  <canvas id="type-source" style="display:none"></canvas>
  <video id="webcam-source" autoplay muted playsinline style="display:none"></video>
  <section id="editor-shell">
    <div id="bar"><span>ELISA / HYDRA LIVE</span><span>CTRL+ENTER RUN · CTRL+Z BACK · CTRL+E HIDE</span></div>
    <textarea id="code" spellcheck="false"></textarea>
    <div id="status">READY</div>
  </section>
  <div id="capital-counter"><div class="money" id="money-count">$000000</div><div class="tears" id="tear-count">💧 000</div></div>
  <div id="scene-tag">HYDRA · CUSTOM 01</div>
  <button id="editor-toggle" type="button">EDITOR · CTRL+E</button>

  <script is:inline>window.global=window;</script>
  <script>
    const canvas=document.getElementById('hydra-canvas');
    const landscapeCanvas=document.getElementById('landscape-source');
    const typeCanvas=document.getElementById('type-source'),typeCtx=typeCanvas.getContext('2d');
    const webcamVideo=document.getElementById('webcam-source');
    const editor=document.getElementById('editor-shell');
    const code=document.getElementById('code');
    const status=document.getElementById('status');
    const sceneTag=document.getElementById('scene-tag');
    const editorToggle=document.getElementById('editor-toggle');
    const capitalCounter=document.getElementById('capital-counter'),moneyCount=document.getElementById('money-count'),tearCount=document.getElementById('tear-count');
    let capital=0,tears=0;
    function incrementCapital(id){
      const value={tree:120,swarm:260,phone:999,pistol:1800,diamond:5000,cola:450,orb:700,totem:1100}[id]||100;
      capital+=value;
      tears+=id==='tree'?1:id==='swarm'?3:Math.max(2,Math.round(value/450));
      moneyCount.textContent='$'+String(capital).padStart(6,'0');
      tearCount.textContent='💧 '+String(tears).padStart(3,'0');
      capitalCounter.classList.remove('pop');
      void capitalCounter.offsetWidth;
      capitalCounter.classList.add('pop');
    }
    const toggleEditor=()=>{editor.classList.toggle('open');editorToggle.textContent=editor.classList.contains('open')?'CLOSE EDITOR · CTRL+E':'EDITOR · CTRL+E';if(editor.classList.contains('open'))code.focus()};
    canvas.width=innerWidth; canvas.height=innerHeight;

    const {default:Hydra}=await import('hydra-synth');
    const THREE=await import('three');
    const ACID=0x39ff14, MAGENTA=0xff2bd6;
    let hypnosisWord='I AM',webcamReady=false,hypnosisDrop=0;
    const faceMotion={x:.5,y:.5,size:.28,v:0,px:.5,py:.5,ps:.28,last:0};
    let faceDetector=null,trackingMode='motion',handLandmarker=null,handTrackingLoading=false,lastHandTrack=0,heartGesture=false,heartHold=0;
    const hearts=[];let handDebug='HANDS · WAITING';
    const motionCanvas=document.createElement('canvas'),motionCtx=motionCanvas.getContext('2d',{willReadFrequently:true});
    motionCanvas.width=160;motionCanvas.height=90;let motionPrev=null;
    const hydra=new Hydra({canvas,detectAudio:true,enableStreamCapture:false,makeGlobal:true,autoLoop:true,width:innerWidth,height:innerHeight});
    const audio=hydra.synth.a;
    if(audio){audio.setBins(4);audio.setSmooth(.82);audio.setCutoff(1);audio.setScale(6);audio.show()}
    window.low=()=>audio?.fft?.[0]??0;
    window.mid=()=>((audio?.fft?.[1]??0)+(audio?.fft?.[2]??0))*.5;
    window.high=()=>audio?.fft?.[3]??0;

    // THREE.JS landscape source -> Hydra s0. It keeps rendering in the background;
    // GENESIS decides when to expose/process it.
    const landscape={
      renderer:new THREE.WebGLRenderer({canvas:landscapeCanvas,antialias:true,alpha:false}),
      scene:new THREE.Scene(),
      camera:new THREE.PerspectiveCamera(58,innerWidth/innerHeight,.1,220),
      mesh:null,base:null,active:false,
      objects:{orb:[],totem:[],swarm:[],tree:[],phone:[],diamond:[],cola:[],pistol:[]},
      nav:{x:0,z:0,yaw:0},flash:0
    };
    landscape.renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
    landscape.renderer.setSize(innerWidth,innerHeight,false);
    landscape.renderer.setClearColor(0x000000,1);
    landscape.camera.position.set(0,4.6,10);
    landscape.camera.lookAt(0,-1,-18);
    {
      const geo=new THREE.PlaneGeometry(38,90,90,150);geo.rotateX(-Math.PI/2);
      landscape.base=Float32Array.from(geo.attributes.position.array);
      landscape.mesh=new THREE.Mesh(geo,new THREE.MeshBasicMaterial({color:ACID,wireframe:true,transparent:true,opacity:.88}));
      landscape.mesh.position.z=-28;landscape.scene.add(landscape.mesh);
    }
    function addGenesisObject(id){
      const n=landscape.objects[id].length,seed=n+1;
      let obj;
      if(id==='orb'){
        obj=new THREE.Mesh(new THREE.IcosahedronGeometry(1.55+Math.min(n,.9)*.22,2),new THREE.MeshBasicMaterial({color:ACID,wireframe:true,transparent:true,opacity:.9}));
        obj.position.set(-7+(n%5)*3.3,2.8+(n%3)*1.25,-17-(n%6)*5);
      }else if(id==='totem'){
        obj=new THREE.Mesh(new THREE.CylinderGeometry(.45,.95,6.5,5+(n%4),6,true),new THREE.MeshBasicMaterial({color:ACID,wireframe:true,transparent:true,opacity:.84}));
        obj.position.set(7-(n%5)*3.1,.5,-20-(n%6)*5.5);
      }else if(['phone','diamond','cola','pistol'].includes(id)){
        const group=new THREE.Group(),mat=new THREE.MeshBasicMaterial({color:ACID,wireframe:true,transparent:true,opacity:.92});
        if(id==='phone'){
          group.add(new THREE.Mesh(new THREE.BoxGeometry(2.2,4.2,.35),mat));
          const screen=new THREE.Mesh(new THREE.PlaneGeometry(1.75,3.35),mat);screen.position.z=.19;group.add(screen);
        }else if(id==='diamond'){
          const top=new THREE.Mesh(new THREE.CylinderGeometry(1.8,1.05,1.1,8),mat);top.position.y=.55;group.add(top);
          const tip=new THREE.Mesh(new THREE.ConeGeometry(1.05,2.2,8),mat);tip.position.y=-1.1;tip.rotation.x=Math.PI;group.add(tip);
        }else if(id==='cola'){
          const body=new THREE.Mesh(new THREE.CylinderGeometry(.72,.82,3.8,14,5),mat);group.add(body);
          const neck=new THREE.Mesh(new THREE.CylinderGeometry(.38,.62,.9,12),mat);neck.position.y=2.25;group.add(neck);
          const cap=new THREE.Mesh(new THREE.CylinderGeometry(.42,.42,.18,12),mat);cap.position.y=2.78;group.add(cap);
        }else{
          const slide=new THREE.Mesh(new THREE.BoxGeometry(3.6,.65,.75),mat);slide.position.x=.5;group.add(slide);
          const grip=new THREE.Mesh(new THREE.BoxGeometry(.8,2,.7),mat);grip.position.set(.15,-1.15,0);grip.rotation.z=-.18;group.add(grip);
        }
        obj=group;obj.position.set((Math.random()-.5)*30,1.5+Math.random()*8,-7-Math.random()*55);
      }else if(id==='tree'){
        const group=new THREE.Group(),trunkMat=new THREE.LineBasicMaterial({color:ACID,transparent:true,opacity:.88});
        const h=4.5+Math.random()*5,branches=5+Math.floor(Math.random()*5);
        const trunkGeo=new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0,0,0),new THREE.Vector3(0,h,0)]);
        group.add(new THREE.Line(trunkGeo,trunkMat));
        for(let b=0;b<branches;b++){
          const y=h*(.38+b/(branches+2)*.55),a=Math.random()*Math.PI*2,len=1.3+Math.random()*2.8;
          const tip=new THREE.Vector3(Math.cos(a)*len,y+.5+Math.random()*1.8,Math.sin(a)*len);
          group.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(0,y,0),tip]),trunkMat));
          const twig=tip.clone().add(new THREE.Vector3(Math.cos(a+.8)*len*.45,.6+Math.random(),Math.sin(a+.8)*len*.45));
          group.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints([tip,twig]),trunkMat));
        }
        obj=group;obj.position.set((Math.random()-.5)*34, -1.2, -8-Math.random()*70);
      }else if(id==='swarm'){
        const count=260,geo=new THREE.BufferGeometry(),p=new Float32Array(count*3);
        for(let i=0;i<count;i++){const k=i*3;p[k]=(Math.random()-.5)*10;p[k+1]=(Math.random()-.5)*6;p[k+2]=(Math.random()-.5)*12}
        geo.setAttribute('position',new THREE.BufferAttribute(p,3));
        obj=new THREE.Points(geo,new THREE.PointsMaterial({color:ACID,size:.07,transparent:true,opacity:.78}));
        obj.position.set((n%5-2)*4,3+(n%3),-18-(n%5)*7);
      }else return;
      obj.userData={kind:id,seed,baseX:obj.position.x,baseY:obj.position.y,baseZ:obj.position.z,spawn:performance.now(),growth:id==='tree'?0:1};
      if(id==='tree')obj.scale.set(.015,.015,.015);
      if(['phone','diamond','cola','pistol'].includes(id)){
        obj.traverse(ch=>{if(ch.material?.color)ch.material.color.setHex(MAGENTA)});
        landscape.flash=1;
      }
      landscape.objects[id].push(obj);landscape.scene.add(obj);incrementCapital(id);
      status.textContent='ADD '+id.toUpperCase()+' · '+landscape.objects[id].length;
    }
    s0.init({src:landscapeCanvas});
    typeCanvas.width=1280;typeCanvas.height=720;s2.init({src:typeCanvas});
    async function ensureHandTracking(){
      if(handLandmarker||handTrackingLoading)return;
      handTrackingLoading=true;
      try{
        const {FilesetResolver,HandLandmarker}=await import('@mediapipe/tasks-vision');
        const vision=await FilesetResolver.forVisionTasks('/mediapipe/wasm');
        handLandmarker=await HandLandmarker.createFromOptions(vision,{baseOptions:{modelAssetPath:'/mediapipe/hand_landmarker.task'},runningMode:'VIDEO',numHands:2,minHandDetectionConfidence:.55,minTrackingConfidence:.5,minHandPresenceConfidence:.5});
        status.textContent='WEBCAM + HANDS · ONLINE';
      }catch(err){status.textContent='HAND TRACK ERROR · '+err.message;status.classList.add('error')}
      handTrackingLoading=false;
    }
    function spawnHeartBurst(x,y,count=14){
      for(let i=0;i<count;i++)hearts.push({x:x+(Math.random()-.5)*35,y:y+(Math.random()-.5)*25,vx:(Math.random()-.5)*3.8,vy:-2-Math.random()*4.5,life:1,size:34+Math.random()*54,spin:(Math.random()-.5)*.08,rot:0,emoji:['💗','💕','💖','💞'][Math.floor(Math.random()*4)]});
      status.textContent='🫶 HEART BURST';
    }
    async function trackHands(){
      if(!handLandmarker||!webcamReady||currentScene!=='hypnosis'||webcamVideo.readyState<2)return;
      const now=performance.now();if(now-lastHandTrack<55)return;lastHandTrack=now;
      try{
        const r=handLandmarker.detectForVideo(webcamVideo,now),hands=r.landmarks||[];
        if(hands.length<2){heartGesture=false;heartHold=0;handDebug='HANDS · '+hands.length;status.textContent=handDebug;return}
        const a=hands[0],b=hands[1],dist=(p,q)=>Math.hypot(p.x-q.x,p.y-q.y);
        const palmA=Math.max(.04,dist(a[0],a[9])),palmB=Math.max(.04,dist(b[0],b[9])),handScale=(palmA+palmB)*.5;
        const thumbD=dist(a[4],b[4]),indexD=dist(a[8],b[8]),centerD=dist(a[9],b[9]);
        // Deliberately generous for live performance: accept fingertips that nearly touch,
        // normalized to the actual hand size/distance from camera.
        const thumbClose=thumbD<Math.max(.18,handScale*1.65);
        const indexClose=indexD<Math.max(.18,handScale*1.65);
        const handsTogether=centerD<Math.max(.62,handScale*5.2);
        // A natural two-hand heart varies a lot: either the two thumb tips or the two
        // index tips may not literally touch. Require two hands close + one fingertip pair,
        // and show the live distances so we can tune this to the performer's actual gesture.
        const heartNow=handsTogether&&((thumbClose&&indexClose)||(thumbD<Math.max(.24,handScale*2.2)&&indexD<Math.max(.30,handScale*2.8)));
        const cx=(2-a[4].x-b[4].x-a[8].x-b[8].x)/4*typeCanvas.width,cy=(a[4].y+b[4].y+a[8].y+b[8].y)/4*typeCanvas.height;
        handDebug='HANDS 2 · T '+thumbD.toFixed(2)+' · I '+indexD.toFixed(2)+(heartNow?' · 🫶':'');
        status.textContent=handDebug;
        if(heartNow&&!heartGesture){spawnHeartBurst(cx,cy,18);heartGesture=true;heartHold=now}
        else if(heartNow&&now-heartHold>700){spawnHeartBurst(cx,cy,3);heartHold=now}
        else if(!heartNow){heartGesture=false;heartHold=0}
      }catch{}
    }
    async function trackFace(){
      if(!webcamReady||currentScene!=='hypnosis')return;
      const now=performance.now();if(now-faceMotion.last<55)return;faceMotion.last=now;
      if(!faceDetector&&'FaceDetector' in window){try{faceDetector=new FaceDetector({fastMode:true,maxDetectedFaces:1});trackingMode='face'}catch{}}
      let tx=null,ty=null,ts=null,velocityBoost=0;
      if(faceDetector){
        try{
          const faces=await faceDetector.detect(webcamVideo);
          if(faces.length){const b=faces[0].boundingBox,vw=webcamVideo.videoWidth||1280,vh=webcamVideo.videoHeight||720;tx=1-(b.x+b.width/2)/vw;ty=(b.y+b.height/2)/vh;ts=b.width/vw}
        }catch{faceDetector=null;trackingMode='motion'}
      }
      if(tx===null){
        try{
          motionCtx.save();motionCtx.scale(-1,1);motionCtx.drawImage(webcamVideo,-160,0,160,90);motionCtx.restore();
          const data=motionCtx.getImageData(0,0,160,90).data,gray=new Uint8Array(160*90);
          let sx=0,sy=0,weight=0,active=0,minX=160,maxX=0,minY=90,maxY=0;
          for(let i=0;i<gray.length;i++){
            const k=i*4,g=(data[k]*3+data[k+1]*6+data[k+2])*.1;gray[i]=g;
            if(motionPrev){const d=Math.abs(g-motionPrev[i]);if(d>18){const x=i%160,y=(i/160)|0,w=d-18;sx+=x*w;sy+=y*w;weight+=w;active++;if(x<minX)minX=x;if(x>maxX)maxX=x;if(y<minY)minY=y;if(y>maxY)maxY=y}}
          }
          motionPrev=gray;
          if(weight>900&&active>18){tx=sx/weight/160;ty=sy/weight/90;const spread=Math.max((maxX-minX)/160,(maxY-minY)/90);ts=Math.max(.16,Math.min(.62,spread*.75));velocityBoost=Math.min(1,active/900);trackingMode='motion'}
        }catch{}
      }
      if(tx!==null){
        faceMotion.x+=(tx-faceMotion.x)*.38;faceMotion.y+=(ty-faceMotion.y)*.38;if(ts!==null)faceMotion.size+=(ts-faceMotion.size)*.18;
        const dx=faceMotion.x-faceMotion.px,dy=faceMotion.y-faceMotion.py,ds=faceMotion.size-faceMotion.ps;
        faceMotion.v=Math.min(1,Math.hypot(dx,dy)*10+Math.abs(ds)*8+velocityBoost*.45);
        faceMotion.px=faceMotion.x;faceMotion.py=faceMotion.y;faceMotion.ps=faceMotion.size;
      }else faceMotion.v*=.88;
    }
    function drawHypnosisType(){
      requestAnimationFrame(drawHypnosisType);
      typeCtx.clearRect(0,0,typeCanvas.width,typeCanvas.height);
      typeCtx.fillStyle='#000';typeCtx.fillRect(0,0,typeCanvas.width,typeCanvas.height);
      trackFace();trackHands();
      const lo=low(),mi=mid(),hi=high(),f=faceMotion;
      const cx=f.x*typeCanvas.width,cy=f.y*typeCanvas.height;
      const proximity=Math.max(.65,Math.min(2.4,f.size/.28));
      typeCtx.save();typeCtx.translate(cx,cy);
      typeCtx.scale(proximity*(1+lo*.28),proximity*(1+mi*.12));
      typeCtx.textAlign='center';typeCtx.textBaseline='middle';
      typeCtx.font='300 19px Helvetica,Arial,sans-serif';typeCtx.fillStyle='#fff';
      const melt=(f.v*1.8+hi*.65+mi*.22),t=performance.now()*.001;
      const rows=17,cols=7,stepX=82,stepY=25;
      for(let row=-8;row<=8;row++){
        for(let col=-3;col<=3;col++){
          const phase=row*1.37+col*.83;
          const baseFloatX=Math.sin(t*.72+phase)*12+Math.cos(t*.31+row)*5;
          const baseFloatY=Math.cos(t*.58+phase)*7+Math.sin(t*.27+col)*4;
          const driftX=baseFloatX+Math.sin(t*2+phase)*melt*(7+Math.abs(row)*2);
          const driftY=baseFloatY+Math.abs(row)*melt*3.5;
          const width=.58+((Math.sin(phase*2.1)+1)*.5)*.92;
          const breathe=1+Math.sin(t*.45+phase)*.07;
          typeCtx.save();
          typeCtx.translate(col*stepX+driftX,row*stepY+driftY);
          typeCtx.scale(width*breathe,1);
          typeCtx.globalAlpha=Math.max(.14,.72-Math.abs(row)*.042-Math.abs(col)*.045);
          typeCtx.fillText(hypnosisWord,0,0);
          typeCtx.restore();
        }
      }
      for(let i=1;i<=5;i++){
        const yy=145+i*14*(1+melt*2.4),xx=Math.sin(performance.now()*.002+i)*melt*26;
        typeCtx.globalAlpha=Math.max(.04,.22-i*.032)*Math.min(1,melt*1.8);
        typeCtx.fillText(hypnosisWord,xx,yy);
      }
      typeCtx.restore();
      for(let i=hearts.length-1;i>=0;i--){
        const h=hearts[i];h.x+=h.vx*(1+mi*.8);h.y+=h.vy*(1+lo*.65);h.vy+=.025;h.vx+=Math.sin(performance.now()*.004+i)*hi*.035;h.life-=.009;h.rot+=h.spin;
        if(h.life<=0||h.y<-100){hearts.splice(i,1);continue}
        typeCtx.save();typeCtx.translate(h.x,h.y);typeCtx.rotate(h.rot);typeCtx.globalAlpha=Math.max(0,h.life);typeCtx.font=(h.size*(1+lo*.55))+'px Helvetica,Arial,sans-serif';typeCtx.textAlign='center';typeCtx.fillText(h.emoji,0,0);typeCtx.restore();
      }
    }
    drawHypnosisType();
    async function ensureWebcam(){
      if(webcamReady)return true;
      try{
        const stream=await navigator.mediaDevices.getUserMedia({video:{width:{ideal:1280},height:{ideal:720}},audio:false});
        webcamVideo.srcObject=stream;await webcamVideo.play();s1.init({src:webcamVideo});webcamReady=true;
        trackingMode=('FaceDetector' in window)?'face':'motion';status.textContent='WEBCAM + '+trackingMode.toUpperCase()+' TRACK · ONLINE';ensureHandTracking();return true;
      }catch(err){status.textContent='WEBCAM ERROR · '+err.message;status.classList.add('error');return false}
    }
    let landscapeT=0;
    function renderLandscape(){
      requestAnimationFrame(renderLandscape);
      landscapeT+=.006;
      const pos=landscape.mesh.geometry.attributes.position;
      const base=landscape.base;
      const lo=low(),mi=mid(),hi=high();
      landscape.flash*=.88;
      for(let i=0;i<pos.count;i++){
        const k=i*3,x=base[k],z=base[k+2];
        const ridge=Math.sin(x*.28+landscapeT*.45)*1.05+Math.sin(z*.12-landscapeT*.7)*.72;
        const detail=Math.sin(x*.92+z*.19+landscapeT*1.7)*(.12+hi*.55);
        const swell=Math.sin(z*.055+landscapeT*.35)*(.55+lo*2.8);
        pos.setY(i,-1.45+ridge*.52+swell+detail+Math.sin((x+z)*.11+landscapeT)*mi*.9);
      }
      pos.needsUpdate=true;
      landscape.mesh.position.z=-28+(landscapeT*1.35%3.2);
      landscape.camera.position.x=landscape.nav.x+Math.sin(landscapeT*.13)*.35;
      landscape.camera.position.z=10+landscape.nav.z;
      landscape.camera.position.y=4.6+lo*.8;
      landscape.camera.lookAt(landscape.camera.position.x-Math.sin(landscape.nav.yaw)*24,-1,landscape.camera.position.z-Math.cos(landscape.nav.yaw)*24);
      landscape.objects.orb.forEach((obj,i)=>{
        const u=obj.userData,s=u.seed;
        obj.rotation.x+=.002+hi*(.012+s*.0015);obj.rotation.y+=.003+mi*(.018+s*.001);
        const pulse=1+lo*(.45+(i%3)*.12)+Math.sin(landscapeT*(.55+s*.04)+s)*.08;
        obj.scale.setScalar(pulse);
        obj.position.y=u.baseY+Math.sin(landscapeT*(.7+s*.05)+s)*.55+lo*(.65+s*.08);
        obj.position.x=u.baseX+Math.sin(landscapeT*.23+s)*mi*1.2;
      });
      landscape.objects.totem.forEach((obj,i)=>{
        const u=obj.userData,s=u.seed;
        obj.rotation.y+=.0015+mi*(.008+s*.0008);
        obj.rotation.z=Math.sin(landscapeT*.35+s)*(.025+hi*.08);
        obj.scale.y=1+lo*(.35+(i%4)*.1);
        obj.scale.x=obj.scale.z=1+hi*.12;
        obj.position.y=u.baseY+lo*(.8+s*.06);
      });
      ['phone','diamond','cola','pistol'].forEach(kind=>landscape.objects[kind].forEach((obj,i)=>{
        const u=obj.userData,s=u.seed,beat=lo*.9+mi*.45,age=(performance.now()-u.spawn)/1000;
        obj.rotation.x+=.004+hi*(.025+s*.001);obj.rotation.y+=.006+mi*(.035+s*.0015);obj.rotation.z+=.002+hi*.018;
        const bounce=Math.abs(Math.sin(landscapeT*(1.8+s*.11)+s))*(.45+beat*2.8);
        obj.position.y=u.baseY+bounce+lo*(1.1+(i%3)*.3);
        obj.position.x=u.baseX+Math.sin(landscapeT*(.7+s*.06)+s)*(1+mi*2.2);
        obj.position.z=u.baseZ+Math.cos(landscapeT*(.45+s*.04)+s)*(.6+hi*1.8);
        const pop=1+lo*.65+mi*.22+hi*.18+Math.max(0,.7-age)*.45;obj.scale.setScalar(pop);
        const magentaMix=Math.max(0,1-age/1.35);
        obj.traverse(ch=>{if(ch.material?.color)ch.material.color.setHex(magentaMix>.08?MAGENTA:ACID)});
      }));
      landscape.objects.tree.forEach((obj,i)=>{
        const u=obj.userData,s=u.seed,age=(performance.now()-u.spawn)/1000;
        // Each planted tree grows over several seconds; LOW/MID act like fertilizer,
        // so louder music visibly accelerates and exaggerates the growth.
        const growthDrive=.0022+lo*.012+mi*.0045;
        u.growth=Math.min(1,u.growth+growthDrive);
        const ease=1-Math.pow(1-u.growth,3);
        const pulse=1+lo*(.20+(i%4)*.035)+mi*.055;
        const width=Math.max(.015,ease*(.72+lo*.16));
        const height=Math.max(.015,ease*pulse);
        obj.scale.set(width,height,width);
        obj.rotation.y=Math.sin(landscapeT*.18+s)*(.06+mi*.08);
        obj.rotation.z=Math.sin(landscapeT*.35+s)*(.012+hi*.045);
        obj.position.y=u.baseY+Math.sin(landscapeT*.3+s)*hi*.08;
        // Fresh trees briefly bloom magenta, then settle into acid green.
        const newborn=Math.max(0,1-age/1.1);
        obj.traverse(ch=>{if(ch.material?.color)ch.material.color.setHex(newborn>.06?MAGENTA:ACID)});
      });
      landscape.objects.swarm.forEach((obj,i)=>{
        const u=obj.userData,s=u.seed,sp=obj.geometry.attributes.position;
        for(let j=0;j<sp.count;j++){const k=j*3;sp.array[k+1]+=Math.sin(landscapeT*(1.5+s*.05)+j*.17)*(.0007+hi*.006);sp.array[k]+=Math.sin(landscapeT+j*.11+s)*mi*.002}
        sp.needsUpdate=true;obj.rotation.y+=.0004+mi*.0025;obj.rotation.x=Math.sin(landscapeT*.22+s)*.06;
        const burst=1+lo*.35;obj.scale.setScalar(burst);
        obj.position.y=u.baseY+Math.sin(landscapeT*.45+s)*.35+hi*.4;
      });
      landscape.renderer.render(landscape.scene,landscape.camera);
    }
    renderLandscape();

    const starter=`voronoi(350, .15)
  .modulateScale(
    osc(8, .08, 0).rotate(() => Math.sin(time)),
    () => .42 + low() * .75
  )
  .thresh(() => .82 - low() * .16)
  .modulateRotate(
    osc(() => 6.5 + mid() * 5),
    () => .30 + mid() * .75
  )
  .thresh(() => .72 - mid() * .10)
  .diff(src(o0).scale(() => 1.76 + low() * .16))
  .modulateScale(
    osc(() => 2 + high() * 8).modulateRotate(o0, .74),
    () => .08 + high() * .30
  )
  .diff(
    src(o0)
      .rotate([-.012, .01, -.002, 0])
      .scrollY(0, [-1/199800, 0].fast(.7))
  )
  .brightness(() => -.06 - high() * .12)
  .out(o0)

render(o0)`;

    window.genesisFlash=()=>landscape.flash;
    window.faceX=()=>faceMotion.x-.5;window.faceY=()=>faceMotion.y-.5;window.faceSize=()=>faceMotion.size;window.faceVelocity=()=>faceMotion.v;window.hypnosisDrop=()=>hypnosisDrop;

    const hypnosisWebcam=`src(s1)
  .scale(() => 1.01 + low() * .035 + faceSize()*.06)
  .scrollX(() => faceX()*.08)
  .scrollY(() => -faceY()*.06)
  .contrast(() => 1.28 + mid() * .7)
  .saturate(0)
  .color(.22,1,.08)
  .modulate(
    osc(() => 5 + high() * 18 + hypnosisDrop()*42,.02,0).rotate(Math.PI/2),
    () => .004 + mid() * .045 + hypnosisDrop()*.16
  )
  .modulatePixelate(
    noise(() => 2 + hypnosisDrop()*18,.12),
    () => 180 - hypnosisDrop()*166,
    () => 120 - hypnosisDrop()*110
  )
  .diff(
    src(s1)
      .scrollX(() => Math.sin(time*1.7) * high() * .055)
      .scrollY(() => Math.cos(time*1.2) * mid() * .035)
      .scale(() => 1.002 + low() * .018)
      .saturate(0)
      .color(1,.10,.72)
      .luma(() => .42 - high()*.16)
  )
  .layer(
    src(s2)
      .luma(.35)
      .color(1,.10,.72)
      .mult(src(s1).saturate(0).contrast(1.5))
      .scale(() => 1 + low()*.08 + faceSize()*.16)
      .scrollX(() => faceX()*.14)
      .scrollY(() => -faceY()*.12)
  )
  .blend(
    src(o0)
      .scale(() => 1.004 + low()*.012)
      .scrollX(() => Math.sin(time*.7)*mid()*.008),
    () => .08 + high()*.16 + faceVelocity()*.34
  )
  .out(o0)

render(o0)`;

    const genesisLandscape=`src(s0)
  .contrast(() => 1.22 + low() * .62)
  .brightness(() => -.16 + high() * .14)
  .color(0.22,1.0,0.08)
  .modulate(
    noise(() => 1.05 + mid() * 2.2, .035),
    () => .010 + mid() * .06
  )
  .layer(
    src(s0)
      .scale(() => 1.002 + low() * .014)
      .luma(() => .38 - high() * .10)
      .color(0.22,1.0,0.08)
      .brightness(() => -.12 + high() * .22)
  )
  .layer(
    src(s0)
      .luma(() => .76 - high() * .12)
      .color(1.0,.10,.72)
      .brightness(() => -.42 + high() * .28)
  )
  .blend(src(o0).scale(() => 1.001 + low() * .002), () => .025 + low() * .035)
  .layer(
    solid(1,.10,.72,1)
      .brightness(() => -.42 + genesisFlash() * .55)
      .luma(() => .78 - genesisFlash() * .7)
  )
  .out(o0)

render(o0)`;

    // Scene deck structure. CUSTOM 01 stays untouched; GENESIS is the first new authored scene.
    // The other slots are placeholders to be rewritten together later.
    const scenes={
      custom01:{label:'CUSTOM 01 · CORRUPTED',code:starter},
      genesis:{label:'GENESIS · 3D LANDSCAPE',code:genesisLandscape},
      hypnosis:{label:'HYPNOSIS · WEBCAM / TYPE',code:hypnosisWebcam},
      resonance:{label:'RESONANCE · TODO',code:null},
      farewell:{label:'FAREWELL · TODO',code:null}
    };
    let currentScene='custom01';
    code.value=scenes[currentScene].code;
    const history=[];
    let lastRun=code.value;

    function run(){
      if(code.value!==lastRun){
        history.push(lastRun);
        if(history.length>50) history.shift();
      }
      try{
        (0,eval)(code.value);
        lastRun=code.value;
        status.textContent='RUNNING · '+new Date().toLocaleTimeString();
        status.classList.remove('error');
      }catch(err){
        status.textContent='ERROR · '+err.message;
        status.classList.add('error');
      }
    }
    run();

    async function loadScene(id){
      const scene=scenes[id];
      if(!scene)return;
      currentScene=id;
      if(id==='hypnosis'&&!(await ensureWebcam()))return;
      capitalCounter.style.display=id==='genesis'?'block':'none';
      sceneTag.textContent='HYDRA · '+scene.label;
      if(!scene.code){
        status.textContent=scene.label+' · EMPTY SLOT';
        status.classList.remove('error');
        return;
      }
      if(scene.code!==lastRun){history.push(lastRun);if(history.length>50)history.shift()}
      code.value=scene.code;
      run();
    }
    function setHypnosisWord(word){hypnosisWord=String(word||'I AM').toUpperCase().slice(0,18);status.textContent='TYPE · '+hypnosisWord}
    function addGenesisFromRegia(id){addGenesisObject(id)}
    function addForestBurst(count=6){for(let i=0;i<count;i++)addGenesisObject('tree')}
    function moveGenesisCamera(key){
      const nav=landscape.nav,step=1.5,turn=.09;
      if(key==='ArrowLeft')nav.yaw-=turn;if(key==='ArrowRight')nav.yaw+=turn;
      if(key==='ArrowUp'){nav.x-=Math.sin(nav.yaw)*step;nav.z-=Math.cos(nav.yaw)*step}
      if(key==='ArrowDown'){nav.x+=Math.sin(nav.yaw)*step;nav.z+=Math.cos(nav.yaw)*step}
      landscape.camera.position.x=nav.x;landscape.camera.position.z=10+nav.z;
    }
    function cleanHydra(){
      try{solid(0,0,0,1).out(o0);render(o0);status.textContent='CLEAN';sceneTag.textContent='HYDRA · CLEAN'}catch(err){status.textContent='ERROR · '+err.message}
    }
    function blackoutHydra(){
      try{
        solid(0,0,0,1).out(o0);solid(0,0,0,1).out(o1);solid(0,0,0,1).out(o2);solid(0,0,0,1).out(o3);
        render(o0);status.textContent='BLACK OUT';sceneTag.textContent='HYDRA · BLACK OUT';
      }catch(err){status.textContent='ERROR · '+err.message}
    }
    function back(){
      if(!history.length){
        status.textContent='BACK · NO PREVIOUS PATCH';
        return;
      }
      const previous=history.pop();
      code.value=previous;
      try{
        (0,eval)(previous);
        lastRun=previous;
        status.textContent='BACK · '+new Date().toLocaleTimeString();
        status.classList.remove('error');
      }catch(err){
        status.textContent='ERROR · '+err.message;
        status.classList.add('error');
      }
    }

    const handleRegia=m=>{
      m=m||{};
      if(m.type==='hydra-scene')loadScene(m.scene);
      if(m.type==='hydra-hypnosis-word')setHypnosisWord(m.word);
      if(m.type==='hydra-clean')cleanHydra();
      if(m.type==='hydra-object-add')addGenesisFromRegia(m.object);
      if(m.type==='hydra-forest-burst')addForestBurst(m.count||6);
      if(m.type==='hydra-blackout')blackoutHydra();
      if(m.type==='hydra-back')back();
      if(m.type==='hydra-editor')toggleEditor()
    };
    const regiaChannel=new BroadcastChannel('elisa-regia');
    regiaChannel.onmessage=e=>handleRegia(e.data);
    addEventListener('storage',e=>{if(e.key==='elisa-regia-command'&&e.newValue){try{handleRegia(JSON.parse(e.newValue).message)}catch{}}});

    editorToggle.addEventListener('click',toggleEditor);
    window.addEventListener('keydown',(e)=>{
      if(e.code==='Space'&&document.activeElement!==code&&currentScene==='hypnosis'){e.preventDefault();hypnosisDrop=1;status.textContent='DROP · DISINTEGRATE'}
      if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key)&&document.activeElement!==code){e.preventDefault();moveGenesisCamera(e.key)}
      if(e.ctrlKey&&e.key.toLowerCase()==='e'){e.preventDefault();toggleEditor()}
      if(e.ctrlKey&&e.key==='Enter'){e.preventDefault();run()}
      if(e.ctrlKey&&e.key.toLowerCase()==='z'){e.preventDefault();back()}
      if(e.ctrlKey&&e.key.toLowerCase()==='l'&&document.activeElement===code){e.preventDefault();code.value=''}
    });
    window.addEventListener('keyup',(e)=>{if(e.code==='Space'&&currentScene==='hypnosis')hypnosisDrop=0});
    addEventListener('resize',()=>{
      hydra.synth.setResolution(innerWidth,innerHeight);
      landscape.camera.aspect=innerWidth/innerHeight;landscape.camera.updateProjectionMatrix();
      landscape.renderer.setSize(innerWidth,innerHeight,false);
    });
  </script>
</body>
</html>
