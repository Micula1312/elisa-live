          star.position.y+=u.vy*(1+energy*2);
          star.rotation.y+=u.spin;star.rotation.z+=u.spin*.7;
          star.scale.setScalar(u.baseSize*(.75+Math.sin(age*Math.PI)*.7));
          star.material.opacity=Math.min(1,(1-age)*1.3);
        }
      }else if(farewellStars.length)clearFarewellStars();
      landscape.renderer.render(landscape.scene,landscape.camera);
    }
    renderLandscape();

    const starter=`// PERFORMANCE ARC
// CC16: GLITCH -> PARTICLES -> FLUID
// CC17: B/W -> ACID GREEN
voronoi(
    () => 350 - deform() * 315,
    () => .15 - deform() * .105
  )
  .modulateScale(
    osc(
      () => 8 - deform() * 6.2,
      () => .08 - deform() * .055,
      0
    ).rotate(() => Math.sin(time * (1 - deform()*.72))),
    () => (.42 + low()*.75) * (1 - deform()*.72) + deform()*.055
  )
  .thresh(() => .82 - low()*.16 - deform()*.22)
  .modulateRotate(
    osc(() => 6.5 + mid()*5 - deform()*4.8),
    () => (.30 + mid()*.75) * (1 - deform()*.78)
  )
  .thresh(() => .72 - mid()*.10 - deform()*.20)
  .diff(
    src(o0).scale(() => 1.76 + low()*.16 - deform()*.72)
  )
  .modulateScale(
    noise(
      () => 2.2 - deform()*1.45,
      () => .08 + deform()*.09
    ),
    () => (.08 + high()*.30)*(1-deform()*.62) + deform()*.085
  )
  // As CC16 opens, hard cells dissolve into a slower continuous flow.
  .modulate(
    noise(
      () => 1.8 - deform()*.95,
      () => .035 + deform()*.025
    ),
    () => deform() * (.035 + low()*.055 + mid()*.025)
  )
  .diff(
    src(o0)
      .scale(() => 1.002 + deform()*.012)
      .rotate(() => -.012 * (1-deform()))
      .scrollY(0, () => -1/199800 * (1-deform()))
  )
  // CC17 / feedback() is the forest premonition:
  // 0 = pure B/W, 1 = B/W + acid-green signal.
  .color(
    () => 1 - feedback()*.78,
    1,
    () => 1 - feedback()*.92
  )
  // Keep the forest cue mostly monochrome until the second half of CC17.
  .saturate(() => 1 + Math.pow(feedback(),1.7)*2.15)
  .brightness(() => -.06 - high()*.12 + deform()*.035)
  .out(o0)

render(o0)`;

    window.genesisFlash=()=>landscape.flash;
    window.faceX=()=>faceMotion.x-.5;window.faceY=()=>faceMotion.y-.5;window.faceSize=()=>faceMotion.size;window.faceVelocity=()=>faceMotion.v;window.hypnosisDrop=()=>hypnosisDrop;

    const hypnosisWebcam=`src(s1)
  .scale(() => 1.01 + low()*.028 + faceSize()*.045 + param1()*.035)
  .scrollX(() => faceX()*.065)
  .scrollY(() => -faceY()*.05)
  .saturate(0)
  .contrast(() => 1.18 + mid()*.42)
  .color(.22,1,.08)
  .modulate(
    osc(() => 4 + high()*10 + hypnosisDrop()*24,.018,0).rotate(Math.PI/2),
    () => .003 + mid()*.022 + hypnosisDrop()*.10 + param1()*.035
  )
  .layer(
    src(s2)
      .luma(.30)
      .color(1,.035,.0)
      .scale(() => 1 + low()*.05 + faceSize()*.10)
      .scrollX(() => faceX()*.10)
      .scrollY(() => -faceY()*.08)
  )
  .blend(
    src(o0).scale(() => 1.002 + low()*.006),
    () => .035 + high()*.07 + faceVelocity()*.12 + param2()*.12
  )
  .out(o0)
render(o0)`;

    const genesisLandscape=`src(s0)
  .scale(() => 1 + param1()*.085)
  .contrast(() => 1.22 + low() * .62 + param1()*.38)
  .brightness(() => -.16 + high() * .14 + param2()*.08)
  .color(0.22,1.0,0.08)
  .modulate(
    noise(() => 1.05 + mid() * 2.2 + param1()*3.4, () => .035 + param2()*.07),
    () => .010 + mid() * .06 + param1()*.075
  )
  .layer(
    src(s0)
      .scale(() => 1.002 + low() * .014)
      .luma(() => .38 - high() * .10)
      .color(0.22,1.0,0.08)
      .brightness(() => -.12 + high() * .22)
  )
  .layer(
    src(s0)
      .luma(() => .76 - high() * .12)
      .color(1.0,.035,.0)
      .brightness(() => -.42 + high() * .28)
  )
  .blend(src(o0).scale(() => 1.001 + low() * .002 + param2()*.018), () => .025 + low() * .035 + param2()*.24)
  .layer(
    solid(1,.10,.72,1)
      .brightness(() => -.42 + genesisFlash() * .55)
      .luma(() => .78 - genesisFlash() * .7)
  )
  .layer(
    src(s3)
      .luma(.035)
      .scale(() => 1 + low()*.10*audioReact() + mid()*.045)
      .modulate(
        noise(() => 1.1 + mid()*3.8 + audioChaos()*4,.02),
        () => .006 + high()*.065*audioReact() + audioChaos()*.075
      )
  )
  // Re-layer the 3D world with the same live processing as the archive.
  // CC16: displacement; CC17: feedback; CC18/19: audio reaction and chaos.
  .layer(
    src(s0)
      .luma(.16)
      .modulate(
        noise(() => 1.3 + mid()*2.8 + param1()*4 + audioChaos()*3,.025),
        () => .004 + param1()*.075 + high()*audioReact()*.04 + audioChaos()*.06
      )
      .scale(() => 1 + low()*audioReact()*.015 + param2()*.035)
      .contrast(() => 1.08 + high()*.32 + param1()*.28)
      .brightness(() => -.08 + hit()*audioReact()*.11)
      .color(() => .22 + param2()*.65,1,() => .08 + audioChaos()*.18)
  )
  .out(o0)

render(o0)`;

    // RESONANCE — Ritchse "trying to get closer" (CC BY-NC-SA 4.0), adapted.
    // Lime-green base + blurred cyan; fire red enters via CC16.
    // CC16 audio-hit invert drive + red, CC17 liquid, CC18 audio, CC19 chaos/webcam.
    let resonancePulse=0,resonanceLastTick=performance.now();
    const resonanceBeat=()=>{
      const now=performance.now(),dt=Math.min(.08,(now-resonanceLastTick)/1000);
      resonanceLastTick=now;
      resonancePulse=Math.max(hit()*audioReact(),resonancePulse*Math.exp(-dt*5.5));
      return resonancePulse;
    };
    const resonanceGradient=`osc(
  () => 60 + param2()*20 + high()*16*audioReact(),
  () => -.015 + mid()*.04*audioReact(),
  () => .3 + param2()*.4 + resonanceBeat()*.12
)
.diff(
  osc(() => 60 + param2()*25, () => .08 + high()*.02*audioReact())
    .rotate(() => Math.PI/2 + mid()*.24*audioReact())
)
.modulateScale(
  noise(() => 3.5 + param2()*5 + mid()*2.5*audioReact(),
        () => .25 + audioChaos()*.25)
    .modulateScale(osc(() => 15 + param2()*16)
      .rotate(() => Math.sin(time/2 + mid()*audioReact()))),
  () => .48 + param2()*.42 + low()*.55*audioReact() + resonancePulse*.18
)
.color(.18,1,.035)
.contrast(() => 1.32 + high()*.25*audioReact())
.add(
  src(o0).modulate(o0, () => .025 + audioChaos()*.06),
  () => .34 + low()*.12*audioReact()
)
.modulateScale(osc(() => 2 + mid()*2*audioReact()),
  () => -.16 - param2()*.2 - audioChaos()*.16)
.layer(
  noise(() => 2.1 + mid()*1.5*audioReact(),.06)
    .color(.015,.58,1)
    .luma(() => .46 + param2()*.14)
    .modulate(noise(1.1,.025), () => .035 + param2()*.08)
    .mult(solid(1,1,1,() => .16 + low()*.13*audioReact()))
)
.blend(
  osc(() => 12 + high()*15*audioReact(),.012,.2)
    .color(1,.035,0)
    .modulate(noise(() => 2 + audioChaos()*3,.04),
      () => .06 + audioChaos()*.12 + resonancePulse*.08),
  () => Math.min(.65,param1()*.52 + resonancePulse*param1()*.13)
)
.blend(
  src(s1)
    .scale(() => 1.12 + param2()*.22)
    .saturate(0)
    .contrast(() => 1.6 + param1()*.8)
    .color(.22,1,.07)
    .modulate(noise(() => 2 + audioChaos()*4,.035), () => .015 + param2()*.11),
  () => window.ELISA_CTRL.resonanceCam*.88
)
.saturate(1.35)
.contrast(() => 1.13 + high()*.12*audioReact())
.out(o0)
render(o0)`;

    const farewellLandscape=`src(s0)
  .contrast(() => 1.16 + low()*.18 + audioChaos()*.16)
  .brightness(-.18)
  .color(.22,1,.08)
  .modulate(
    noise(() => .8 + mid()*(.7+audioChaos()*3.2),.015),
    () => .004 + low()*.008 + audioReact()*mid()*.018 + audioChaos()*(high()*.07+hit()*.045)
  )
  .layer(src(s0).luma(.22).color(.22,1,.08).brightness(-.12))
  .out(o0)
render(o0)`;

    // Scene deck structure. CUSTOM 01 stays untouched; GENESIS is the first new authored scene.
    // The other slots are placeholders to be rewritten together later.
    const scenes={
      custom01:{label:'CUSTOM 01 · CORRUPTED',code:starter},
      genesis:{label:'GENESIS · 3D LANDSCAPE',code:genesisLandscape},
      resonance:{label:'RESONANCE · PRE-HYPNOSIS / WEBCAM',code:resonanceGradient},
      hypnosis:{label:'HYPNOSIS · WEBCAM / TYPE',code:hypnosisWebcam},
      farewell:{label:'FAREWELL · TREE / SUN',code:farewellLandscape},
     };
    let currentScene='custom01';
    code.value=scenes[currentScene].code;
    const history=[];
    let lastRun=code.value;

    function run(){
      if(code.value!==lastRun){
        history.push(lastRun);
        if(history.length>50) history.shift();
      }
      try{
        (0,eval)(code.value);
        lastRun=code.value;
        status.textContent='RUNNING · '+new Date().toLocaleTimeString();
        status.classList.remove('error');
      }catch(err){
        status.textContent='ERROR · '+err.message;
        status.classList.add('error');
      }
    }
    run();

    async function loadScene(id){
      const scene=scenes[id];
      if(!scene)return;
      currentScene=id;activeScene=id;
      if(id!=='resonance'){resonanceInvert=false;applyInvert()}
      try{s3.init({src:id==='hypnosis'?heartCanvas:archiveCanvas})}catch{}
      if(id==='genesis'||id==='farewell'){
        try{s0.init({src:landscapeCanvas});landscape.renderer.render(landscape.scene,landscape.camera)}
        catch(err){status.textContent='GENESIS SOURCE ERROR · '+err.message;status.classList.add('error');return}
      }
      if((id==='hypnosis'||id==='resonance')&&!(await ensureWebcam()))return;
      if(id==='farewell')startFarewell(); else hideFarewell();
      capitalCounter.style.display=id==='genesis'?'block':'none';
      if(id!=='hypnosis'){hearts.length=0;heartCtx.clearRect(0,0,heartCanvas.width,heartCanvas.height)}
      sceneTag.textContent='HYDRA · '+scene.label;
      if(!scene.code){
        status.textContent=scene.label+' · EMPTY SLOT';
        status.classList.remove('error');
        return;
      }
      if(scene.code!==lastRun){history.push(lastRun);if(history.length>50)history.shift()}
      code.value=scene.code;
      run();
    }
    function setHypnosisWord(word){hypnosisWord=String(word||'I AM').toUpperCase().slice(0,18);status.textContent='TYPE · '+hypnosisWord}
    function addGenesisFromRegia(id){addGenesisObject(id)}
    function addForestBurst(count=6){for(let i=0;i<count;i++)addGenesisObject('tree')}
    function moveGenesisCamera(key){
      const nav=landscape.nav,step=1.5,turn=.09;
      if(key==='ArrowLeft')nav.yaw-=turn;if(key==='ArrowRight')nav.yaw+=turn;
      if(key==='ArrowUp'){nav.x-=Math.sin(nav.yaw)*step;nav.z-=Math.cos(nav.yaw)*step}
      if(key==='ArrowDown'){nav.x+=Math.sin(nav.yaw)*step;nav.z+=Math.cos(nav.yaw)*step}
      landscape.camera.position.x=nav.x;landscape.camera.position.z=10+nav.z;
    }
    function cleanHydra(){
      try{solid(0,0,0,1).out(o0);render(o0);status.textContent='CLEAN';sceneTag.textContent='HYDRA · CLEAN'}catch(err){status.textContent='ERROR · '+err.message}
    }
    function blackoutHydra(){
      try{
        solid(0,0,0,1).out(o0);solid(0,0,0,1).out(o1);solid(0,0,0,1).out(o2);solid(0,0,0,1).out(o3);
        render(o0);status.textContent='BLACK OUT';sceneTag.textContent='HYDRA · BLACK OUT';
      }catch(err){status.textContent='ERROR · '+err.message}
    }
    function back(){
      if(!history.length){
        status.textContent='BACK · NO PREVIOUS PATCH';
        return;
      }
      const previous=history.pop();
      code.value=previous;
      try{
        (0,eval)(previous);
        lastRun=previous;
        status.textContent='BACK · '+new Date().toLocaleTimeString();
        status.classList.remove('error');
      }catch(err){
        status.textContent='ERROR · '+err.message;
        status.classList.add('error');
      }
    }

    const handleRegia=m=>{
      m=m||{};
      if(m.type==='hydra-scene')loadScene(m.scene);
      if(m.type==='hydra-hypnosis-word')setHypnosisWord(m.word);
      if(m.type==='hydra-farewell-credits'){farewellCreditsInner.textContent=String(m.text||'').trim()||'BLIVET'}
      if(m.type==='hydra-credits-play')showFarewellCredits(m.text||farewellCreditsInner.textContent)
      if(m.type==='hydra-credits-stop')farewellCredits.classList.remove('on')
      if(m.type==='hydra-clean')cleanHydra();
      if(m.type==='hydra-object-add')addGenesisFromRegia(m.object);
      if(m.type==='hydra-forest-burst')addForestBurst(m.count||6);
      if(m.type==='hydra-blackout')blackoutHydra();
      if(m.type==='hydra-back')back();
      if(m.type==='hydra-editor')toggleEditor()
      if(m.type==='hydra-hud'){
        const visible=m.visible!==false;
        midiMonitor.style.display=visible?'':'none';
        editorToggle.style.display=visible?'':'none';
        sceneTag.style.display=visible?'':'none';
        if(!visible)editor.classList.remove('open');
      }
    };
    midiMonitor.style.display='none';
    editorToggle.style.display='none';
    sceneTag.style.display='none';
    editor.classList.remove('open');
    const regiaChannel=new BroadcastChannel('elisa-regia');
    regiaChannel.onmessage=e=>handleRegia(e.data);
    addEventListener('storage',e=>{if(e.key==='elisa-regia-command'&&e.newValue){try{handleRegia(JSON.parse(e.newValue).message)}catch{}}});

    editorToggle.addEventListener('click',toggleEditor);
    window.addEventListener('keydown',(e)=>{
      if(e.code==='Space'&&document.activeElement!==code&&currentScene==='hypnosis'){e.preventDefault();hypnosisDrop=1;status.textContent='DROP · DISINTEGRATE'}
      if(['ArrowLeft','ArrowRight'].includes(e.key)&&document.activeElement!==code){
        e.preventDefault();
        const sceneOrder=Object.keys(scenes),at=sceneOrder.indexOf(currentScene),dir=e.key==='ArrowRight'?1:-1;
        loadScene(sceneOrder[(at+dir+sceneOrder.length)%sceneOrder.length]);
      }
      if(['ArrowUp','ArrowDown'].includes(e.key)&&document.activeElement!==code&&(currentScene==='genesis'||currentScene==='farewell')){e.preventDefault();moveGenesisCamera(e.key)}
      if(e.ctrlKey&&e.key.toLowerCase()==='e'){e.preventDefault();toggleEditor()}
      if(e.ctrlKey&&e.key==='Enter'){e.preventDefault();run()}
      if(e.ctrlKey&&e.key.toLowerCase()==='z'){e.preventDefault();back()}
      if(e.ctrlKey&&e.key.toLowerCase()==='l'&&document.activeElement===code){e.preventDefault();code.value=''}
    });
    window.addEventListener('keyup',(e)=>{if(e.code==='Space'&&currentScene==='hypnosis')hypnosisDrop=0});
    addEventListener('resize',()=>{
      hydra.synth.setResolution(innerWidth,innerHeight);
      landscape.camera.aspect=innerWidth/innerHeight;landscape.camera.updateProjectionMatrix();
      landscape.renderer.setSize(innerWidth,innerHeight,false);
    });
  </script>
</body>
</html>
