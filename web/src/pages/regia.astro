<script type="module">
import {listAudioInputs,startAudio,startTrack,setSensitivity} from "../lib/audio-engine.js";
const q=s=>document.querySelector(s),device=q("#audioDevice"),state=q("#audioState"),soul=q("#soul"),master=q("#master"),seek=q("#seek");
let liveTimerRunning=false,liveTimerStarted=0,liveTimerElapsed=0,liveTimerRaf=0;
const liveTimer=q("#liveTimer"),liveTimerStart=q("#liveTimerStart"),liveTimerReset=q("#liveTimerReset");
const renderLiveTimer=()=>{
  const elapsed=liveTimerElapsed+(liveTimerRunning?performance.now()-liveTimerStarted:0);
  const total=Math.max(0,elapsed),min=Math.floor(total/60000),sec=Math.floor(total/1000)%60,tenth=Math.floor(total/100)%10;
  liveTimer.textContent=String(min).padStart(2,"0")+":"+String(sec).padStart(2,"0")+"."+tenth;
  if(liveTimerRunning)liveTimerRaf=requestAnimationFrame(renderLiveTimer);
};
liveTimerStart.onclick=()=>{
  if(liveTimerRunning){liveTimerElapsed+=performance.now()-liveTimerStarted;liveTimerRunning=false;cancelAnimationFrame(liveTimerRaf);liveTimerStart.textContent="RESUME";liveTimerStart.classList.remove("running");renderLiveTimer();return}
  liveTimerStarted=performance.now();liveTimerRunning=true;liveTimerStart.textContent="PAUSE";liveTimerStart.classList.add("running");renderLiveTimer();
};
liveTimerReset.onclick=()=>{liveTimerRunning=false;cancelAnimationFrame(liveTimerRaf);liveTimerElapsed=0;liveTimerStarted=0;liveTimerStart.textContent="START";liveTimerStart.classList.remove("running");renderLiveTimer()};
const fmt=t=>{t=Math.max(0,Number(t)||0);return String(Math.floor(t/60)).padStart(2,"0")+":"+String(Math.floor(t%60)).padStart(2,"0")};
const SHOW_DURATION=1947;
const cues=[[0,"TEXT INTRO",1],[60,"FACE ID",1],[90,"LOADER",0],[120,"HYDRA I",1],[260,"FOTO",0],[313,"VIDEO VERT.",0],[380,"FOTO",0],[500,"3D TOUCH",1],[680,"HYDRA II",1],[800,"ROTAZIONI",0],[900,"FORESTA + NUMERI",1],[1080,"FORESTA + IMMAGINI",0],[1240,"ARCHIVIO 3D",1],[1460,"HYDRA III",1],[1550,"TRANSIZIONE",0],[1610,"NUCLEO ROSSO",1],[1680,"ALBERO",0],[1770,"BLIVET",1],[1840,"HYDRA IV",1]];
const markers=q("#markers"),nextCue=q("#nextCue");
cues.forEach(([t,label,major])=>{const m=document.createElement("i");m.className="marker"+(major?" major":"");m.style.left=(t/SHOW_DURATION*100)+"%";m.dataset.time=t;m.title=fmt(t)+" Â· "+label;markers.appendChild(m)});
function syncCue(t){const upcoming=cues.find(([ct])=>ct>t+.5);[...markers.children].forEach(m=>m.classList.toggle("next",upcoming&&Number(m.dataset.time)===upcoming[0]));nextCue.textContent=upcoming?"NEXT â€” "+fmt(upcoming[0])+" "+upcoming[1]:"END OF SHOW"}
async function populate(){
 try{
  const saved=localStorage.getItem("elisa-audio-device")||"",inputs=await listAudioInputs();
  device.innerHTML='<option value="">Default audio input</option>';
  inputs.forEach((d,i)=>{const o=document.createElement("option");o.value=d.deviceId;o.textContent=d.label||("Audio input "+(i+1));device.appendChild(o)});
  if([...device.options].some(o=>o.value===saved))device.value=saved;
 }catch(e){state.textContent="DEVICE ERROR"}
}
device.addEventListener("change",()=>localStorage.setItem("elisa-audio-device",device.value));
q("#refresh").onclick=populate;
const armButton=q("#arm");
const showLiveState=(mode)=>{
 armButton.classList.toggle("arming",mode==="arming");
 armButton.classList.toggle("armed",mode==="armed");
 armButton.textContent=mode==="arming"?"ARMING…":mode==="armed"?"● LIVE ARMED":"ARM LIVE";
};
const armLive=async()=>{
 if(window.ELISA_AUDIO?.source==="input"&&window.ELISA_AUDIO.running){showLiveState("armed");state.textContent="LIVE INPUT";return}
 showLiveState("arming");state.textContent="REQUESTING…";
 try{await startAudio(device.value);localStorage.setItem("elisa-audio-device",device.value);state.textContent="LIVE INPUT";soul.textContent="ONLINE";showLiveState("armed");await populate()}
 catch(e){showLiveState("idle");state.textContent=e.name||"AUDIO ERROR"}
};
armButton.onclick=armLive;
q("#trackSource").onclick=async()=>{try{showLiveState("idle");await startTrack(master);state.textContent="MASTER TRACK";soul.textContent="ONLINE";q("#play").textContent="âšâš PAUSE MASTER"}catch(e){state.textContent=e.name||"TRACK ERROR"}};
q("#play").onclick=async()=>{try{
 if(window.ELISA_AUDIO?.source!=="track"){showLiveState("idle");await startTrack(master);state.textContent="MASTER TRACK";soul.textContent="ONLINE"}
 else if(master.paused)await master.play();else master.pause();
 q("#play").textContent=master.paused?"â–¶ PLAY MASTER":"âšâš PAUSE MASTER";
}catch(e){state.textContent=e.name||"TRACK ERROR"}};
q("#zero").onclick=()=>master.currentTime=0;
master.addEventListener("loadedmetadata",()=>{if(Number.isFinite(master.duration))q("#total").textContent=fmt(master.duration)});
master.addEventListener("timeupdate",()=>{q("#now").textContent=fmt(master.currentTime);syncCue(master.currentTime);if(!seek.matches(":active"))seek.value=master.duration?Math.round(master.currentTime/master.duration*1000):0});
master.addEventListener("ended",()=>q("#play").textContent="â–¶ PLAY MASTER");
seek.oninput=()=>{if(master.duration)master.currentTime=Number(seek.value)/1000*master.duration};
q("#volume").oninput=e=>{master.volume=Number(e.target.value);q("#volVal").textContent=Math.round(master.volume*100)+"%"};
q("#sensitivity").oninput=e=>{setSensitivity(e.target.value);q("#sensVal").textContent=Number(e.target.value).toFixed(1)};
const bars={level:["#mLevel","#vLevel"],low:["#mLow","#vLow"],mid:["#mMid","#vMid"],high:["#mHigh","#vHigh"],transient:["#mHit","#vHit"]};
window.addEventListener("elisa-audio",e=>{Object.entries(bars).forEach(([k,[b,v]])=>{const n=e.detail[k]||0;q(b).style.width=(n*100)+"%";q(v).textContent=n.toFixed(2)})});
const control=new BroadcastChannel("elisa-regia");
control.addEventListener("message",async e=>{
 const m=e.data;
 if(m?.type!=="audio-control")return;
 try{
  if(m.action==="live"){await armLive()}
  if(m.action==="track"){showLiveState("idle");await startTrack(master);state.textContent="MASTER TRACK";soul.textContent="ONLINE";q("#play").textContent="❚❚ PAUSE MASTER"}
  if(m.action==="play"){
    if(window.ELISA_AUDIO?.source!=="track")await startTrack(master);else await master.play();
    state.textContent="MASTER TRACK";q("#play").textContent="❚❚ PAUSE MASTER";
  }
  if(m.action==="pause"){master.pause();q("#play").textContent="▶ PLAY MASTER"}
  if(m.action==="zero"){master.currentTime=0}
 }catch(err){state.textContent=err.name||"AUDIO ERROR"}
});
const send=message=>{control.postMessage(message);localStorage.setItem("elisa-regia-command",JSON.stringify({id:Date.now()+Math.random(),message}))};
document.querySelectorAll("[data-fx]").forEach(btn=>btn.onclick=()=>{btn.classList.toggle("on");send({type:"fx",fx:btn.dataset.fx,on:btn.classList.contains("on")})});
q("#fxClean").onclick=()=>{document.querySelectorAll("[data-fx]").forEach(b=>b.classList.remove("on"));send({type:"fx-clean"})};
q("#subtitles").onclick=e=>{const on=e.currentTarget.classList.toggle("on");e.currentTarget.textContent="SUBTITLES "+(on?"ON":"OFF");send({type:"subtitles",on})};
q("#voiceSubsPlay").onclick=e=>{send({type:"voice-subtitles-play"});e.currentTarget.classList.add("on")};
q("#voiceSubsStop").onclick=()=>{send({type:"voice-subtitles-stop"});q("#voiceSubsPlay").classList.remove("on")};
q("#fxAmount").oninput=e=>{q("#fxAmountVal").textContent=Number(e.target.value).toFixed(2);send({type:"fx-amount",value:Number(e.target.value)})};
q("#fxReact").oninput=e=>{q("#fxReactVal").textContent=Number(e.target.value).toFixed(1);send({type:"fx-react",value:Number(e.target.value)})};
document.querySelectorAll("[data-cue]").forEach(btn=>btn.onclick=()=>send({type:"cue",key:btn.dataset.cue}));
document.querySelectorAll("[data-hydra]").forEach(btn=>btn.onclick=()=>{document.querySelectorAll("[data-hydra]").forEach(b=>b.classList.remove("live"));btn.classList.add("live");send({type:"hydra-scene",scene:btn.dataset.hydra})});
document.querySelectorAll("[data-hydra-object]").forEach(btn=>btn.onclick=()=>{send({type:"hydra-object-add",object:btn.dataset.hydraObject});btn.animate([{transform:"scale(1)"},{transform:"scale(.94)"},{transform:"scale(1)"}],{duration:160})});
q("#forestBurst").onclick=()=>send({type:"hydra-forest-burst",count:6});
document.querySelectorAll("[data-hypnosis-word]").forEach(btn=>btn.onclick=()=>{q("#hypnosisText").value=btn.dataset.hypnosisWord;send({type:"hydra-hypnosis-word",word:btn.dataset.hypnosisWord})});
const sendHypnosisText=()=>{const word=q("#hypnosisText").value.trim();if(word)send({type:"hydra-hypnosis-word",word})};
q("#hypnosisSend").onclick=sendHypnosisText;
q("#hypnosisText").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();sendHypnosisText()}});
q("#farewellCreditsSend").onclick=()=>send({type:"hydra-farewell-credits",text:q("#farewellCreditsText").value});
q("#farewellCreditsPlay").onclick=()=>send({type:"hydra-credits-play",text:q("#farewellCreditsText").value});
q("#farewellCreditsStop").onclick=()=>send({type:"hydra-credits-stop"});
const setupStatus=q("#setupStatus"),setupFile=q("#setupFile");
const captureSetup=()=>({
  version:1,name:q("#setupName").value.trim()||"ELISA LIVE",savedAt:new Date().toISOString(),
  audio:{sensitivity:Number(q("#sensitivity").value),volume:Number(q("#volume").value)},
  web:{fxAmount:Number(q("#fxAmount").value),fxReact:Number(q("#fxReact").value),fx:[...document.querySelectorAll("[data-fx]")].filter(b=>b.classList.contains("on")).map(b=>b.dataset.fx),subtitles:q("#subtitles").classList.contains("on")},
  hydra:{scene:document.querySelector("[data-hydra].live")?.dataset.hydra||null,hypnosisText:q("#hypnosisText").value,credits:q("#farewellCreditsText").value}
});
q("#setupSave").onclick=()=>{
  const data=captureSetup(),blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"}),a=document.createElement("a");
  a.href=URL.createObjectURL(blob);a.download=(data.name.toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"")||"elisa-regia")+"-setup.json";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),500);
  setupStatus.textContent="SAVED · "+data.name;
};
q("#setupLoad").onclick=()=>setupFile.click();
setupFile.onchange=async()=>{
  const file=setupFile.files?.[0];if(!file)return;
  try{
    const data=JSON.parse(await file.text()),a=data.audio||{},w=data.web||{},h=data.hydra||{};
    if(Number.isFinite(a.sensitivity)){q("#sensitivity").value=a.sensitivity;setSensitivity(a.sensitivity);q("#sensVal").textContent=Number(a.sensitivity).toFixed(1)}
    if(Number.isFinite(a.volume)){q("#volume").value=a.volume;master.volume=a.volume;q("#volVal").textContent=Math.round(a.volume*100)+"%"}
    if(Number.isFinite(w.fxAmount)){q("#fxAmount").value=w.fxAmount;q("#fxAmountVal").textContent=Number(w.fxAmount).toFixed(2);send({type:"fx-amount",value:Number(w.fxAmount)})}
    if(Number.isFinite(w.fxReact)){q("#fxReact").value=w.fxReact;q("#fxReactVal").textContent=Number(w.fxReact).toFixed(1);send({type:"fx-react",value:Number(w.fxReact)})}
    document.querySelectorAll("[data-fx]").forEach(b=>{const on=(w.fx||[]).includes(b.dataset.fx);b.classList.toggle("on",on);send({type:"fx-set",fx:b.dataset.fx,on})});
    const sub=!!w.subtitles;q("#subtitles").classList.toggle("on",sub);q("#subtitles").textContent="SUBTITLES "+(sub?"ON":"OFF");send({type:"subtitles",on:sub});
    if(typeof h.hypnosisText==="string")q("#hypnosisText").value=h.hypnosisText;
    if(typeof h.credits==="string"){q("#farewellCreditsText").value=h.credits;send({type:"hydra-farewell-credits",text:h.credits})}
    if(h.scene){const b=document.querySelector('[data-hydra="'+h.scene+'"]');if(b){document.querySelectorAll("[data-hydra]").forEach(x=>x.classList.remove("live"));b.classList.add("live");send({type:"hydra-scene",scene:h.scene})}}
    q("#setupName").value=data.name||file.name.replace(/\.json$/i,"");setupStatus.textContent="LOADED · "+(data.name||file.name);
  }catch(err){setupStatus.textContent="JSON ERROR · "+err.message}
  setupFile.value="";
};
q("#hydraBlackout").onclick=()=>send({type:"hydra-blackout"});
q("#hydraClean").onclick=()=>send({type:"hydra-clean"});
q("#hydraBack").onclick=()=>send({type:"hydra-back"});
q("#hydraEditor").onclick=()=>send({type:"hydra-editor"});
let hydraHudVisible=true;
q("#hydraHud").onclick=()=>{
  hydraHudVisible=!hydraHudVisible;
  send({type:"hydra-hud",visible:hydraHudVisible});
  q("#hydraHud").textContent=hydraHudVisible?"HIDE HUD":"SHOW HUD";
  q("#hydraHud").classList.toggle("on",!hydraHudVisible);
};
syncCue(0);populate();
</script>
</body>
</html>
