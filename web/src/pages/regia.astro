const sendHydraCue = (scene, clip) => send({type:"hydra-scene", scene, clip, ...(scene === "dissolve" ? {dissolveVideos:dissolveVideoConfig()} : {}), cueId:Date.now() + Math.random()});
async function touchControl(name, value) {
  const response = await fetch(location.protocol + "//" + location.hostname + ":8765/control", {
    method: "POST", headers: {"Content-Type":"application/json"},
    body: JSON.stringify({name, value}), signal: AbortSignal.timeout(1200),
  });
  if (!response.ok) throw new Error("HTTP " + response.status);
}
function launchHydraCue(button) {
  hydraCues.forEach(cue => {
    cue.classList.toggle("live", cue === button);
    cue.setAttribute("aria-pressed", String(cue === button));
  });
  const scene = button.dataset.hydra;
  showMouseActions(scene);
  const label = button.querySelector("strong").textContent;
  q("#hydraCueStatus").textContent = label;
  void restoreLandscapeClips.then(() => {
    if (!button.classList.contains("live")) return;
    sendHydraCue(scene, videoClips[scene] || "");
