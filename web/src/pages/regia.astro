  if(subtitleRun && subtitleRun.position+1<subtitleRun.cards.length){subtitleRun.position++;renderManualSubtitle()}
};
q("#subtitleStop").onclick=()=>{subtitleRun=null;renderManualSubtitle()};
q("#fxAmount").oninput=e=>{q("#fxAmountVal").textContent=Number(e.target.value).toFixed(2);send({type:"fx-amount",value:Number(e.target.value)})};
