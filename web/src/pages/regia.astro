<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width">
<title>AICHA / ELISA REGIA</title>
<style>
*{box-sizing:border-box}:root{--acid:#39ff14;--pink:#ff2bd6;--bg:#070707;--line:#303030}html,body{margin:0;min-height:100%;background:var(--bg);color:#f3f3f3;font-family:Helvetica,Arial,sans-serif}
body{padding:22px;background-image:linear-gradient(rgba(57,255,20,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,43,214,.02) 1px,transparent 1px);background-size:28px 28px}.shell{max-width:1180px;margin:auto;border:1px solid #3b3b3b;background:#0d0d0d;box-shadow:0 18px 70px #000}
header{padding:18px 20px;border-bottom:1px solid #444;display:flex;justify-content:space-between;align-items:center}.title{font-size:22px}.soul{font-size:11px;letter-spacing:.15em}
.grid{display:grid;grid-template-columns:1.05fr .95fr;gap:1px;background:#444}.panel{background:#111;padding:20px;min-height:260px}
h2{font-size:11px;letter-spacing:.16em;font-weight:400;margin:0 0 16px;color:#aaa}.state{font-size:13px;margin-bottom:12px}
select,button,input{font:inherit}.device{display:flex;gap:8px}.device select{flex:1;background:#080808;color:#fff;border:1px solid #555;padding:10px}
button{background:#111;color:#ddd;border:1px solid #444;padding:10px 13px;cursor:pointer;letter-spacing:.035em;transition:.12s ease}button:hover{border-color:var(--acid);color:var(--acid);background:#0b1609}button:active{transform:translateY(1px);background:var(--pink);color:#000;border-color:var(--pink)}button.live,button.on{background:var(--acid)!important;color:#050505!important;border-color:var(--acid)!important}.actions{display:flex;gap:8px;margin:12px 0}
.meterrow{display:grid;grid-template-columns:48px 1fr 44px;gap:9px;align-items:center;margin:9px 0;font-size:11px}.meter{height:10px;border:1px solid #555;background:#050505}.meter i{display:block;height:100%;width:0;background:var(--acid);box-shadow:0 0 9px rgba(57,255,20,.5)}.hit i{transition:width .04s}
.sens{display:grid;grid-template-columns:95px 1fr 42px;gap:9px;align-items:center;margin-top:16px;font-size:11px}
.clock{font-size:clamp(38px,5vw,74px);letter-spacing:-.07em;line-height:1;margin:18px 0}.clock small{font-size:.32em;color:#777;letter-spacing:-.03em}
.timeline{position:relative;margin:18px 0 8px;padding-top:24px}.seek{width:100%;position:relative;z-index:2}.markers{position:absolute;left:8px;right:8px;top:0;height:36px;pointer-events:none}.marker{position:absolute;bottom:8px;width:1px;height:22px;background:#777}.marker.major{height:31px;background:#eee}.marker.major{width:2px}.marker.next{background:#fff;height:30px}.nextcue{font-size:11px;color:#aaa;margin-top:10px;min-height:15px}.trackactions{display:flex;gap:8px;margin-top:12px}.trackactions button:first-child{flex:1}
.vol{display:grid;grid-template-columns:60px 1fr 45px;gap:8px;align-items:center;margin-top:14px;font-size:11px}.video{border-top:1px solid #444;padding:20px}.video-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:18px}.fx,.cues{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.fx #subtitles{grid-column:span 2}.fx #subtitles.on{background:#eee;color:#000}.fx button.on,.cues button.on{background:#eee;color:#000}.vrow{display:grid;grid-template-columns:70px 1fr 45px;gap:8px;align-items:center;margin-top:12px;font-size:11px}.vrow input{width:100%}.video-note{font-size:10px;color:#777;margin-top:10px}.hydra-deck{border-top:1px solid #444;padding:20px}.hydra-buttons{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.hydra-tools{display:flex;gap:7px;margin-top:8px}.genesis-objects{display:flex;gap:7px;margin-top:8px;flex-wrap:wrap}.genesis-objects button{flex:1;min-width:120px;border-color:#31512b}.genesis-objects button:nth-child(n+4){border-color:#6a255d;color:#ff83e9}.genesis-objects button:nth-child(n+4):hover{background:var(--pink);color:#050505;border-color:var(--pink)}.genesis-objects button.on{background:var(--acid);color:#000}.hypnosis-type{display:flex;gap:7px;margin-top:8px;flex-wrap:wrap}.hypnosis-type button{flex:1;min-width:110px;border-color:#6a255d;color:#ff83e9}.hypnosis-type button:hover{background:var(--pink);color:#050505;border-color:var(--pink)}.hypnosis-input{display:flex;gap:7px;margin-top:8px}.hypnosis-input input{flex:1;min-width:0;background:#050505;color:var(--pink);border:1px solid #6a255d;padding:10px 12px;outline:none}.hypnosis-input input:focus{border-color:var(--pink);box-shadow:0 0 10px rgba(255,43,214,.2)}.hypnosis-input button{border-color:var(--pink);color:var(--pink)}.hydra-tools button{flex:1}.hydra-buttons button.todo{border-style:dashed;color:#888}.hydra-buttons button.live{background:#eee;color:#000}
footer{padding:11px 20px;border-top:1px solid #444;color:#777;font-size:10px;display:flex;justify-content:space-between}
@media(max-width:760px){.grid{grid-template-columns:1fr}}

/* ===== AICHA COMPACT COCKPIT ===== */

body {
  padding: 7px !important;
  background-size: 18px 18px !important;
}

.shell {
  max-width: 1480px !important;
}

header {
  padding: 7px 11px !important;
}

.title {
  font-size: 13px !important;
}

.soul,
h2 {
  font-size: 8px !important;
}

h2 {
  margin-bottom: 7px !important;
}

.panel,
.video,
.hydra-deck {
  padding: 9px 11px !important;
  min-height: 0 !important;
}

.state {
  font-size: 9px !important;
  margin-bottom: 5px !important;
}

/* MICRO BUTTONS */

button {
  min-height: 22px !important;
  padding: 3px 7px !important;
  font-size: 8px !important;
  letter-spacing: .055em !important;
  border-radius: 0 !important;
}

.actions,
.trackactions,
.hydra-tools,
.genesis-objects,
.hypnosis-type,
.hypnosis-input {
  gap: 3px !important;
  margin-top: 4px !important;
  margin-bottom: 4px !important;
}

.genesis-objects button,
.hypnosis-type button,
.hydra-tools button {
  flex: 0 0 auto !important;
  min-width: 0 !important;
}

/* HYDRA = STRISCIA DI COMANDI */

.hydra-buttons {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 3px !important;
}

/* AUDIO */

.meterrow {
  grid-template-columns: 32px 1fr 29px !important;
  gap: 5px !important;
  margin: 3px 0 !important;
  font-size: 8px !important;
}

.meter {
  height: 4px !important;
}

.sens,
.vol,
.vrow {
  margin-top: 5px !important;
  font-size: 8px !important;
}

/* CLOCK */

.clock {
  font-size: clamp(27px,3.2vw,47px) !important;
  margin: 6px 0 !important;
}

.timeline {
  margin: 7px 0 2px !important;
  padding-top: 13px !important;
}

.markers {
  height: 18px !important;
}

.marker {
  height: 9px !important;
}

.marker.major {
  height: 14px !important;
}

.nextcue,
.video-note {
  font-size: 8px !important;
  margin-top: 4px !important;
}

/* VIDEO CONTROL */

.video-grid {
  gap: 9px !important;
}

.fx,
.cues {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 3px !important;
}

.fx #subtitles {
  grid-column: auto !important;
}

/* INPUT */

.device {
  gap: 3px !important;
}

.device select {
  padding: 3px 6px !important;
  font-size: 9px !important;
}

.hypnosis-input {
  max-width: 400px !important;
}

.hypnosis-input input {
  padding: 3px 6px !important;
  font-size: 9px !important;
}

footer {
  padding: 6px 11px !important;
  font-size: 7px !important;
}

@media(max-width:760px) {
  body {
    padding: 0 !important;
  }
}

</style>
</head>
<body>
<div class="shell">
<header><div class="title">AICHA / ELISA REGIA</div><div class="soul">MEDIA SOUL: <span id="soul">STANDBY</span></div></header>
<div class="grid">
<section class="panel">
<h2>AUDIO MASTER / LIVE INPUT</h2>
<div class="state">SOURCE â€” <b id="audioState">OFF</b></div>
<div class="device"><select id="audioDevice"><option value="">Default audio input</option></select><button id="refresh">REFRESH</button></div>
<div class="actions"><button id="arm">ARM LIVE</button><button id="trackSource">USE TRACK</button></div>
<div class="meterrow"><span>LEVEL</span><div class="meter"><i id="mLevel"></i></div><span id="vLevel">0.00</span></div>
<div class="meterrow"><span>LOW</span><div class="meter"><i id="mLow"></i></div><span id="vLow">0.00</span></div>
<div class="meterrow"><span>MID</span><div class="meter"><i id="mMid"></i></div><span id="vMid">0.00</span></div>
<div class="meterrow"><span>HIGH</span><div class="meter"><i id="mHigh"></i></div><span id="vHigh">0.00</span></div>
<div class="meterrow hit"><span>HIT</span><div class="meter"><i id="mHit"></i></div><span id="vHit">0.00</span></div>
<label class="sens"><span>SENSITIVITY</span><input id="sensitivity" type="range" min=".2" max="5" step=".1" value="1.6"><span id="sensVal">1.6</span></label>
</section>
<section class="panel">
<h2>MASTER TRACK / PERFORMANCE CLOCK</h2>
<div class="clock"><span id="now">00:00</span> <small>/ <span id="total">32:27</span></small></div>
<audio id="master" src="/audio/elisa_master.mp3" preload="metadata"></audio>
<div class="timeline"><div class="markers" id="markers"></div><input class="seek" id="seek" type="range" min="0" max="1000" step="1" value="0"></div><div class="nextcue" id="nextCue">NEXT â€” 01:00 FACE ID</div>
<div class="trackactions"><button id="play">â–¶ PLAY MASTER</button><button id="zero">â†º 00:00</button></div>
<label class="vol"><span>VOLUME</span><input id="volume" type="range" min="0" max="1" step=".01" value="1"><span id="volVal">100%</span></label>
</section>
</div>
<section class="video">
<h2>WEB / VIDEO REGIA</h2>
<div class="video-grid">
<div><div class="state">INTERFACE FX</div><div class="fx"><button data-fx="acid">ACID</button><button data-fx="glitch">GLITCH</button><button data-fx="pixel">PIXEL</button><button data-fx="blur">BLUR</button><button id="fxClean">CLEAN</button><button id="subtitles">SUBTITLES OFF</button></div>
<label class="vrow"><span>AMOUNT</span><input id="fxAmount" type="range" min="0" max="1" step=".01" value=".55"><span id="fxAmountVal">.55</span></label>
<label class="vrow"><span>REACT</span><input id="fxReact" type="range" min="0" max="2" step=".05" value="1"><span id="fxReactVal">1.0</span></label></div>
<div><div class="state">FEED / SPACE CUES</div><div class="cues"><button data-cue="s">S Â· SCROLL</button><button data-cue="b">B Â· BREATH I</button><button data-cue="d">D Â· BREATH II</button><button data-cue="f">F Â· FLOAT</button><button data-cue="g">G Â· 3D</button><button data-cue="h">H Â· ORBIT</button><button data-cue="j">J Â· DISTANCE</button><button data-cue="k">K Â· FLOW</button><button data-cue="l">L Â· IMPLODE</button></div>
<div class="video-note">REMOTE WEB CONTROL Â· keep the performance page open in another browser window/display.</div></div>
</div></section>
<section class="hydra-deck">
<h2>HYDRA / SCENE DECK</h2>
<div class="hydra-buttons">
<button data-hydra="custom01">CUSTOM 01 Â· CORRUPTED</button>
<button data-hydra="genesis">GENESIS Â· 3D LANDSCAPE</button>
<button data-hydra="hypnosis">HYPNOSIS Â· WEBCAM</button>
<button data-hydra="resonance" class="todo">RESONANCE Â· TODO</button>
<button data-hydra="farewell" class="todo">FAREWELL Â· TODO</button>
</div>
<div class="genesis-objects"><button data-hydra-object="tree">+ TREE</button><button id="forestBurst">+ FOREST Ã—6</button><button data-hydra-object="swarm">+ SPORES</button><button data-hydra-object="phone">+ PHONE</button><button data-hydra-object="pistol">+ PISTOL</button><button data-hydra-object="diamond">+ DIAMOND</button><button data-hydra-object="cola">+ COLA</button></div>
<div class="hypnosis-input"><input id="hypnosisText" type="text" maxlength="18" value="I AM" placeholder="TYPE YOUR MASKâ€¦"><button id="hypnosisSend">SEND TYPE</button></div>
<div class="hypnosis-type"><button data-hypnosis-word="I AM">I AM</button><button data-hypnosis-word="LOOK AT ME">LOOK AT ME</button><button data-hypnosis-word="ERROR">ERROR</button><button data-hypnosis-word="BODY">BODY</button><button data-hypnosis-word="ELISA">ELISA</button></div>
<div class="hydra-tools"><button id="hydraBlackout">BLACK OUT</button><button id="hydraClean">CLEAN</button><button id="hydraBack">BACK</button><button id="hydraEditor">EDITOR</button><button id="hydraHud">HIDE HUD</button></div>
<div class="video-note">GENESIS: â†‘â†“ move Â· â†â†’ turn Â· TREE/FOREST progressively saturate the landscape.</div>
</section>
<footer><span>DISPLAY REGIA â€” KEEP OUT OF SCREEN GRAB</span><span>ELISA LIVE Â· 32:27</span></footer>
</div>
<script type="module">
import {listAudioInputs,startAudio,startTrack,setSensitivity} from "../lib/audio-engine.js";
const q=s=>document.querySelector(s),device=q("#audioDevice"),state=q("#audioState"),soul=q("#soul"),master=q("#master"),seek=q("#seek");
const fmt=t=>{t=Math.max(0,Number(t)||0);return String(Math.floor(t/60)).padStart(2,"0")+":"+String(Math.floor(t%60)).padStart(2,"0")};
const SHOW_DURATION=1947;
const cues=[[0,"TEXT INTRO",1],[60,"FACE ID",1],[90,"LOADER",0],[120,"HYDRA I",1],[260,"FOTO",0],[313,"VIDEO VERT.",0],[380,"FOTO",0],[500,"3D TOUCH",1],[680,"HYDRA II",1],[800,"ROTAZIONI",0],[900,"FORESTA + NUMERI",1],[1080,"FORESTA + IMMAGINI",0],[1240,"ARCHIVIO 3D",1],[1460,"HYDRA III",1],[1550,"TRANSIZIONE",0],[1610,"NUCLEO ROSSO",1],[1680,"ALBERO",0],[1770,"BLIVET",1],[1840,"HYDRA IV",1]];
const markers=q("#markers"),nextCue=q("#nextCue");
cues.forEach(([t,label,major])=>{const m=document.createElement("i");m.className="marker"+(major?" major":"");m.style.left=(t/SHOW_DURATION*100)+"%";m.dataset.time=t;m.title=fmt(t)+" Â· "+label;markers.appendChild(m)});
function syncCue(t){const upcoming=cues.find(([ct])=>ct>t+.5);[...markers.children].forEach(m=>m.classList.toggle("next",upcoming&&Number(m.dataset.time)===upcoming[0]));nextCue.textContent=upcoming?"NEXT â€” "+fmt(upcoming[0])+" "+upcoming[1]:"END OF SHOW"}
async function populate(){
 try{
  const saved=localStorage.getItem("elisa-audio-device")||"",inputs=await listAudioInputs();
  device.innerHTML='<option value="">Default audio input</option>';
  inputs.forEach((d,i)=>{const o=document.createElement("option");o.value=d.deviceId;o.textContent=d.label||("Audio input "+(i+1));device.appendChild(o)});
  if([...device.options].some(o=>o.value===saved))device.value=saved;
 }catch(e){state.textContent="DEVICE ERROR"}
}
device.addEventListener("change",()=>localStorage.setItem("elisa-audio-device",device.value));
q("#refresh").onclick=populate;
q("#arm").onclick=async()=>{try{state.textContent="REQUESTINGâ€¦";await startAudio(device.value);localStorage.setItem("elisa-audio-device",device.value);state.textContent="LIVE INPUT";soul.textContent="ONLINE";await populate()}catch(e){state.textContent=e.name||"AUDIO ERROR"}};
q("#trackSource").onclick=async()=>{try{await startTrack(master);state.textContent="MASTER TRACK";soul.textContent="ONLINE";q("#play").textContent="âšâš PAUSE MASTER"}catch(e){state.textContent=e.name||"TRACK ERROR"}};
q("#play").onclick=async()=>{try{
 if(window.ELISA_AUDIO?.source!=="track"){await startTrack(master);state.textContent="MASTER TRACK";soul.textContent="ONLINE"}
 else if(master.paused)await master.play();else master.pause();
 q("#play").textContent=master.paused?"â–¶ PLAY MASTER":"âšâš PAUSE MASTER";
}catch(e){state.textContent=e.name||"TRACK ERROR"}};
q("#zero").onclick=()=>master.currentTime=0;
master.addEventListener("loadedmetadata",()=>{if(Number.isFinite(master.duration))q("#total").textContent=fmt(master.duration)});
master.addEventListener("timeupdate",()=>{q("#now").textContent=fmt(master.currentTime);syncCue(master.currentTime);if(!seek.matches(":active"))seek.value=master.duration?Math.round(master.currentTime/master.duration*1000):0});
master.addEventListener("ended",()=>q("#play").textContent="â–¶ PLAY MASTER");
seek.oninput=()=>{if(master.duration)master.currentTime=Number(seek.value)/1000*master.duration};
q("#volume").oninput=e=>{master.volume=Number(e.target.value);q("#volVal").textContent=Math.round(master.volume*100)+"%"};
q("#sensitivity").oninput=e=>{setSensitivity(e.target.value);q("#sensVal").textContent=Number(e.target.value).toFixed(1)};
const bars={level:["#mLevel","#vLevel"],low:["#mLow","#vLow"],mid:["#mMid","#vMid"],high:["#mHigh","#vHigh"],transient:["#mHit","#vHit"]};
window.addEventListener("elisa-audio",e=>{Object.entries(bars).forEach(([k,[b,v]])=>{const n=e.detail[k]||0;q(b).style.width=(n*100)+"%";q(v).textContent=n.toFixed(2)})});
const control=new BroadcastChannel("elisa-regia");
control.addEventListener("message",async e=>{
 const m=e.data;
 if(m?.type!=="audio-control")return;
 try{
  if(m.action==="live"){await startAudio(device.value);state.textContent="LIVE INPUT";soul.textContent="ONLINE"}
  if(m.action==="track"){await startTrack(master);state.textContent="MASTER TRACK";soul.textContent="ONLINE";q("#play").textContent="❚❚ PAUSE MASTER"}
  if(m.action==="play"){
    if(window.ELISA_AUDIO?.source!=="track")await startTrack(master);else await master.play();
    state.textContent="MASTER TRACK";q("#play").textContent="❚❚ PAUSE MASTER";
  }
  if(m.action==="pause"){master.pause();q("#play").textContent="▶ PLAY MASTER"}
  if(m.action==="zero"){master.currentTime=0}
 }catch(err){state.textContent=err.name||"AUDIO ERROR"}
});
const send=message=>{control.postMessage(message);localStorage.setItem("elisa-regia-command",JSON.stringify({id:Date.now()+Math.random(),message}))};
document.querySelectorAll("[data-fx]").forEach(btn=>btn.onclick=()=>{btn.classList.toggle("on");send({type:"fx",fx:btn.dataset.fx,on:btn.classList.contains("on")})});
q("#fxClean").onclick=()=>{document.querySelectorAll("[data-fx]").forEach(b=>b.classList.remove("on"));send({type:"fx-clean"})};
q("#subtitles").onclick=e=>{const on=e.currentTarget.classList.toggle("on");e.currentTarget.textContent="SUBTITLES "+(on?"ON":"OFF");send({type:"subtitles",on})};
q("#fxAmount").oninput=e=>{q("#fxAmountVal").textContent=Number(e.target.value).toFixed(2);send({type:"fx-amount",value:Number(e.target.value)})};
q("#fxReact").oninput=e=>{q("#fxReactVal").textContent=Number(e.target.value).toFixed(1);send({type:"fx-react",value:Number(e.target.value)})};
document.querySelectorAll("[data-cue]").forEach(btn=>btn.onclick=()=>send({type:"cue",key:btn.dataset.cue}));
document.querySelectorAll("[data-hydra]").forEach(btn=>btn.onclick=()=>{document.querySelectorAll("[data-hydra]").forEach(b=>b.classList.remove("live"));btn.classList.add("live");send({type:"hydra-scene",scene:btn.dataset.hydra})});
document.querySelectorAll("[data-hydra-object]").forEach(btn=>btn.onclick=()=>{send({type:"hydra-object-add",object:btn.dataset.hydraObject});btn.animate([{transform:"scale(1)"},{transform:"scale(.94)"},{transform:"scale(1)"}],{duration:160})});
q("#forestBurst").onclick=()=>send({type:"hydra-forest-burst",count:6});
document.querySelectorAll("[data-hypnosis-word]").forEach(btn=>btn.onclick=()=>{q("#hypnosisText").value=btn.dataset.hypnosisWord;send({type:"hydra-hypnosis-word",word:btn.dataset.hypnosisWord})});
const sendHypnosisText=()=>{const word=q("#hypnosisText").value.trim();if(word)send({type:"hydra-hypnosis-word",word})};
q("#hypnosisSend").onclick=sendHypnosisText;
q("#hypnosisText").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();sendHypnosisText()}});
q("#hydraBlackout").onclick=()=>send({type:"hydra-blackout"});
q("#hydraClean").onclick=()=>send({type:"hydra-clean"});
q("#hydraBack").onclick=()=>send({type:"hydra-back"});
q("#hydraEditor").onclick=()=>send({type:"hydra-editor"});
let hydraHudVisible=true;
q("#hydraHud").onclick=()=>{
  hydraHudVisible=!hydraHudVisible;
  send({type:"hydra-hud",visible:hydraHudVisible});
  q("#hydraHud").textContent=hydraHudVisible?"HIDE HUD":"SHOW HUD";
  q("#hydraHud").classList.toggle("on",!hydraHudVisible);
};
syncCue(0);populate();
</script>
</body>
</html>
