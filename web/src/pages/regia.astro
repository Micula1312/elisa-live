<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width">
<title>AICHA / ELISA REGIA</title>
<style>
*{box-sizing:border-box}:root{--acid:#39ff14;--pink:#ff2400;--bg:#070707;--line:#303030}html,body{margin:0;min-height:100%;background:var(--bg);color:#f3f3f3;font-family:Helvetica,Arial,sans-serif}
body{padding:22px;background-image:linear-gradient(rgba(57,255,20,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,36,0,.02) 1px,transparent 1px);background-size:28px 28px}.shell{max-width:1180px;margin:auto;border:1px solid #3b3b3b;background:#0d0d0d;box-shadow:0 18px 70px #000}
header{padding:18px 20px;border-bottom:1px solid #444;display:flex;justify-content:space-between;align-items:center}.title{font-size:22px}.soul{font-size:11px;letter-spacing:.15em}
.grid{display:grid;grid-template-columns:1.05fr .95fr;gap:1px;background:#444}.panel{background:#111;padding:20px;min-height:260px}
h2{font-size:11px;letter-spacing:.16em;font-weight:400;margin:0 0 16px;color:#aaa}.state{font-size:13px;margin-bottom:12px}
select,button,input{font:inherit}.device{display:flex;gap:8px}.device select{flex:1;background:#080808;color:#fff;border:1px solid #555;padding:10px}
button{background:#111;color:#ddd;border:1px solid #444;padding:10px 13px;cursor:pointer;letter-spacing:.035em;transition:.12s ease}button:hover{border-color:var(--acid);color:var(--acid);background:#0b1609}button:active{transform:translateY(1px);background:var(--pink);color:#000;border-color:var(--pink)}button.live,button.on{background:var(--acid)!important;color:#050505!important;border-color:var(--acid)!important}.actions{display:flex;gap:8px;margin:12px 0}#arm.arming{background:#f4a340;color:#000;border-color:#f4a340}#arm.armed{background:#39ff14;color:#000;border-color:#39ff14;font-weight:800}
.meterrow{display:grid;grid-template-columns:48px 1fr 44px;gap:9px;align-items:center;margin:9px 0;font-size:11px}.meter{height:10px;border:1px solid #555;background:#050505}.meter i{display:block;height:100%;width:0;background:var(--acid);box-shadow:0 0 9px rgba(57,255,20,.5)}.hit i{transition:width .04s}
.sens{display:grid;grid-template-columns:95px 1fr 42px;gap:9px;align-items:center;margin-top:16px;font-size:11px}
.clock{font-size:clamp(38px,5vw,74px);letter-spacing:-.07em;line-height:1;margin:18px 0}.live-timer{margin-top:8px;padding-top:7px;border-top:1px solid #292929;display:grid;grid-template-columns:1fr auto;gap:6px;align-items:end}.live-timer-label{font-size:8px;letter-spacing:.16em;color:var(--acid)}.live-timer-clock{font-size:30px;line-height:1;letter-spacing:-.045em;font-variant-numeric:tabular-nums}.live-timer-actions{display:flex;gap:3px;grid-column:1/-1}.live-timer-actions button:first-child{min-width:92px;border-color:#31512b;color:var(--acid)}.live-timer-actions button.running{background:var(--acid)!important;color:#000!important}.clock small{font-size:.32em;color:#777;letter-spacing:-.03em}
.timeline{position:relative;margin:18px 0 8px;padding-top:24px}.seek{width:100%;position:relative;z-index:2}.markers{position:absolute;left:8px;right:8px;top:0;height:36px;pointer-events:none}.marker{position:absolute;bottom:8px;width:1px;height:22px;background:#777}.marker.major{height:31px;background:#eee}.marker.major{width:2px}.marker.next{background:#fff;height:30px}.nextcue{font-size:11px;color:#aaa;margin-top:10px;min-height:15px}.trackactions{display:flex;gap:8px;margin-top:12px}.trackactions button:first-child{flex:1}
.vol{display:grid;grid-template-columns:60px 1fr 45px;gap:8px;align-items:center;margin-top:14px;font-size:11px}.video{border-top:1px solid #444;padding:20px}.video-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:18px}.fx,.cues{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.fx #subtitles{grid-column:span 2}.fx #subtitles.on{background:#eee;color:#000}.fx button.on,.cues button.on{background:#eee;color:#000}.vrow{display:grid;grid-template-columns:70px 1fr 45px;gap:8px;align-items:center;margin-top:12px;font-size:11px}.vrow input{width:100%}.video-note{font-size:10px;color:#777;margin-top:10px}.hydra-deck{border-top:1px solid #444;padding:20px}.hydra-buttons{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.hydra-tools{display:flex;gap:7px;margin-top:8px}.genesis-objects{display:flex;gap:7px;margin-top:8px;flex-wrap:wrap}.genesis-objects button{flex:1;min-width:120px;border-color:#31512b}.genesis-objects button:nth-child(n+4){border-color:#762012;color:#ff6a52}.genesis-objects button:nth-child(n+4):hover{background:var(--pink);color:#050505;border-color:var(--pink)}.genesis-objects button.on{background:var(--acid);color:#000}.hypnosis-type{display:flex;gap:7px;margin-top:8px;flex-wrap:wrap}.hypnosis-type button{flex:1;min-width:110px;border-color:#762012;color:#ff6a52}.hypnosis-type button:hover{background:var(--pink);color:#050505;border-color:var(--pink)}.hypnosis-input{display:flex;gap:7px;margin-top:8px}.hypnosis-input input,.hypnosis-input textarea{flex:1;min-width:0;background:#050505;color:var(--pink);border:1px solid #762012;padding:10px 12px;outline:none;resize:vertical;font:inherit}.hypnosis-input input:focus{border-color:var(--pink);box-shadow:0 0 10px rgba(255,36,0,.2)}.hypnosis-input button{border-color:var(--pink);color:var(--pink)}.hydra-tools button{flex:1}.setup-tools{display:flex;gap:5px;align-items:center;flex-wrap:wrap}.setup-tools input[type="text"]{flex:1;min-width:140px;background:#050505;color:#eee;border:1px solid #444;padding:7px 8px;font:inherit}.setup-tools button{border-color:#31512b}.setup-status{font-size:8px;color:#777;margin-top:4px}.hydra-buttons button.todo{border-style:dashed;color:#888}.hydra-buttons button.live{background:#eee;color:#000}
footer{padding:11px 20px;border-top:1px solid #444;color:#777;font-size:10px;display:flex;justify-content:space-between}
@media(max-width:760px){.grid{grid-template-columns:1fr}}

/* ===== AICHA COMPACT COCKPIT ===== */

body {
  padding: 7px !important;
  background-size: 18px 18px !important;
}

.shell {
  max-width: 1480px !important;
}

header {
  padding: 7px 11px !important;
}

.title {
  font-size: 13px !important;
}

.soul,
h2 {
  font-size: 8px !important;
}

h2 {
  margin-bottom: 7px !important;
}

.panel,
.video,
.hydra-deck {
  padding: 9px 11px !important;
  min-height: 0 !important;
}

.state {
  font-size: 9px !important;
  margin-bottom: 5px !important;
}

/* MICRO BUTTONS */

button {
  min-height: 22px !important;
  padding: 3px 7px !important;
  font-size: 8px !important;
  letter-spacing: .055em !important;
  border-radius: 0 !important;
}

.actions,
.trackactions,
.hydra-tools,
.genesis-objects,
.hypnosis-type,
.hypnosis-input {
  gap: 3px !important;
  margin-top: 4px !important;
  margin-bottom: 4px !important;
}

.genesis-objects button,
.hypnosis-type button,
.hydra-tools button {
  flex: 0 0 auto !important;
  min-width: 0 !important;
}

/* HYDRA = STRISCIA DI COMANDI */

.hydra-buttons {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 3px !important;
}

/* AUDIO */

.meterrow {
  grid-template-columns: 32px 1fr 29px !important;
  gap: 5px !important;
  margin: 3px 0 !important;
  font-size: 8px !important;
}

.meter {
  height: 4px !important;
}

.sens,
.vol,
.vrow {
  margin-top: 5px !important;
  font-size: 8px !important;
}

/* CLOCK */

.clock {
  font-size: clamp(27px,3.2vw,47px) !important;
  margin: 6px 0 !important;
}

.timeline {
  margin: 7px 0 2px !important;
  padding-top: 13px !important;
}

.markers {
  height: 18px !important;
}

.marker {
  height: 9px !important;
}

.marker.major {
  height: 14px !important;
}

.nextcue,
.video-note {
  font-size: 8px !important;
  margin-top: 4px !important;
}

/* VIDEO CONTROL */

.video-grid {
  gap: 9px !important;
}

.fx,
.cues {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 3px !important;
}

.fx #subtitles {
  grid-column: auto !important;
}

/* INPUT */

.device {
  gap: 3px !important;
}

.device select {
  padding: 3px 6px !important;
  font-size: 9px !important;
}

.hypnosis-input {
  max-width: 400px !important;
}

.hypnosis-input input {
  padding: 3px 6px !important;
  font-size: 9px !important;
}

footer {
  padding: 6px 11px !important;
  font-size: 7px !important;
}

@media(max-width:760px) {
  body {
    padding: 0 !important;
  }
}


/* HYDRA CONTROL HIERARCHY */
.hydra-deck{background:#090b09!important;border-top:2px solid var(--acid)!important}
.hydra-scene-label{font-size:7px;letter-spacing:.16em;color:#777;margin:7px 0 4px}
.hydra-buttons{display:grid!important;grid-template-columns:repeat(6,minmax(82px,1fr))!important;gap:5px!important;margin-bottom:9px}
.hydra-buttons button{min-height:52px!important;padding:7px 8px!important;font-size:8px!important;border:1px solid #667066!important;background:#101410!important;color:#aaa!important;text-align:left}
.hydra-buttons button strong{font-size:12px;letter-spacing:.08em;color:#f4f4f4}
.hydra-buttons button:hover{border-color:var(--acid)!important;background:#10200d!important}
.hydra-buttons button.live{background:var(--acid)!important;border-color:var(--acid)!important;color:#000!important;box-shadow:0 0 18px rgba(57,255,20,.24)}
.hydra-buttons button.live strong{color:#000!important}
.hydra-buttons button.todo{opacity:.45}
.hydra-subpanel{border-top:1px solid #242824;padding:4px 0 3px;margin-top:2px}
.hydra-subpanel button{opacity:.78}
.hydra-subpanel button:hover{opacity:1}
.genesis-objects,.hypnosis-type,.hydra-tools{gap:3px!important}
.credits-edit{display:grid;grid-template-columns:1fr 110px;gap:5px;max-width:720px}
.credits-edit textarea{min-height:76px;background:#050505;color:var(--acid);border:1px solid #31512b;padding:6px 8px;font:9px/1.35 Helvetica,Arial,sans-serif;resize:vertical;outline:none}
.credits-edit textarea:focus{border-color:var(--acid)}
.credits-edit button{border-color:#31512b;color:var(--acid)}
.utility-panel{opacity:.72}
@media(max-width:900px){.hydra-buttons{grid-template-columns:repeat(3,1fr)!important}}
.touch-regia{border-top:1px solid #444;padding:16px 20px}
.touch-regia summary{cursor:pointer;color:var(--acid);font-size:12px}
.phone-link{margin-top:12px;font-size:12px}
.phone-link-controls{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0}
.phone-link input{flex:1 1 260px;min-width:0;padding:6px;color:inherit;background:#080908;border:1px solid #444}
.touch-regia iframe{display:block;width:100%;height:720px;max-height:80vh;margin-top:12px;border:1px solid #444;background:#080908}
.backup-panel{padding:12px 20px;border-bottom:1px solid #444}
.backup-panel h2{font-size:12px;margin:0 0 8px}
.cue-utilities,.landscape-files{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:9px}
.landscape-files label{display:grid;gap:4px;font-size:12px}
#hydraCueStatus,#backupStatus{font-size:11px;color:#aaa}
.mouse-pad{width:min(100%,320px);height:120px;border:1px solid #55774b;background:#131b11;position:relative;touch-action:none;cursor:crosshair;margin:8px 0}
.mouse-pad::before{content:"";position:absolute;left:var(--x,0%);top:var(--y,100%);width:10px;height:10px;border-radius:50%;background:#39ff14;transform:translate(-50%,-50%);pointer-events:none}
.mouse-ranges{display:flex;gap:10px;flex-wrap:wrap;margin:8px 0}.mouse-ranges label{display:grid;gap:3px;font-size:11px}
.feed-time{display:block;margin-top:4px;color:#b9ff88;font:11px monospace}
.subtitle-panel{border-top:1px solid #444;margin-top:16px;padding-top:12px}
.subtitle-panel h3{font-size:12px;margin:0}
.subtitle-texts{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:8px;margin:8px 0}
.subtitle-texts label{display:grid;gap:4px;font-size:12px}
.subtitle-texts textarea{width:100%;background:#131713;color:#fff;border:1px solid #555;padding:8px;resize:vertical}
#subtitleStatus{font-size:11px;color:#b9ff88}
</style>
</head>
<body>
<div class="shell">
<header><div class="title">AICHA / ELISA REGIA</div><div class="soul">MEDIA SOUL: <span id="soul">STANDBY</span></div></header>
<section class="backup-panel">
  <h2>USCITA / CLIP DI SICUREZZA</h2>
  <div class="hydra-tools">
    <button type="button" data-backup="0">CLIP 1</button>
    <button type="button" data-backup="1">CLIP 2</button>
    <button type="button" data-backup="2">CLIP 3</button>
    <button type="button" data-backup="live">TORNA LIVE</button>
    <span id="backupStatus" role="status"></span>
  </div>
</section>
<div class="grid">
<section class="panel">
<h2>AUDIO MASTER / LIVE INPUT</h2>
<div class="state">SOURCE â€” <b id="audioState">OFF</b></div>
<div class="device"><select id="audioDevice"><option value="">Default audio input</option></select><button id="refresh">REFRESH</button></div>
<div class="actions"><button id="arm">ARM LIVE</button><button id="trackSource">USE TRACK</button></div>
<div class="meterrow"><span>LEVEL</span><div class="meter"><i id="mLevel"></i></div><span id="vLevel">0.00</span></div>
<div class="meterrow"><span>LOW</span><div class="meter"><i id="mLow"></i></div><span id="vLow">0.00</span></div>
<div class="meterrow"><span>MID</span><div class="meter"><i id="mMid"></i></div><span id="vMid">0.00</span></div>
<div class="meterrow"><span>HIGH</span><div class="meter"><i id="mHigh"></i></div><span id="vHigh">0.00</span></div>
<div class="meterrow hit"><span>HIT</span><div class="meter"><i id="mHit"></i></div><span id="vHit">0.00</span></div>
<label class="sens"><span>SENSITIVITY</span><input id="sensitivity" type="range" min=".2" max="5" step=".1" value=".7"><span id="sensVal">0.7</span></label>
</section>
<section class="panel">
<h2>MASTER TRACK / PERFORMANCE CLOCK</h2>
<div class="clock"><span id="now">00:00</span> <small>/ <span id="total">23:00</span></small></div>
<audio id="master" src="/audio/elisa_master.wav" preload="metadata"></audio>
<div class="timeline"><div class="markers" id="markers"></div><input class="seek" id="seek" type="range" min="0" max="1000" step="1" value="0"></div><div class="nextcue" id="nextCue">NEXT · 03:00 S · SCROLL</div>
<div class="trackactions"><button id="play">â–¶ PLAY MASTER</button><button id="zero">â†º 00:00</button></div>
<label class="vol"><span>VOLUME</span><input id="volume" type="range" min="0" max="1" step=".01" value="1"><span id="volVal">100%</span></label>
<div class="live-timer"><div><div class="live-timer-label">LIVE PERFORMANCE TIMER</div><div class="live-timer-clock" id="liveTimer">00:00.0</div></div><div class="live-timer-actions"><button id="liveTimerStart">START</button><button id="liveTimerReset">RESET</button></div></div>
</section>
</div>
<section class="video">
<h2>WEB / VIDEO REGIA</h2>
<div class="video-grid">
<div><div class="state">INTERFACE FX</div><div class="fx"><button type="button" data-fx="acid">ACID</button><button type="button" id="fxClean">CLEAN</button></div>
<label class="vrow"><span>AMOUNT</span><input id="fxAmount" type="range" min="0" max="1" step=".01" value=".55"><span id="fxAmountVal">.55</span></label>
<label class="vrow"><span>REACT</span><input id="fxReact" type="range" min="0" max="2" step=".05" value="1"><span id="fxReactVal">1.0</span></label></div>
<div><div class="state">FEED / SPACE CUES</div><div class="cues">
  <button type="button" data-cue="s">S · SCROLL<small class="feed-time">3:00</small></button>
  <button type="button" data-cue="b">B · BREATH I<small class="feed-time">3:20</small></button>
  <button type="button" data-cue="d">D · BREATH II<small class="feed-time">3:40</small></button>
  <button type="button" data-cue="f">F · FLOAT<small class="feed-time">4:00</small></button>
  <button type="button" data-cue="g">G · ENTER 3D<small class="feed-time">4:25</small></button>
  <button type="button" data-cue="1">1 · SHATTER<small class="feed-time">4:55</small></button>
  <button type="button" data-cue="2">2 · CONSTELLATION<small class="feed-time">5:20</small></button>
  <button type="button" data-cue="3">3 · RIBBON<small class="feed-time">5:45</small></button>
  <button type="button" data-cue="h">H · ORBIT<small class="feed-time">6:10</small></button>
  <button type="button" data-cue="j">J · DISTANCE<small class="feed-time">6:35</small></button>
  <button type="button" data-cue="k">K · FLOW<small class="feed-time">7:00</small></button>
  <button type="button" data-cue="l">L · IMPLODE<small class="feed-time">7:30</small></button>
</div>
<p class="video-note">7:30 · L + PLAY SOTTOTITOLI 1. 8:00 · passaggio manuale a Hydra.</p>
<div class="video-note">REMOTE WEB CONTROL Â· keep the performance page open in another browser window/display.</div></div>
</div>
  <section class="subtitle-panel" aria-label="Sottotitoli manuali">
    <h3>SOTTOTITOLI MANUALI</h3>
    <p class="video-note">Una riga per schermata. PLAY mostra la prima, AVANTI passa alla successiva e STOP la toglie.</p>
    <div class="subtitle-texts">
      <label>Blocco 1<textarea id="subtitleText1" rows="3"></textarea></label>
      <label>Blocco 2<textarea id="subtitleText2" rows="3"></textarea></label>
    </div>
    <div class="hydra-tools">
      <button type="button" data-subtitle-play="1">PLAY SOTTOTITOLI 1</button>
      <button type="button" data-subtitle-play="2">PLAY SOTTOTITOLI 2</button>
      <button type="button" id="subtitleNext" disabled>AVANTI</button>
      <button type="button" id="subtitleStop" disabled>STOP</button>
      <span id="subtitleStatus" role="status"></span>
    </div>
  </section>
</section>
<section class="hydra-deck">
<h2>HYDRA / SEQUENZA LIVE</h2>
<div class="hydra-tools cue-utilities">
  <button id="nextHydra" type="button">PROSSIMO CUE</button>
  <label><input type="checkbox" id="autoMam"> AUTO MAM</label>
  <span id="hydraCueStatus" role="status">Seleziona una scena</span>
</div>
<div class="hydra-buttons">
<button data-hydra="custom01" data-mam="2">01<br><strong>CORRUPTED</strong></button>
<button data-hydra="genesis" data-mam="1">02<br><strong>GENESIS</strong></button>
<button data-hydra="body">03<br><strong>ELISA BODY REVEAL</strong></button>
<button data-hydra="dissolve">04<br><strong>BODY DISSOLVE</strong></button>
<button data-hydra="fusion">05<br><strong>FLUID FUSION</strong></button>
<button data-hydra="resonance" data-mam="0">06<br><strong>RESONANCE</strong></button>
<button data-hydra="hypnosis">07<br><strong>HYPNOSIS</strong></button>
<button data-hydra="farewell">08<br><strong>FINAL TREE</strong></button>
</div>
<div class="hydra-subpanel">
  <div class="hydra-scene-label">MOUSE / INTERAZIONI HYDRA</div>
  <div id="mouseAxes" class="video-note">X · PARAM 1 / Y · PARAM 2</div>
  <div id="hydraMousePad" class="mouse-pad" aria-hidden="true"></div>
  <div class="mouse-ranges">
    <label>X <input aria-label="Asse X Hydra" type="range" min="0" max="1" step=".01" value="0" data-hydra-macro="param1"></label>
    <label>Y <input aria-label="Asse Y Hydra" type="range" min="0" max="1" step=".01" value="0" data-hydra-macro="param2"></label>
    <label>Audio React <input type="range" min="0" max="1" step=".01" value="1" data-hydra-macro="audioReact"></label>
    <label>Chaos <input type="range" min="0" max="1" step=".01" value="0" data-hydra-macro="audioChaos"></label>
    <label>Movimento 3D <input type="range" min="0" max="1" step=".01" value=".5" data-hydra-macro="landscapeMotion"></label>
    <label>Movimento post <input type="range" min="0" max="1" step=".01" value=".5" data-hydra-macro="archiveMotion"></label>
  </div>
  <div id="hydraMouseActions" class="hydra-tools" role="group" aria-label="Azioni della scena"></div>
</div>
<div class="hydra-subpanel">
  <div class="hydra-scene-label">VIDEO PAESAGGIO</div>
  <div class="landscape-files">
    <label>Body Dissolve · A <input type="file" accept="video/*" data-landscape-clip="dissolve"><span class="video-note" data-clip-status="dissolve" aria-live="polite"></span></label>
    <label>Body Dissolve · B <input type="file" accept="video/*" data-landscape-clip="dissolve-b"><span class="video-note" data-clip-status="dissolve-b" aria-live="polite"></span></label>
    <label>Body Dissolve · C <input type="file" accept="video/*" data-landscape-clip="dissolve-c"><span class="video-note" data-clip-status="dissolve-c" aria-live="polite"></span></label>
    <label>Fluid Fusion <input type="file" accept="video/*" data-landscape-clip="fusion"><span class="video-note" data-clip-status="fusion" aria-live="polite"></span></label>
  </div>
</div>
<div class="hydra-tools" role="group" aria-label="Video Body Dissolve">
  <button type="button" data-dissolve-mode="0" aria-pressed="true">Video A</button>
  <button type="button" data-dissolve-mode="1" aria-pressed="false">Video B</button>
  <button type="button" data-dissolve-mode="2" aria-pressed="false">Video C</button>
  <button type="button" data-dissolve-mode="auto" aria-pressed="false">Auto BPM</button>
  <label>BPM <input id="dissolveBpm" type="number" min="30" max="240" value="90"></label>
</div>
<div id="bodyRevealControls" class="hydra-subpanel" hidden>
  <div class="hydra-scene-label">ELISA BODY REVEAL</div>
  <div class="hydra-tools">
    <button type="button" data-reveal-model="A">FACCIA A</button>
