<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width">
<title>AICHA / ELISA REGIA</title>
<style>
*{box-sizing:border-box}:root{--acid:#39ff14;--pink:#ff2400;--bg:#070707;--line:#303030}html,body{margin:0;min-height:100%;background:var(--bg);color:#f3f3f3;font-family:Helvetica,Arial,sans-serif}
body{padding:22px;background-image:linear-gradient(rgba(57,255,20,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,36,0,.02) 1px,transparent 1px);background-size:28px 28px}.shell{max-width:1180px;margin:auto;border:1px solid #3b3b3b;background:#0d0d0d;box-shadow:0 18px 70px #000}
header{padding:18px 20px;border-bottom:1px solid #444;display:flex;justify-content:space-between;align-items:center}.title{font-size:22px}.soul{font-size:11px;letter-spacing:.15em}
.grid{display:grid;grid-template-columns:1.05fr .95fr;gap:1px;background:#444}.panel{background:#111;padding:20px;min-height:260px}
h2{font-size:11px;letter-spacing:.16em;font-weight:400;margin:0 0 16px;color:#aaa}.state{font-size:13px;margin-bottom:12px}
select,button,input{font:inherit}.device{display:flex;gap:8px}.device select{flex:1;background:#080808;color:#fff;border:1px solid #555;padding:10px}
button{background:#111;color:#ddd;border:1px solid #444;padding:10px 13px;cursor:pointer;letter-spacing:.035em;transition:.12s ease}button:hover{border-color:var(--acid);color:var(--acid);background:#0b1609}button:active{transform:translateY(1px);background:var(--pink);color:#000;border-color:var(--pink)}button.live,button.on{background:var(--acid)!important;color:#050505!important;border-color:var(--acid)!important}.actions{display:flex;gap:8px;margin:12px 0}#arm.arming{background:#f4a340;color:#000;border-color:#f4a340}#arm.armed{background:#39ff14;color:#000;border-color:#39ff14;font-weight:800}
.meterrow{display:grid;grid-template-columns:48px 1fr 44px;gap:9px;align-items:center;margin:9px 0;font-size:11px}.meter{height:10px;border:1px solid #555;background:#050505}.meter i{display:block;height:100%;width:0;background:var(--acid);box-shadow:0 0 9px rgba(57,255,20,.5)}.hit i{transition:width .04s}
.sens{display:grid;grid-template-columns:95px 1fr 42px;gap:9px;align-items:center;margin-top:16px;font-size:11px}
.clock{font-size:clamp(38px,5vw,74px);letter-spacing:-.07em;line-height:1;margin:18px 0}.live-timer{margin-top:8px;padding-top:7px;border-top:1px solid #292929;display:grid;grid-template-columns:1fr auto;gap:6px;align-items:end}.live-timer-label{font-size:8px;letter-spacing:.16em;color:var(--acid)}.live-timer-clock{font-size:30px;line-height:1;letter-spacing:-.045em;font-variant-numeric:tabular-nums}.live-timer-actions{display:flex;gap:3px;grid-column:1/-1}.live-timer-actions button:first-child{min-width:92px;border-color:#31512b;color:var(--acid)}.live-timer-actions button.running{background:var(--acid)!important;color:#000!important}.clock small{font-size:.32em;color:#777;letter-spacing:-.03em}
.timeline{position:relative;margin:18px 0 8px;padding-top:24px}.seek{width:100%;position:relative;z-index:2}.markers{position:absolute;left:8px;right:8px;top:0;height:36px;pointer-events:none}.marker{position:absolute;bottom:8px;width:1px;height:22px;background:#777}.marker.major{height:31px;background:#eee}.marker.major{width:2px}.marker.next{background:#fff;height:30px}.nextcue{font-size:11px;color:#aaa;margin-top:10px;min-height:15px}.trackactions{display:flex;gap:8px;margin-top:12px}.trackactions button:first-child{flex:1}
.vol{display:grid;grid-template-columns:60px 1fr 45px;gap:8px;align-items:center;margin-top:14px;font-size:11px}.video{border-top:1px solid #444;padding:20px}.video-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:18px}.fx,.cues{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.fx #subtitles{grid-column:span 2}.fx #subtitles.on{background:#eee;color:#000}.fx button.on,.cues button.on{background:#eee;color:#000}.vrow{display:grid;grid-template-columns:70px 1fr 45px;gap:8px;align-items:center;margin-top:12px;font-size:11px}.vrow input{width:100%}.video-note{font-size:10px;color:#777;margin-top:10px}.hydra-deck{border-top:1px solid #444;padding:20px}.hydra-buttons{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.hydra-tools{display:flex;gap:7px;margin-top:8px}.genesis-objects{display:flex;gap:7px;margin-top:8px;flex-wrap:wrap}.genesis-objects button{flex:1;min-width:120px;border-color:#31512b}.genesis-objects button:nth-child(n+4){border-color:#762012;color:#ff6a52}.genesis-objects button:nth-child(n+4):hover{background:var(--pink);color:#050505;border-color:var(--pink)}.genesis-objects button.on{background:var(--acid);color:#000}.hypnosis-type{display:flex;gap:7px;margin-top:8px;flex-wrap:wrap}.hypnosis-type button{flex:1;min-width:110px;border-color:#762012;color:#ff6a52}.hypnosis-type button:hover{background:var(--pink);color:#050505;border-color:var(--pink)}.hypnosis-input{display:flex;gap:7px;margin-top:8px}.hypnosis-input input,.hypnosis-input textarea{flex:1;min-width:0;background:#050505;color:var(--pink);border:1px solid #762012;padding:10px 12px;outline:none;resize:vertical;font:inherit}.hypnosis-input input:focus{border-color:var(--pink);box-shadow:0 0 10px rgba(255,36,0,.2)}.hypnosis-input button{border-color:var(--pink);color:var(--pink)}.hydra-tools button{flex:1}.setup-tools{display:flex;gap:5px;align-items:center;flex-wrap:wrap}.setup-tools input[type="text"]{flex:1;min-width:140px;background:#050505;color:#eee;border:1px solid #444;padding:7px 8px;font:inherit}.setup-tools button{border-color:#31512b}.setup-status{font-size:8px;color:#777;margin-top:4px}.hydra-buttons button.todo{border-style:dashed;color:#888}.hydra-buttons button.live{background:#eee;color:#000}
footer{padding:11px 20px;border-top:1px solid #444;color:#777;font-size:10px;display:flex;justify-content:space-between}
@media(max-width:760px){.grid{grid-template-columns:1fr}}

/* ===== AICHA COMPACT COCKPIT ===== */

body {
  padding: 7px !important;
  background-size: 18px 18px !important;
}

.shell {
  max-width: 1480px !important;
}

header {
  padding: 7px 11px !important;
}

.title {
  font-size: 13px !important;
}

.soul,
h2 {
  font-size: 8px !important;
}

h2 {
  margin-bottom: 7px !important;
}

.panel,
.video,
.hydra-deck {
  padding: 9px 11px !important;
  min-height: 0 !important;
}

.state {
  font-size: 9px !important;
  margin-bottom: 5px !important;
}

/* MICRO BUTTONS */

button {
  min-height: 22px !important;
  padding: 3px 7px !important;
  font-size: 8px !important;
  letter-spacing: .055em !important;
  border-radius: 0 !important;
}

.actions,
.trackactions,
.hydra-tools,
.genesis-objects,
.hypnosis-type,
.hypnosis-input {
  gap: 3px !important;
  margin-top: 4px !important;
  margin-bottom: 4px !important;
}

.genesis-objects button,
.hypnosis-type button,
.hydra-tools button {
  flex: 0 0 auto !important;
  min-width: 0 !important;
}

/* HYDRA = STRISCIA DI COMANDI */

.hydra-buttons {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 3px !important;
}

/* AUDIO */

.meterrow {
  grid-template-columns: 32px 1fr 29px !important;
  gap: 5px !important;
  margin: 3px 0 !important;
  font-size: 8px !important;
}

.meter {
  height: 4px !important;
}

.sens,
.vol,
.vrow {
  margin-top: 5px !important;
  font-size: 8px !important;
}

/* CLOCK */

.clock {
  font-size: clamp(27px,3.2vw,47px) !important;
  margin: 6px 0 !important;
}

.timeline {
  margin: 7px 0 2px !important;
  padding-top: 13px !important;
}

.markers {
  height: 18px !important;
}

.marker {
  height: 9px !important;
}

.marker.major {
  height: 14px !important;
}

.nextcue,
.video-note {
  font-size: 8px !important;
  margin-top: 4px !important;
}

/* VIDEO CONTROL */

.video-grid {
  gap: 9px !important;
}

.fx,
.cues {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 3px !important;
}

.fx #subtitles {
  grid-column: auto !important;
}

/* INPUT */

.device {
  gap: 3px !important;
}

.device select {
  padding: 3px 6px !important;
  font-size: 9px !important;
}

.hypnosis-input {
  max-width: 400px !important;
}

.hypnosis-input input {
  padding: 3px 6px !important;
  font-size: 9px !important;
}

footer {
  padding: 6px 11px !important;
  font-size: 7px !important;
}

@media(max-width:760px) {
  body {
    padding: 0 !important;
  }
}


/* HYDRA CONTROL HIERARCHY */
.hydra-deck{background:#090b09!important;border-top:2px solid var(--acid)!important}
