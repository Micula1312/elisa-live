document.querySelectorAll("[data-cue]").forEach(btn=>btn.onclick=()=>send({type:"cue",key:btn.dataset.cue}));
const hydraCues = [...document.querySelectorAll("[data-hydra]")];
const videoClips = {};
const mouseSceneControls = {
  custom01: ["X · Glitch → flusso / Y · Bianco e nero → verde acido", [["Invert", "invert"], ["Drop", "drop"]]],
  genesis: ["X · Deformazione / Y · Scala", [["Post", "single"], ["Raffica", "burst"], ["Post grande", "hero"], ["Pioggia", "rain"], ["Drop", "drop"]]],
  resonance: ["X · Interferenza / Y · Scala e distorsione", [["Invert", "invert"], ["Flash", "punch"]]],
  hypnosis: ["X · Scala e deformazione / Y · Dispersione", [["Disintegra", "drop"], ["Invert", "invert"]]],
  body: ["X · Deformazione / Y · Scala", [["←", "ArrowLeft"], ["→", "ArrowRight"], ["Avanti", "ArrowUp"], ["Indietro", "ArrowDown"], ["Sali", "q"], ["Scendi", "e"], ["Guarda su", "r"], ["Guarda giù", "f"], ["Home", "Home"], ["Post", "single"], ["Raffica", "burst"], ["Post grande", "hero"], ["Pioggia", "rain"], ["Drop", "drop"]]],
  dissolve: ["X · Distorsione / Y · Zoom paesaggio", [["Post", "single"], ["Raffica", "burst"], ["Drop", "drop"]]],
  fusion: ["X · Distorsione / Y · Zoom paesaggio", [["Post", "single"], ["Pioggia", "rain"], ["Nota", "note"], ["Drop", "drop"]]],
  farewell: ["X · Contrasto e distorsione / Y · Luminosità", [["Stelle", "stars"], ["Invert", "invert"]]],
};
function showMouseActions(scene) {
  q("#bodyRevealControls").hidden = scene !== "body";
  const [axes, actions] = mouseSceneControls[scene];
  q("#mouseAxes").textContent = axes;
  q("#hydraMouseActions").replaceChildren(...actions.map(([label, action]) => {
    const button = document.createElement("button");
    button.type = "button";
    button.textContent = label;
    button.onclick = () => control.postMessage({type:"hydra-mouse-action", scene, action});
    return button;
  }));
}
const mousePad = q("#hydraMousePad");
const mouseMacros = [...document.querySelectorAll("[data-hydra-macro]")];
function showMousePosition() {
  mousePad.style.setProperty("--x", Number(mouseMacros[0].value) * 100 + "%");
  mousePad.style.setProperty("--y", (1 - Number(mouseMacros[1].value)) * 100 + "%");
}
mouseMacros.forEach(input => input.addEventListener("input", () => {
  control.postMessage({type:"hydra-mouse-macros", values:{[input.dataset.hydraMacro]:Number(input.value)}});
  showMousePosition();
}));
function moveMousePad(event) {
  const rect = mousePad.getBoundingClientRect();
  if (!rect.width || !rect.height) return;
  mouseMacros[0].value = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
  mouseMacros[1].value = Math.max(0, Math.min(1, 1 - (event.clientY - rect.top) / rect.height));
  control.postMessage({type:"hydra-mouse-macros", values:{param1:Number(mouseMacros[0].value), param2:Number(mouseMacros[1].value)}});
  showMousePosition();
}
