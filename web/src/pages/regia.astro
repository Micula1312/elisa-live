const landscapeInputs = [...document.querySelectorAll("[data-landscape-clip]")];
const landscapeDb = new Promise((resolve, reject) => {
  const request = indexedDB.open("elisa-landscape-clips", 1);
  request.onupgradeneeded = () => request.result.createObjectStore("clips");
  request.onsuccess = () => resolve(request.result);
  request.onerror = () => reject(request.error);
});

function setLandscapeClip(scene, file) {
  if (videoClips[scene]?.startsWith("blob:")) URL.revokeObjectURL(videoClips[scene]);
  videoClips[scene] = URL.createObjectURL(file);
}

const restoreLandscapeClips = landscapeDb.then(db => Promise.all(landscapeInputs.map(input => {
  const scene = input.dataset.landscapeClip;
  const status = q(`[data-clip-status="${scene}"]`);
  return new Promise((resolve, reject) => {
    const request = db.transaction("clips").objectStore("clips").get(scene);
    request.onsuccess = () => {
      const file = request.result;
      if (file && !videoClips[scene]) {
        setLandscapeClip(scene, file);
        status.textContent = file.name + " · salvato su questo browser";
      }
      resolve();
    };
    request.onerror = () => reject(request.error);
  });
}))).catch(error => console.warn("Landscape clip restore failed", error))
  .then(() => Promise.all(dissolveKeys.map(async (key, index) => {
    const restoredUrl = videoClips[key];
    const name = "abc"[index] + ".mp4";
    const url = "/videos/body-dissolve/" + name;
    try {
      const response = await fetch(url, {method:"HEAD", cache:"no-cache", signal:AbortSignal.timeout(2000)});
      if (!response.ok || !response.headers.get("content-type")?.startsWith("video/") || videoClips[key] !== restoredUrl) return;
      if (restoredUrl?.startsWith("blob:")) URL.revokeObjectURL(restoredUrl);
      videoClips[key] = url;
      q(`[data-clip-status="${key}"]`).textContent = name + " · da cartella";
    } catch {
      // An empty slot is valid when its default file has not been installed.
    }
  })));

landscapeInputs.forEach(input => {
  input.onchange = async () => {
    const file = input.files?.[0];
    if (!file) return;
    const scene = input.dataset.landscapeClip;
    const status = q(`[data-clip-status="${scene}"]`);
    setLandscapeClip(scene, file);
    const url = videoClips[scene];
    status.textContent = file.name + " · salvataggio…";
    if (dissolveKeys.includes(scene)) sendDissolveVideos();
    else control.postMessage({type:"hydra-fusion-video", clip:url});
    try {
      const db = await landscapeDb;
      await new Promise((resolve, reject) => {
        const transaction = db.transaction("clips", "readwrite");
        transaction.oncomplete = resolve;
        transaction.onabort = () => reject(transaction.error);
        transaction.objectStore("clips").put(file, scene);
      });
      if (videoClips[scene] === url) status.textContent = file.name + " · salvato su questo browser";
    } catch (error) {
      if (videoClips[scene] === url) status.textContent = file.name + " · disponibile solo per questa sessione";
      console.warn("Landscape clip save failed", error);
    }
  };
});
const backupButtons = [...document.querySelectorAll("[data-backup]")];
backupButtons.forEach(button => button.onclick = async () => {
  backupButtons.forEach(item => item.disabled = true);
  try {
    const clip = button.dataset.backup;
    if (clip !== "live") await touchControl("clip_select", Number(clip));
    await touchControl("source_mix", clip === "live" ? 0 : 1);
    q("#backupStatus").textContent = button.textContent + " · OSC INVIATO";
  } catch {
    q("#backupStatus").textContent = "OSC NON INVIATO";
  } finally {
    backupButtons.forEach(item => item.disabled = false);
  }
});
document.querySelectorAll("[data-hydra-object]").forEach(btn=>btn.onclick=()=>{control.postMessage({type:"hydra-object-add",object:btn.dataset.hydraObject});btn.animate([{transform:"scale(1)"},{transform:"scale(.94)"},{transform:"scale(1)"}],{duration:160})});
q("#forestBurst").onclick=()=>control.postMessage({type:"hydra-forest-burst",count:6});
document.querySelectorAll("[data-hypnosis-word]").forEach(btn=>btn.onclick=()=>{q("#hypnosisText").value=btn.dataset.hypnosisWord;send({type:"hydra-hypnosis-word",word:btn.dataset.hypnosisWord})});
const sendHypnosisText=()=>{const word=q("#hypnosisText").value.trim();if(word)send({type:"hydra-hypnosis-word",word})};
q("#hypnosisSend").onclick=sendHypnosisText;
q("#hypnosisText").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();sendHypnosisText()}});
q("#farewellCreditsSend").onclick=()=>send({type:"hydra-farewell-credits",text:q("#farewellCreditsText").value});
q("#farewellCreditsPlay").onclick=()=>send({type:"hydra-credits-play",text:q("#farewellCreditsText").value});
q("#farewellCreditsStop").onclick=()=>send({type:"hydra-credits-stop"});
const setupStatus=q("#setupStatus"),setupFile=q("#setupFile");
const captureSetup=()=>({
  version:1,name:q("#setupName").value.trim()||"ELISA LIVE",savedAt:new Date().toISOString(),
  audio:{sensitivity:Number(q("#sensitivity").value),volume:Number(q("#volume").value)},
  web:{fxAmount:Number(q("#fxAmount").value),fxReact:Number(q("#fxReact").value),fx:[...document.querySelectorAll("[data-fx]")].filter(b=>b.classList.contains("on")).map(b=>b.dataset.fx),subtitleBlocks:subtitleInputs.map(input=>input.value)},
  hydra:{scene:document.querySelector("[data-hydra].live")?.dataset.hydra||null,hypnosisText:q("#hypnosisText").value,credits:q("#farewellCreditsText").value}
});
q("#setupSave").onclick=()=>{
  const data=captureSetup(),blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"}),a=document.createElement("a");
  a.href=URL.createObjectURL(blob);a.download=(data.name.toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"")||"elisa-regia")+"-setup.json";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),500);
  setupStatus.textContent="SAVED · "+data.name;
};
q("#setupLoad").onclick=()=>setupFile.click();
setupFile.onchange=async()=>{
  const file=setupFile.files?.[0];if(!file)return;
  try{
    const data=JSON.parse(await file.text()),a=data.audio||{},w=data.web||{},h=data.hydra||{};
    if(Number.isFinite(a.sensitivity)){q("#sensitivity").value=a.sensitivity;setSensitivity(a.sensitivity);q("#sensVal").textContent=Number(a.sensitivity).toFixed(1)}
    if(Number.isFinite(a.volume)){q("#volume").value=a.volume;master.volume=a.volume;q("#volVal").textContent=Math.round(a.volume*100)+"%"}
    if(Number.isFinite(w.fxAmount)){q("#fxAmount").value=w.fxAmount;q("#fxAmountVal").textContent=Number(w.fxAmount).toFixed(2);send({type:"fx-amount",value:Number(w.fxAmount)})}
    if(Number.isFinite(w.fxReact)){q("#fxReact").value=w.fxReact;q("#fxReactVal").textContent=Number(w.fxReact).toFixed(1);send({type:"fx-react",value:Number(w.fxReact)})}
    document.querySelectorAll("[data-fx]").forEach(b=>{const on=(w.fx||[]).includes(b.dataset.fx);b.classList.toggle("on",on);send({type:"fx-set",fx:b.dataset.fx,on})});
    if(Array.isArray(w.subtitleBlocks))subtitleInputs.forEach((input,i)=>{
      if(typeof w.subtitleBlocks[i]==="string"){input.value=w.subtitleBlocks[i];input.dispatchEvent(new Event("input"))}
    });
    if(typeof h.hypnosisText==="string")q("#hypnosisText").value=h.hypnosisText;
    if(typeof h.credits==="string"){q("#farewellCreditsText").value=h.credits;send({type:"hydra-farewell-credits",text:h.credits})}
    const cue = hydraCues.find(button => button.dataset.hydra === h.scene);
    if (cue) launchHydraCue(cue);
    q("#setupName").value=data.name||file.name.replace(/\.json$/i,"");setupStatus.textContent="LOADED · "+(data.name||file.name);
  }catch(err){setupStatus.textContent="JSON ERROR · "+err.message}
  setupFile.value="";
};
q("#hydraFullscreen").onclick=()=>{const w=window.open('/hydra','elisa-hydra-output','popup=yes,width='+screen.availWidth+',height='+screen.availHeight+',left=0,top=0');if(w){w.focus();q("#hydraFullscreen").textContent="HYDRA OPEN · F11 ONCE"}else q("#hydraFullscreen").textContent="POPUP BLOCKED"};
let localCam=true,remoteCam=true;
q("#hydraCamLocal").onclick=()=>{localCam=!localCam;q("#hydraCamLocal").textContent='CAM 01 '+(localCam?'ON':'OFF');q("#hydraCamLocal").classList.toggle('on',localCam);send({type:'hydra-cam-local',on:localCam})};
q("#hydraCamRemote").onclick=()=>{remoteCam=!remoteCam;q("#hydraCamRemote").textContent='CAM 02 '+(remoteCam?'ON':'OFF');q("#hydraCamRemote").classList.toggle('on',remoteCam);send({type:'hydra-cam-remote',on:remoteCam})};
q("#hydraBlackout").onclick=()=>send({type:"hydra-blackout"});
q("#hydraClean").onclick=()=>send({type:"hydra-clean"});
q("#hydraBack").onclick=()=>send({type:"hydra-back"});
q("#hydraEditor").onclick=()=>send({type:"hydra-editor"});
let hydraHudVisible=false;
q("#hydraHud").onclick=()=>{
  hydraHudVisible=!hydraHudVisible;
  send({type:"hydra-hud",visible:hydraHudVisible});
  q("#hydraHud").textContent=hydraHudVisible?"HIDE HUD":"SHOW HUD";
  q("#hydraHud").classList.toggle("on",!hydraHudVisible);
};
syncCue(0);populate();
</script>
<script is:inline>
  (() => {
    const field = document.getElementById("phone-url");
    const copy = document.getElementById("phone-copy");
    const refresh = document.getElementById("phone-refresh");
    const status = document.getElementById("phone-status");
    async function updatePhoneUrl() {
      refresh.disabled = true;
      copy.disabled = true;
      field.value = "";
      try {
        const response = await fetch("http://localhost:8765/phone-url", {
          signal: AbortSignal.timeout(2000)
        });
        if (!response.ok) throw new Error("Bridge unavailable");
        const { url } = await response.json();
        field.value = url || "";
        copy.disabled = !url;
        status.textContent = url
          ? "Collega il telefono all’hotspot del PC e apri questo URL."
          : "IP hotspot non trovato. Attiva l’hotspot e premi AGGIORNA.";
      } catch {
        status.textContent = "Avvia o riavvia il bridge OSC e premi AGGIORNA.";
      } finally {
        refresh.disabled = false;
      }
    }
    refresh.addEventListener("click", updatePhoneUrl);
    field.closest("details").addEventListener("toggle", (event) => {
      if (event.currentTarget.open && !refresh.disabled) updatePhoneUrl();
    });
    copy.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(field.value);
        status.textContent = "URL copiato.";
      } catch {
        field.select();
        status.textContent = "Premi Ctrl+C per copiare l’URL.";
      }
    });
  })();
</script>
