.genesis-objects,.hypnosis-type,.hydra-tools{gap:3px!important}
.credits-edit{display:grid;grid-template-columns:1fr 110px;gap:5px;max-width:720px}
.credits-edit textarea{min-height:76px;background:#050505;color:var(--acid);border:1px solid #31512b;padding:6px 8px;font:9px/1.35 Helvetica,Arial,sans-serif;resize:vertical;outline:none}
.credits-edit textarea:focus{border-color:var(--acid)}
.credits-edit button{border-color:#31512b;color:var(--acid)}
.utility-panel{opacity:.72}
@media(max-width:900px){.hydra-buttons{grid-template-columns:repeat(3,1fr)!important}}
