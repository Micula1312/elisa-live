  if (q("#autoMam").checked && button.dataset.mam !== undefined) {
    void touchControl("mam_layout", Number(button.dataset.mam)).catch(() => {
      if (button.classList.contains("live")) q("#hydraCueStatus").textContent = label + " · OSC NON INVIATO";
    });
  }
}
