document.querySelectorAll("[data-subtitle-play]").forEach(button=>{
  button.onclick=()=>{
    const block=Number(button.dataset.subtitlePlay);
    const cards=subtitleInputs[block-1].value.split(/\r?\n/).map(line=>line.trim()).filter(Boolean);
    if(!cards.length){q("#subtitleStatus").textContent="INSERISCI IL TESTO DEL BLOCCO "+block;return}
    subtitleRun={block,cards,position:0};
    renderManualSubtitle();
