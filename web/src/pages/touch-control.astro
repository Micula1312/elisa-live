---
const title = 'ELISA · TOUCH CONTROL II';
---
<html lang="it"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"/><title>{title}</title>
<style>
:root{font-family:Arial,Helvetica,sans-serif;background:#080908;color:#eee;color-scheme:dark}*{box-sizing:border-box}body{margin:0;padding:16px;touch-action:manipulation}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #444;padding-bottom:12px}h1{color:#39ff14;font-size:27px;margin:16px 0 3px}small,.hint{color:#aaa}#status{font-size:12px;color:#ff8e8e}#status.ok{color:#39ff14}.faders{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:24px 0}.control{background:#171917;border:1px solid #383d38;padding:16px 12px;border-radius:12px;min-width:0}.control label{display:block;font-size:11px;letter-spacing:.08em;min-height:30px}.value{color:#39ff14;font-size:22px;font-variant-numeric:tabular-nums;margin:12px 0}input[type=range]{width:100%;height:32px;accent-color:#39ff14;touch-action:none}.buttons{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}button{min-height:72px;border-radius:12px;border:1px solid #555;background:#242724;color:#fff;font-size:14px;font-weight:bold;touch-action:none}button.active{background:#39ff14;color:#000}button.danger{border-color:#f44;color:#ff9999}button:active{transform:scale(.98)}.footer{margin-top:20px;font-size:11px;line-height:1.5;color:#aaa}#bridge{width:100%;background:#171917;color:#fff;border:1px solid #555;border-radius:8px;padding:12px;margin-top:12px}
</style></head><body>
<header><b>BLIVET / ELISA</b><span id="status">● CONNECTING</span></header>
<h1>LIVE FX / II</h1><small>TOUCHDESIGNER · REMOTE PERFORMANCE</small>
<div class="faders" id="faders"></div>
<div class="buttons">
<button data-toggle="freeze">FREEZE</button><button data-toggle="invert">INVERT</button>
<button data-toggle="bypass">BYPASS FX</button><button data-moment="blackout" class="danger">BLACKOUT (HOLD)</button>
<button data-moment="strobe">STROBE (HOLD)</button><button id="reset">RESET FX</button>
</div>
<div class="footer"><label for="bridge">BRIDGE URL (IP del computer, porta 8765)</label><input id="bridge" spellcheck="false" placeholder="http://192.168.1.10:8765"/><p id="help">Telefono e PC sulla stessa rete. Avvia prima il bridge Python. Il controllo invia OSC a TouchDesigner; per vedere gli effetti devi collegare i canali OSC ai tuoi TOP.</p></div>
<script>
const names=['glitch','feedback','pixel','blur','displace','audio','blend','master'];const defaults=[0,0,0,0,0,0,100,100];const el=document.getElementById('faders');const timers=new Map();const toggles={freeze:false,invert:false,bypass:false};const status=document.getElementById('status');const bridge=document.getElementById('bridge');const defaultUrl=location.port==='8765'?location.origin:location.protocol+'//'+location.hostname+':8765';bridge.value=localStorage.getItem('elisa-osc-bridge')||defaultUrl;bridge.addEventListener('change',()=>localStorage.setItem('elisa-osc-bridge',bridge.value.trim().replace(/\/$/,'')));
async function send(name,value){const base=bridge.value.trim().replace(/\/$/,'');try{const res=await fetch(base+'/control',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,value}),signal:AbortSignal.timeout(1200)});if(!res.ok)throw Error('HTTP '+res.status);status.textContent='● CONNECTED';status.classList.add('ok')}catch(e){status.textContent='● BRIDGE OFFLINE';status.classList.remove('ok')}}
function throttle(name,value){const prev=timers.get(name);if(prev)clearTimeout(prev);timers.set(name,setTimeout(()=>{timers.delete(name);send(name,value)},25))}
names.forEach((name,i)=>{const div=document.createElement('div');div.className='control';div.innerHTML='<label>'+name.toUpperCase()+'</label><div class="value">'+defaults[i]+'%</div><input type="range" min="0" max="100" value="'+defaults[i]+'" aria-label="'+name+'"/>';const slider=div.querySelector('input');slider.addEventListener('input',()=>{div.querySelector('.value').textContent=slider.value+'%';throttle(name,Number(slider.value)/100)});el.appendChild(div)});
document.querySelectorAll('[data-toggle]').forEach(btn=>btn.addEventListener('click',()=>{const n=btn.dataset.toggle;toggles[n]=!toggles[n];btn.classList.toggle('active',toggles[n]);send(n,toggles[n]?1:0)}));
document.querySelectorAll('[data-moment]').forEach(btn=>{const n=btn.dataset.moment;const release=()=>{btn.classList.remove('active');send(n,0)};btn.addEventListener('pointerdown',e=>{e.preventDefault();btn.setPointerCapture(e.pointerId);btn.classList.add('active');send(n,1)});btn.addEventListener('pointerup',release);btn.addEventListener('pointercancel',release);btn.addEventListener('lostpointercapture',release)});
document.getElementById('reset').addEventListener('click',()=>{document.querySelectorAll('.control').forEach((d,i)=>{d.querySelector('input').value=defaults[i];d.querySelector('.value').textContent=defaults[i]+'%';send(names[i],defaults[i]/100)});Object.keys(toggles).forEach(n=>{toggles[n]=false;document.querySelector('[data-toggle="'+n+'"]').classList.remove('active');send(n,0)});send('blackout',0);send('strobe',0)});
fetch(bridge.value+'/health',{signal:AbortSignal.timeout(1200)}).then(r=>{if(!r.ok)throw Error();status.textContent='● CONNECTED';status.classList.add('ok')}).catch(()=>{status.textContent='● BRIDGE OFFLINE'});
</script></body></html>